      cursor: pointer;
    }
    .fc-team-edit summary::-webkit-details-marker { display: none; }
    .fc-team-edit summary::before { content: '🛡'; font-size: .8rem; }
    .fc-team-change { margin-left: auto; flex-shrink: 0; font-size: .9rem; color: var(--fc-muted); }
    .fc-team-edit[open] .fc-team-change { visibility: hidden; }
    .fc-board {
      margin-top: .75rem;
      padding: 1rem .75rem 1.1rem;
      border-radius: 1.4rem;
      border: 1px solid var(--fc-line);
      background: radial-gradient(18rem 9rem at 50% 0%, rgb(255 255 255 / .07), transparent 70%), rgb(255 255 255 / .03);
    }
    .fc-board-clock { display: flex; align-items: center; justify-content: center; gap: .75rem; }
    .fc-board-clock .fc-game-clock { margin: 0; font-size: 1.9rem; }
    .fc-board-score { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: start; gap: .5rem; margin-top: .9rem; }
    .fc-board-sep { align-self: center; margin-top: -2.5rem; font-size: 2.5rem; font-weight: 900; color: var(--fc-muted); }
    .fc-board-side { display: grid; justify-items: center; gap: .3rem; min-width: 0; text-align: center; }
    .fc-board-name { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .fc-board-team { max-width: 100%; min-height: 1em; font-size: .72rem; color: var(--fc-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .fc-board-num { display: block; font-size: clamp(4.5rem, 24vw, 6.5rem); font-weight: 900; line-height: .95; font-variant-numeric: tabular-nums; letter-spacing: -.04em; }
    /* El botón más importante: grande, del color del jugador */
    .fc-goal-btn {
      width: 100%;
      min-height: 4.25rem;
      margin-top: .35rem;
      border-radius: 1.2rem;
      background: var(--c, var(--fc-accent));
      color: #07090a;
