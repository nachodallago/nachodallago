---
import Layout from '../layouts/Layout.astro';
// Logo oficial de EA SPORTS FC (Wikimedia Commons, dominio público), en versión para fondo oscuro
import eaLogo from '../assets/ea-sports-fc.svg?raw';

const today = new Date().toISOString().slice(0, 10);

// Los que juegan, cada uno con su color
const players = [
  { name: 'Nacho', color: '#c4ff4d' },
  { name: 'Mati F', color: '#5ee7ff' },
  { name: 'Cacha', color: '#b69cff' },
  { name: 'Juan', color: '#ff9354' },
];

const initials = (name: string) => {
  const words = name.trim().split(/\s+/);
  return (words.length > 1 ? words[0][0] + words[1][0] : name.slice(0, 2)).toUpperCase();
};

const sides = [
  { key: 'home', label: 'Local' },
  { key: 'away', label: 'Visitante' },
] as const;

// Íconos de trazo (estilo Lucide), inline para no sumar requests
const icons = {
  home: '<path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>',
  trophy:
    '<path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6M18 9h1.5a2.5 2.5 0 0 0 0-5H18M4 22h16M10 14.7V17c0 .6-.5 1-1 1.2C7.9 18.8 7 20.2 7 22M14 14.7V17c0 .6.5 1 1 1.2 1.1.6 2 2 2 3.8"/><path d="M18 2H6v7a6 6 0 0 0 12 0z"/>',
  list: '<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  more: '<circle cx="5" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/>',
  download: '<path d="M12 3v12m0 0-4-4m4 4 4-4M5 21h14"/>',
  upload: '<path d="M12 15V3m0 0L8 7m4-4 4 4M5 21h14"/>',
  back: '<path d="m15 18-6-6 6-6"/>',
  close: '<path d="M18 6 6 18M6 6l12 12"/>',
  trash: '<path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v6M14 11v6"/>',
  soundOn: '<path d="M11 5 6 9H2v6h4l5 4zM15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14"/>',
  soundOff: '<path d="M11 5 6 9H2v6h4l5 4zM22 9l-6 6M16 9l6 6"/>',
};

const tabs = [
  { href: '#resumen', icon: icons.home, label: 'Resumen' },
  { href: '#tabla', icon: icons.trophy, label: 'Tabla' },
  { href: '#partidos', icon: icons.list, label: 'Partidos' },
];
---

<Layout
  title="EA SPORTS FC 26 — Resultados · Nacho Dal Lago"
  description="Cargá los resultados de los partidos de EA SPORTS FC 26: quién jugó, con qué equipo y cómo salió."
  noindex
>
  <div class="fc">
    <!-- Header -->
    <header class="fc-header">
      <div class="mx-auto flex max-w-3xl items-center gap-3 px-4 py-2.5">
        <span class="fc-logo" set:html={eaLogo} />
        <div class="min-w-0 flex-1">
          <p class="fc-eyebrow">Temporada 2026</p>
          <h1 class="truncate text-lg font-extrabold tracking-tight md:text-xl">Resultados FC 26</h1>
        </div>
        <button type="button" class="fc-btn fc-btn-primary hidden md:inline-flex" data-open-sheet>
          <svg viewBox="0 0 24 24" class="fc-ico" set:html={icons.plus} /> Nuevo partido
        </button>
        <button type="button" id="sound-toggle" class="fc-icon-btn" aria-pressed="true" aria-label="Sonido de gol">
          <svg viewBox="0 0 24 24" class="fc-ico" data-sound="on" set:html={icons.soundOn} />
          <svg viewBox="0 0 24 24" class="fc-ico hidden" data-sound="off" set:html={icons.soundOff} />
        </button>
        <button type="button" popovertarget="fc-menu" class="fc-icon-btn hidden md:grid" aria-label="Más opciones">
          <svg viewBox="0 0 24 24" class="fc-ico" set:html={icons.more} />
        </button>
      </div>
    </header>

    <main id="main" class="mx-auto max-w-3xl space-y-8 px-4 pt-5 pb-[calc(7.5rem+env(safe-area-inset-bottom))] md:pb-16">
      <!-- Resumen -->
      <!-- Torneo que se está viendo -->
      <button type="button" id="tournament-btn" class="fc-tbar" aria-haspopup="dialog">
        <span class="fc-tbar-ico" aria-hidden="true">🏆</span>
        <span class="min-w-0 flex-1 text-left">
          <small>Torneo</small>
          <b id="tournament-name">Todos los partidos</b>
        </span>
        <span id="tournament-count" class="fc-pill"></span>
        <span aria-hidden="true" class="fc-muted">▾</span>
      </button>

      <section id="resumen" aria-label="Resumen" class="fc-section space-y-3">
        <div id="live-list" class="space-y-3" aria-live="polite"></div>
        <div id="sync-banner" class="fc-banner" hidden>
          <p id="sync-text" class="min-w-0 flex-1"></p>
          <button type="button" id="sync-upload" class="fc-btn fc-btn-primary !min-h-9 shrink-0 !px-3.5 text-sm" hidden>Subir</button>
        </div>
        <article id="leader" class="fc-card fc-leader"></article>
        <div class="grid grid-cols-3 gap-3">
          <div class="fc-card fc-stat"><span id="stat-matches">0</span><small>Partidos</small></div>
          <div class="fc-card fc-stat"><span id="stat-goals">0</span><small>Goles</small></div>
          <div class="fc-card fc-stat"><span id="stat-avg">0</span><small>Goles x PJ</small></div>
        </div>
      </section>

      <!-- Tabla -->
      <section id="tabla" aria-labelledby="tabla-title" class="fc-section">
        <div class="fc-section-head">
          <h2 id="tabla-title">Tabla</h2>
          <span class="fc-muted text-xs">3 pts ganar · 1 empatar</span>
        </div>
        <div class="fc-card overflow-hidden">
          <div class="fc-standings-head" aria-hidden="true">
            <span>#</span><span>Jugador</span><span class="fc-form-col">Últimos</span><span>PJ</span><span title="Goles a favor">GF</span><span>DG</span><span>Pts</span>
          </div>
          <ol id="standings" class="fc-standings"></ol>
        </div>
      </section>

      <!-- Partidos -->
      <section id="partidos" aria-labelledby="partidos-title" class="fc-section">
        <div class="fc-section-head">
          <h2 id="partidos-title">Partidos</h2>
          <span id="matches-count" class="fc-pill"></span>
        </div>
        <div id="matches" class="space-y-5"></div>
        <div id="matches-empty" class="fc-card fc-empty">
          <span class="text-4xl" aria-hidden="true">⚽</span>
          <p class="font-semibold text-white">Todavía no hay partidos</p>
          <p class="fc-muted text-sm">Cargá el primero y arranca la temporada.</p>
          <button type="button" class="fc-btn fc-btn-primary mt-2" data-open-sheet>
            <svg viewBox="0 0 24 24" class="fc-ico" set:html={icons.plus} /> Cargar partido
          </button>
        </div>
      </section>
    </main>

    <!-- Dock inferior (celu) -->
    <nav aria-label="Secciones" class="fc-dock md:hidden">
      {
        tabs.slice(0, 2).map((t) => (
          <a href={t.href} class="fc-dock-item">
            <svg viewBox="0 0 24 24" class="fc-ico" set:html={t.icon} />
            {t.label}
          </a>
        ))
      }
      <button type="button" class="fc-fab" data-open-sheet aria-label="Cargar partido">
        <svg viewBox="0 0 24 24" class="fc-ico" set:html={icons.plus} />
      </button>
      <a href={tabs[2].href} class="fc-dock-item">
        <svg viewBox="0 0 24 24" class="fc-ico" set:html={tabs[2].icon} />
        {tabs[2].label}
      </a>
      <button type="button" popovertarget="fc-menu" class="fc-dock-item">
        <svg viewBox="0 0 24 24" class="fc-ico" set:html={icons.more} />
        Más
      </button>
    </nav>

    <!-- Menú (Popover API) -->
    <div id="fc-menu" popover class="fc-menu">
      <button type="button" id="export" class="fc-menu-item">
        <svg viewBox="0 0 24 24" class="fc-ico" set:html={icons.download} /> Exportar resultados
      </button>
      <label class="fc-menu-item">
        <svg viewBox="0 0 24 24" class="fc-ico" set:html={icons.upload} /> Importar resultados
        <input type="file" id="import" accept="application/json,.json" class="sr-only" />
      </label>
      <button type="button" class="fc-menu-item" data-open-players>
        <span class="grid w-5 place-items-center" aria-hidden="true">📷</span> Fotos de los jugadores
      </button>
      <button type="button" id="forget-pin" class="fc-menu-item" hidden>
        <span class="grid w-5 place-items-center" aria-hidden="true">🔒</span> Salir (pedir el PIN de nuevo)
      </button>
      <a href="/" class="fc-menu-item">
        <svg viewBox="0 0 24 24" class="fc-ico" set:html={icons.back} /> Volver a nachodallago.com
      </a>
      <p id="menu-note" class="fc-muted px-3 pt-2 pb-1 text-[11px] leading-snug"></p>
    </div>

    <!-- Bottom sheet: cargar partido -->
    <dialog id="sheet" class="fc-sheet" aria-labelledby="sheet-title">
      <form id="match-form" autocomplete="off" novalidate data-phase="setup">
        <div class="fc-grabber" aria-hidden="true"></div>
        <div class="flex items-center justify-between">
          <h2 id="sheet-title" class="text-lg font-extrabold">Nuevo partido</h2>
          <button type="button" id="clear-draft" class="fc-link ml-auto mr-2" hidden>Limpiar</button>
          <button type="button" class="fc-icon-btn" data-close aria-label="Cerrar">
            <svg viewBox="0 0 24 24" class="fc-ico" set:html={icons.close} />
          </button>
        </div>

        <!-- 1) Antes de empezar: quién juega (cada uno trae su equipo) y deslizar para arrancar -->
        <div class="fc-setup">
          <div class="grid grid-cols-2 gap-3">
            {
              sides.map((s) => (
                <fieldset class="flex min-w-0 flex-col gap-2.5">
                  <legend class="fc-label mb-2">{s.label}</legend>
                  <div class="fc-picks" role="radiogroup" aria-label={`Jugador ${s.label.toLowerCase()}`}>
                    {players.map((p) => (
                      <label style={`--c:${p.color}`}>
                        <input type="radio" name={`${s.key}Player`} value={p.name} data-color={p.color} required class="sr-only" />
                        <span>
                          <i class="fc-avatar">{initials(p.name)}</i>
                          {p.name}
                        </span>
                      </label>
                    ))}
                  </div>
                  <!-- El equipo viene elegido con el jugador; se puede cambiar -->
                  <details class="fc-team-edit" data-team-edit={s.key}>
                    <summary>
                      <span class="min-w-0 truncate" data-team-line={s.key}>Equipo</span>
                      <span class="fc-team-change" aria-label="cambiar equipo">✎</span>
                    </summary>
                    <input name={`${s.key}Team`} list="teams" maxlength="40" placeholder="Equipo" class="fc-input mt-2" aria-label={`Equipo ${s.label.toLowerCase()}`} autocapitalize="words" />
                    <div class="fc-team-chips mt-2" data-team-chips={s.key} aria-label={`Equipos guardados ${s.label.toLowerCase()}`}></div>
                  </details>
                </fieldset>
              ))
            }
          </div>

          <!-- Confirmar el partido nuevo: hay que deslizar la pelota a la derecha -->
          <div id="kickoff" class="fc-swipe mt-5" aria-disabled="true">
            <span class="fc-swipe-fill" aria-hidden="true"></span>
            <span class="fc-swipe-text">Deslizá para empezar el partido</span>
            <button type="button" class="fc-swipe-thumb" aria-label="Deslizá a la derecha para empezar el partido">⚽</button>
          </div>
          <p id="kickoff-hint" class="fc-muted mt-2 text-center text-xs"></p>
        </div>

        <!-- 2) En juego: reloj y marcador grandes, con botones de gol bien visibles -->
        <div class="fc-board">
          <div class="fc-board-clock">
            <span id="match-clock" class="fc-game-clock">00:00</span>
            <button type="button" id="clock-toggle" class="fc-clock-btn">⏸ Pausa</button>
          </div>
          <div class="fc-board-score">
            {
              sides.map((s, i) => (
                <Fragment>
                  {i === 1 && <span class="fc-board-sep" aria-hidden="true">:</span>}
                  <div class="fc-board-side" data-board={s.key}>
                    <span class="fc-avatar fc-avatar-lg" data-preview={s.key}>?</span>
                    <b class="fc-board-name" data-preview-name={s.key}>{s.label}</b>
                    <small class="fc-board-team" data-preview-team={s.key}></small>
                    <span class="fc-board-num" data-preview-goals={s.key} aria-live="polite">0</span>
                    <button type="button" class="fc-goal-btn" data-step={`${s.key}Goals`} data-delta="1" aria-label={`Gol del ${s.label.toLowerCase()}`}>+ GOL</button>
                    <button type="button" class="fc-undo-btn" data-step={`${s.key}Goals`} data-delta="-1" aria-label={`Quitar el último gol del ${s.label.toLowerCase()}`}>− quitar</button>
                    <input name={`${s.key}Goals`} type="number" min="0" max="99" value="0" class="sr-only" tabindex="-1" aria-hidden="true" />
                  </div>
                </Fragment>
              ))
            }
          </div>
        </div>

        <!-- Goles con su minuto -->
        <div id="goal-panel" class="fc-goal-panel">
          <ol id="goal-log" class="fc-goal-log"></ol>
          <p id="goal-empty" class="fc-muted text-center text-xs"></p>
        </div>

        <!-- Todo lo demás, guardado en un menú -->
        <details class="fc-options">
          <summary>⚙️ Opciones del partido</summary>
          <div class="fc-options-body">
            <div class="fc-clock-row">
              <span class="fc-label mr-auto">Ajustar reloj</span>
              <button type="button" class="fc-clock-btn" data-nudge="-1" aria-label="Restar un minuto al reloj">−1'</button>
              <button type="button" class="fc-clock-btn" data-nudge="1" aria-label="Sumar un minuto al reloj">+1'</button>
            </div>
            <p id="clock-note" class="fc-muted text-xs"></p>
            <div class="fc-duration" role="radiogroup" aria-label="Duración del partido">
              <span>Dura</span>
              {
                [8, 10, 12, 16, 20].map((d) => (
                  <button type="button" data-duration={d} role="radio">{d}</button>
                ))
              }
              <span>min</span>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <label class="block min-w-0">
                <span class="fc-label">Fecha</span>
                <input name="date" type="date" required value={today} class="fc-input mt-2" />
              </label>
              <label class="block min-w-0">
                <span class="fc-label">Torneo</span>
                <select name="tournament" class="fc-input fc-select mt-2"><option value="">Sin torneo</option></select>
              </label>
            </div>
          </div>
        </details>

        <p id="form-error" class="mt-3 text-sm font-semibold text-red-400 empty:hidden" role="alert"></p>
        <button type="submit" class="fc-btn fc-btn-primary fc-btn-block mt-4">Terminar y guardar</button>
        <datalist id="teams"></datalist>
      </form>
    </dialog>

    <!-- Torneos: elegir cuál ver, crear y editar -->
    <dialog id="tournaments-dialog" class="fc-sheet fc-sheet-sm" aria-labelledby="tournaments-title">
      <div class="fc-grabber" aria-hidden="true"></div>
      <div class="flex items-center justify-between">
        <h2 id="tournaments-title" class="text-lg font-extrabold">Torneos</h2>
        <button type="button" class="fc-icon-btn" data-close-tournaments aria-label="Cerrar">
          <svg viewBox="0 0 24 24" class="fc-ico" set:html={icons.close} />
        </button>
      </div>
      <ul id="tournament-list" class="fc-tlist"></ul>
      <button type="button" id="tournament-new" class="fc-btn fc-btn-primary fc-btn-block mt-3">
        <svg viewBox="0 0 24 24" class="fc-ico" set:html={icons.plus} /> Crear torneo
      </button>
      <p id="tournament-offline" class="fc-muted mt-2 text-center text-xs" hidden>Para crear o editar torneos hace falta conexión con el servidor.</p>
    </dialog>

    <dialog id="tournament-edit" class="fc-sheet" aria-labelledby="tedit-title">
      <form id="tournament-form" novalidate>
        <div class="fc-grabber" aria-hidden="true"></div>
        <div class="flex items-center justify-between">
          <h2 id="tedit-title" class="text-lg font-extrabold">Nuevo torneo</h2>
          <button type="button" class="fc-icon-btn" data-close-tedit aria-label="Cerrar">
            <svg viewBox="0 0 24 24" class="fc-ico" set:html={icons.close} />
          </button>
        </div>
        <label class="mt-3 block">
          <span class="fc-label">Nombre</span>
          <input name="name" maxlength="40" required placeholder="Ej: Copa Noviembre" class="fc-input mt-2" autocomplete="off" autocapitalize="sentences" />
        </label>
        <div class="mt-5 mb-2 flex items-center justify-between gap-2">
          <span class="fc-label">Partidos del torneo</span>
          <button type="button" id="tedit-free" class="fc-link !min-h-9 !px-0 text-xs">Sumar los sin torneo</button>
        </div>
        <p id="tedit-count" class="fc-muted mb-2 text-xs"></p>
        <ul id="tedit-matches" class="fc-tpick"></ul>
        <p id="tedit-error" class="mt-3 text-sm font-semibold text-red-400 empty:hidden" role="alert"></p>
        <div class="fc-tedit-actions">
          <button type="button" id="tedit-delete" class="fc-btn fc-btn-ghost text-red-300">Borrar</button>
          <button type="submit" class="fc-btn fc-btn-primary flex-1">Guardar torneo</button>
        </div>
      </form>
    </dialog>

    <!-- Detalle de un partido: línea de tiempo con los goles por tiempo -->
    <dialog id="match-detail" class="fc-sheet" aria-labelledby="md-title">
      <div class="fc-grabber" aria-hidden="true"></div>
      <div class="flex items-center justify-between gap-2">
        <p id="md-date" class="fc-label"></p>
        <button type="button" class="fc-icon-btn shrink-0" data-close-match aria-label="Cerrar">
          <svg viewBox="0 0 24 24" class="fc-ico" set:html={icons.close} />
        </button>
      </div>
      <h2 id="md-title" class="sr-only">Detalle del partido</h2>
      <div id="md-score" class="fc-md-score"></div>
      <label id="md-tournament-wrap" class="fc-md-tournament">
        <span>🏆 Torneo</span>
        <select id="md-tournament" class="fc-input fc-select"></select>
      </label>
      <h3 class="fc-label mt-5 mb-2">Goles en el tiempo</h3>
      <div id="md-chart"></div>
      <p id="md-halves" class="fc-md-halves"></p>
      <h3 class="fc-label mt-5 mb-2">Gol por gol</h3>
      <ol id="md-goals" class="fc-md-goals"></ol>
    </dialog>

    <!-- Ficha de un jugador: sus números y todos sus partidos -->
    <dialog id="player-detail" class="fc-sheet" aria-labelledby="pd-name">
      <div class="fc-grabber" aria-hidden="true"></div>
      <div class="flex items-start gap-3">
        <div id="pd-head" class="flex min-w-0 flex-1 items-center gap-3"></div>
        <button type="button" class="fc-icon-btn shrink-0" data-close-detail aria-label="Cerrar">
          <svg viewBox="0 0 24 24" class="fc-ico" set:html={icons.close} />
        </button>
      </div>
      <div id="pd-stats" class="fc-pd-stats"></div>
      <div id="pd-rivals-wrap">
        <h3 class="fc-label mt-5 mb-2">Contra cada rival</h3>
        <ul id="pd-rivals" class="fc-pd-rivals"></ul>
      </div>
      <h3 class="fc-label mt-5 mb-2">Partidos</h3>
      <ol id="pd-matches" class="fc-pd-matches"></ol>
      <p id="pd-empty" class="fc-muted py-6 text-center text-sm">Todavía no jugó ningún partido.</p>
    </dialog>

    <!-- Jugadores: fotos de perfil -->
    <dialog id="players-dialog" class="fc-sheet fc-sheet-sm" aria-labelledby="players-title">
      <div class="fc-grabber" aria-hidden="true"></div>
      <div class="flex items-center justify-between">
        <h2 id="players-title" class="text-lg font-extrabold">Jugadores</h2>
        <button type="button" class="fc-icon-btn" data-close-players aria-label="Cerrar">
          <svg viewBox="0 0 24 24" class="fc-ico" set:html={icons.close} />
        </button>
      </div>
      <p id="players-note" class="fc-muted mt-1 text-sm"></p>
      <ul id="players-list" class="fc-player-list"></ul>
      <input type="file" id="photo-input" accept="image/*" class="sr-only" tabindex="-1" aria-hidden="true" />
    </dialog>

    <!-- Ajustar la foto antes de subirla -->
    <dialog id="crop-dialog" class="fc-sheet fc-sheet-sm" aria-labelledby="crop-title">
      <div class="fc-grabber" aria-hidden="true"></div>
      <h2 id="crop-title" class="text-center text-lg font-extrabold">Ajustá la foto</h2>
      <div id="crop-stage" class="fc-crop" aria-label="Arrastrá para mover la foto">
        <img id="crop-img" alt="" draggable="false" />
        <div class="fc-crop-mask" aria-hidden="true"></div>
      </div>
      <label class="fc-crop-zoom">
        <span aria-hidden="true">−</span>
        <input id="crop-zoom" type="range" min="1" max="4" step="0.01" value="1" aria-label="Zoom" />
        <span aria-hidden="true">+</span>
      </label>
      <p class="fc-muted mt-1 text-center text-xs">Arrastrá para moverla · pellizcá o usá la barra para el zoom</p>
      <div class="mt-4 grid grid-cols-2 gap-2">
        <button type="button" id="crop-cancel" class="fc-btn fc-btn-ghost">Cancelar</button>
        <button type="button" id="crop-ok" class="fc-btn fc-btn-primary">Usar foto</button>
      </div>
    </dialog>

    <!-- Ver la foto en grande -->
    <dialog id="photo-viewer" class="fc-viewer" aria-label="Foto de perfil">
      <figure>
        <img id="viewer-img" alt="" />
        <figcaption id="viewer-name"></figcaption>
      </figure>
      <button type="button" id="viewer-change" class="fc-btn fc-btn-ghost">Cambiar foto</button>
    </dialog>

    <!-- PIN para cargar o borrar -->
    <dialog id="pin-dialog" class="fc-sheet fc-sheet-sm" aria-labelledby="pin-title">
      <form id="pin-form" class="text-center" novalidate>
        <div class="fc-grabber" aria-hidden="true"></div>
        <span class="mx-auto mb-3 grid size-12 place-items-center rounded-full bg-white/10 text-xl" aria-hidden="true">🔒</span>
        <h2 id="pin-title" class="text-lg font-extrabold">Ingresá el PIN</h2>
