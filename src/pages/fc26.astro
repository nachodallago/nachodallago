      -webkit-user-select: none;
    }
    .fc-swipe[hidden] { display: none; }
    .fc-swipe[aria-disabled='true'] { opacity: .45; border-color: var(--fc-line); }
    .fc-swipe-fill {
      position: absolute;
      inset: 0 auto 0 0;
      width: calc(var(--x) + 3.25rem);
      background: color-mix(in oklab, var(--fc-accent) 22%, transparent);
      border-radius: 999px;
    }
    .fc-swipe-text {
      position: absolute;
      inset: 0;
      display: grid;
