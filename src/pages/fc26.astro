---
import Layout from '../layouts/Layout.astro';
// Logo oficial de EA SPORTS FC (Wikimedia Commons, dominio público), en versión para fondo oscuro
import eaLogo from '../assets/ea-sports-fc.svg?raw';

const today = new Date().toISOString().slice(0, 10);

// Los que juegan, cada uno con su color
const players = [
  { name: 'Nacho', color: '#c4ff4d' },
  { name: 'Mati F', color: '#5ee7ff' },
  { name: 'Cacha', color: '#b69cff' },
  { name: 'Juan', color: '#ff9354' },
];

const initials = (name: string) => {
  const words = name.trim().split(/\s+/);
  return (words.length > 1 ? words[0][0] + words[1][0] : name.slice(0, 2)).toUpperCase();
};

const sides = [
  { key: 'home', label: 'Local' },
  { key: 'away', label: 'Visitante' },
] as const;

// Íconos de trazo (estilo Lucide), inline para no sumar requests
const icons = {
  home: '<path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>',
  trophy:
    '<path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6M18 9h1.5a2.5 2.5 0 0 0 0-5H18M4 22h16M10 14.7V17c0 .6-.5 1-1 1.2C7.9 18.8 7 20.2 7 22M14 14.7V17c0 .6.5 1 1 1.2 1.1.6 2 2 2 3.8"/><path d="M18 2H6v7a6 6 0 0 0 12 0z"/>',
  list: '<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  more: '<circle cx="5" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/>',
  download: '<path d="M12 3v12m0 0-4-4m4 4 4-4M5 21h14"/>',
  upload: '<path d="M12 15V3m0 0L8 7m4-4 4 4M5 21h14"/>',
  back: '<path d="m15 18-6-6 6-6"/>',
  close: '<path d="M18 6 6 18M6 6l12 12"/>',
  trash: '<path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v6M14 11v6"/>',
};

const tabs = [
  { href: '#resumen', icon: icons.home, label: 'Resumen' },
  { href: '#tabla', icon: icons.trophy, label: 'Tabla' },
  { href: '#partidos', icon: icons.list, label: 'Partidos' },
];
---

<Layout
  title="EA SPORTS FC 26 — Resultados · Nacho Dal Lago"
  description="Cargá los resultados de los partidos de EA SPORTS FC 26: quién jugó, con qué equipo y cómo salió."
  noindex
>
  <div class="fc">
    <!-- Header -->
    <header class="fc-header">
      <div class="mx-auto flex max-w-3xl items-center gap-3 px-4 py-2.5">
        <span class="fc-logo" set:html={eaLogo} />
        <div class="min-w-0 flex-1">
          <p class="fc-eyebrow">Temporada 2026</p>
          <h1 class="truncate text-lg font-extrabold tracking-tight md:text-xl">Resultados FC 26</h1>
        </div>
        <button type="button" class="fc-btn fc-btn-primary hidden md:inline-flex" data-open-sheet>
          <svg viewBox="0 0 24 24" class="fc-ico" set:html={icons.plus} /> Nuevo partido
        </button>
        <button type="button" popovertarget="fc-menu" class="fc-icon-btn hidden md:grid" aria-label="Más opciones">
          <svg viewBox="0 0 24 24" class="fc-ico" set:html={icons.more} />
        </button>
      </div>
    </header>

    <main id="main" class="mx-auto max-w-3xl space-y-8 px-4 pt-5 pb-[calc(7.5rem+env(safe-area-inset-bottom))] md:pb-16">
      <!-- Resumen -->
      <section id="resumen" aria-label="Resumen" class="fc-section space-y-3">
        <div id="sync-banner" class="fc-banner" hidden>
          <p id="sync-text" class="min-w-0 flex-1"></p>
          <button type="button" id="sync-upload" class="fc-btn fc-btn-primary !min-h-9 shrink-0 !px-3.5 text-sm" hidden>Subir</button>
        </div>
        <article id="leader" class="fc-card fc-leader"></article>
        <div class="grid grid-cols-3 gap-3">
          <div class="fc-card fc-stat"><span id="stat-matches">0</span><small>Partidos</small></div>
          <div class="fc-card fc-stat"><span id="stat-goals">0</span><small>Goles</small></div>
          <div class="fc-card fc-stat"><span id="stat-avg">0</span><small>Goles x PJ</small></div>
        </div>
      </section>

      <!-- Tabla -->
      <section id="tabla" aria-labelledby="tabla-title" class="fc-section">
        <div class="fc-section-head">
          <h2 id="tabla-title">Tabla</h2>
          <span class="fc-muted text-xs">3 pts ganar · 1 empatar</span>
        </div>
        <div class="fc-card overflow-hidden">
          <div class="fc-standings-head" aria-hidden="true">
            <span>#</span><span>Jugador</span><span class="fc-form-col">Últimos</span><span>PJ</span><span>DG</span><span>Pts</span>
          </div>
          <ol id="standings" class="fc-standings"></ol>
        </div>
      </section>

      <!-- Partidos -->
      <section id="partidos" aria-labelledby="partidos-title" class="fc-section">
        <div class="fc-section-head">
          <h2 id="partidos-title">Partidos</h2>
          <span id="matches-count" class="fc-pill"></span>
        </div>
        <div id="matches" class="space-y-5"></div>
        <div id="matches-empty" class="fc-card fc-empty">
          <span class="text-4xl" aria-hidden="true">⚽</span>
          <p class="font-semibold text-white">Todavía no hay partidos</p>
          <p class="fc-muted text-sm">Cargá el primero y arranca la temporada.</p>
          <button type="button" class="fc-btn fc-btn-primary mt-2" data-open-sheet>
            <svg viewBox="0 0 24 24" class="fc-ico" set:html={icons.plus} /> Cargar partido
          </button>
        </div>
      </section>
    </main>

    <!-- Dock inferior (celu) -->
    <nav aria-label="Secciones" class="fc-dock md:hidden">
      {
        tabs.slice(0, 2).map((t) => (
          <a href={t.href} class="fc-dock-item">
            <svg viewBox="0 0 24 24" class="fc-ico" set:html={t.icon} />
            {t.label}
          </a>
        ))
      }
      <button type="button" class="fc-fab" data-open-sheet aria-label="Cargar partido">
        <svg viewBox="0 0 24 24" class="fc-ico" set:html={icons.plus} />
      </button>
      <a href={tabs[2].href} class="fc-dock-item">
        <svg viewBox="0 0 24 24" class="fc-ico" set:html={tabs[2].icon} />
        {tabs[2].label}
      </a>
      <button type="button" popovertarget="fc-menu" class="fc-dock-item">
        <svg viewBox="0 0 24 24" class="fc-ico" set:html={icons.more} />
        Más
      </button>
    </nav>

    <!-- Menú (Popover API) -->
    <div id="fc-menu" popover class="fc-menu">
      <button type="button" id="export" class="fc-menu-item">
        <svg viewBox="0 0 24 24" class="fc-ico" set:html={icons.download} /> Exportar resultados
      </button>
      <label class="fc-menu-item">
        <svg viewBox="0 0 24 24" class="fc-ico" set:html={icons.upload} /> Importar resultados
        <input type="file" id="import" accept="application/json,.json" class="sr-only" />
      </label>
      <button type="button" class="fc-menu-item" data-open-players>
        <span class="grid w-5 place-items-center" aria-hidden="true">📷</span> Fotos de los jugadores
      </button>
      <button type="button" id="forget-pin" class="fc-menu-item" hidden>
        <span class="grid w-5 place-items-center" aria-hidden="true">🔒</span> Olvidar el PIN en este celu
      </button>
      <a href="/" class="fc-menu-item">
        <svg viewBox="0 0 24 24" class="fc-ico" set:html={icons.back} /> Volver a nachodallago.com
      </a>
      <p id="menu-note" class="fc-muted px-3 pt-2 pb-1 text-[11px] leading-snug"></p>
    </div>

    <!-- Bottom sheet: cargar partido -->
    <dialog id="sheet" class="fc-sheet" aria-labelledby="sheet-title">
      <form id="match-form" autocomplete="off" novalidate>
        <div class="fc-grabber" aria-hidden="true"></div>
        <div class="flex items-center justify-between">
          <h2 id="sheet-title" class="text-lg font-extrabold">Nuevo partido</h2>
          <button type="button" id="clear-draft" class="fc-link ml-auto mr-2" hidden>Limpiar</button>
          <button type="button" class="fc-icon-btn" data-close aria-label="Cerrar">
            <svg viewBox="0 0 24 24" class="fc-ico" set:html={icons.close} />
          </button>
        </div>

        <!-- Marcador en vivo -->
        <div class="fc-preview" aria-hidden="true">
          <div><span class="fc-avatar fc-avatar-lg" data-preview="home">?</span><b data-preview-name="home">Local</b></div>
          <p><span data-preview-goals="home">0</span><i>:</i><span data-preview-goals="away">0</span></p>
          <div><span class="fc-avatar fc-avatar-lg" data-preview="away">?</span><b data-preview-name="away">Visitante</b></div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          {
            sides.map((s) => (
              <fieldset class="flex min-w-0 flex-col gap-3">
                <legend class="fc-label mb-2">{s.label}</legend>
                <div class="fc-picks" role="radiogroup" aria-label={`Jugador ${s.label.toLowerCase()}`}>
                  {players.map((p) => (
                    <label style={`--c:${p.color}`}>
                      <input type="radio" name={`${s.key}Player`} value={p.name} data-color={p.color} required class="sr-only" />
                      <span>
                        <i class="fc-avatar">{initials(p.name)}</i>
                        {p.name}
                      </span>
                    </label>
                  ))}
                </div>
                <input name={`${s.key}Team`} list="teams" maxlength="40" placeholder="Equipo" class="fc-input" aria-label={`Equipo ${s.label.toLowerCase()}`} autocapitalize="words" />
                <div class="fc-team-chips" data-team-chips={s.key} aria-label={`Equipos guardados ${s.label.toLowerCase()}`}></div>
                <div class="fc-stepper">
                  <button type="button" data-step={`${s.key}Goals`} data-delta="-1" aria-label={`Restar gol ${s.label.toLowerCase()}`}>−</button>
                  <input name={`${s.key}Goals`} type="number" inputmode="numeric" min="0" max="99" value="0" aria-label={`Goles ${s.label.toLowerCase()}`} />
                  <button type="button" data-step={`${s.key}Goals`} data-delta="1" aria-label={`Sumar gol ${s.label.toLowerCase()}`}>+</button>
                </div>
              </fieldset>
            ))
          }
        </div>

        <!-- Goles con su tiempo -->
        <div id="goal-panel" class="fc-goal-panel" hidden>
          <div class="flex items-center justify-between gap-2">
            <span class="fc-label">Goles</span>
            <span id="match-clock" class="fc-clock"></span>
          </div>
          <ol id="goal-log" class="fc-goal-log"></ol>
          <p id="goal-empty" class="fc-muted mt-2 text-xs">Tocá + y cada gol queda con su minuto.</p>
        </div>

        <label class="mt-4 block">
          <span class="fc-label">Fecha</span>
          <input name="date" type="date" required value={today} class="fc-input mt-2" />
        </label>

        <p id="form-error" class="mt-3 text-sm font-semibold text-red-400 empty:hidden" role="alert"></p>
        <button type="submit" class="fc-btn fc-btn-primary fc-btn-block mt-4">Guardar resultado</button>
        <datalist id="teams"></datalist>
      </form>
    </dialog>

    <!-- Jugadores: fotos de perfil -->
    <dialog id="players-dialog" class="fc-sheet fc-sheet-sm" aria-labelledby="players-title">
      <div class="fc-grabber" aria-hidden="true"></div>
      <div class="flex items-center justify-between">
        <h2 id="players-title" class="text-lg font-extrabold">Jugadores</h2>
        <button type="button" class="fc-icon-btn" data-close-players aria-label="Cerrar">
          <svg viewBox="0 0 24 24" class="fc-ico" set:html={icons.close} />
        </button>
      </div>
      <p id="players-note" class="fc-muted mt-1 text-sm"></p>
      <ul id="players-list" class="fc-player-list"></ul>
      <input type="file" id="photo-input" accept="image/*" class="sr-only" tabindex="-1" aria-hidden="true" />
    </dialog>

    <!-- PIN para cargar o borrar -->
    <dialog id="pin-dialog" class="fc-sheet fc-sheet-sm" aria-labelledby="pin-title">
      <form id="pin-form" class="text-center" novalidate>
        <div class="fc-grabber" aria-hidden="true"></div>
        <span class="mx-auto mb-3 grid size-12 place-items-center rounded-full bg-white/10 text-xl" aria-hidden="true">🔒</span>
        <h2 id="pin-title" class="text-lg font-extrabold">Ingresá el PIN</h2>
        <p class="fc-muted mt-1 text-sm">Lo necesitás para cargar o borrar partidos. Queda guardado en este celu.</p>
        <input id="pin-input" type="password" autocomplete="off" maxlength="64" class="fc-input mt-4 text-center" aria-label="PIN" />
        <p id="pin-error" class="mt-2 text-sm font-semibold text-red-400 empty:hidden" role="alert"></p>
        <div class="mt-4 grid grid-cols-2 gap-2">
          <button type="button" data-cancel class="fc-btn fc-btn-ghost">Cancelar</button>
          <button type="submit" class="fc-btn fc-btn-primary">Entrar</button>
        </div>
      </form>
    </dialog>

    <!-- Confirmación de borrado -->
    <dialog id="confirm" class="fc-sheet fc-sheet-sm" aria-labelledby="confirm-title">
      <form method="dialog" class="text-center">
        <div class="fc-grabber" aria-hidden="true"></div>
        <span class="mx-auto mb-3 grid size-12 place-items-center rounded-full bg-red-500/15 text-red-400">
          <svg viewBox="0 0 24 24" class="fc-ico" set:html={icons.trash} />
        </span>
        <h2 id="confirm-title" class="text-lg font-extrabold">¿Borrar este partido?</h2>
        <p id="confirm-text" class="fc-muted mt-1 text-sm"></p>
        <div class="mt-5 grid grid-cols-2 gap-2">
          <button value="cancel" class="fc-btn fc-btn-ghost">Cancelar</button>
          <button value="ok" class="fc-btn fc-btn-danger">Borrar</button>
        </div>
      </form>
    </dialog>

    <p id="toast" class="fc-toast" role="status" aria-live="polite"></p>
  </div>
</Layout>

<template id="match-tpl">
  <li class="fc-card fc-match">
    <div class="fc-match-side">
      <span class="fc-avatar"></span>
      <div class="min-w-0"><p class="fc-player"></p><p class="fc-team"></p></div>
    </div>
    <p class="fc-score"><span></span><span></span></p>
    <div class="fc-match-side fc-match-away">
      <span class="fc-avatar"></span>
      <div class="min-w-0"><p class="fc-player"></p><p class="fc-team"></p></div>
    </div>
    <button type="button" class="fc-delete" aria-label="Borrar partido">
      <svg viewBox="0 0 24 24" class="fc-ico" set:html={icons.trash} />
    </button>
    <ol class="fc-goals" aria-label="Goles"></ol>
  </li>
</template>

<style is:global>
  /* En la capa components: las utilidades de Tailwind (hidden, md:*) siguen ganando */
  @layer components {
    /* Mobile first: base para el celu; @media (min-width) suma para pantallas grandes */
    .fc {
      --fc-bg: #07090a;
      --fc-card: rgb(255 255 255 / .045);
      --fc-line: rgb(255 255 255 / .09);
      --fc-muted: rgb(255 255 255 / .55);
      --fc-accent: #c4ff4d;
      --fc-win: #4ade80;
      --fc-draw: #a1a1aa;
      --fc-loss: #f87171;
      --fc-radius: 1.25rem;
      color: #fff;
      min-height: 100dvh;
        position: relative;
        isolation: isolate;
        /* Nada puede empujar el ancho: sin scroll ni arrastre horizontal en el celu */
        overflow-x: clip;
        touch-action: pan-y pinch-zoom;
      }
    /* Fondo: estadio de noche con líneas de cancha muy sutiles */
    .fc::before {
      content: '';
      position: fixed;
      inset: 0;
      z-index: -1;
      background:
        radial-gradient(circle at 50% 45%, transparent 6.5rem, rgb(255 255 255 / .04) 6.5rem, rgb(255 255 255 / .04) calc(6.5rem + 2px), transparent calc(6.5rem + 2px)),
        linear-gradient(to bottom, transparent calc(45% - 1px), rgb(255 255 255 / .04) calc(45% - 1px), rgb(255 255 255 / .04) calc(45% + 1px), transparent calc(45% + 1px)),
        radial-gradient(60rem 30rem at 50% -8rem, rgb(34 197 94 / .28), transparent 70%),
        radial-gradient(30rem 20rem at 100% 100%, rgb(196 255 77 / .08), transparent 70%),
        repeating-linear-gradient(90deg, rgb(255 255 255 / .012) 0 3rem, transparent 3rem 6rem),
        var(--fc-bg);
    }

    .fc-muted { color: var(--fc-muted); }
    .fc-ico { width: 1.25rem; height: 1.25rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }

    /* Header */
    .fc-header {
      position: sticky;
      top: 0;
      z-index: 40;
      padding-top: env(safe-area-inset-top);
      background: rgb(7 9 10 / .7);
      backdrop-filter: blur(20px) saturate(1.4);
      -webkit-backdrop-filter: blur(20px) saturate(1.4);
      border-bottom: 1px solid var(--fc-line);
    }
    .fc-logo { display: block; height: 2.5rem; flex-shrink: 0; }
    .fc-logo svg { height: 100%; width: auto; }
    .fc-eyebrow { font-size: .65rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--fc-accent); }

    /* Cards y botones */
    .fc-card {
      background: var(--fc-card);
      border: 1px solid var(--fc-line);
      border-radius: var(--fc-radius);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
    .fc-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: .45rem;
      min-height: 2.75rem;
      padding: 0 1.1rem;
      border-radius: 999px;
      font-weight: 700;
      font-size: .95rem;
      touch-action: manipulation;
      transition: transform .15s ease, background .2s ease, box-shadow .2s ease;
    }
    .fc-btn:active { transform: scale(.97); }
    .fc-btn-primary { background: var(--fc-accent); color: #07090a; }
    .fc-btn-ghost { background: rgb(255 255 255 / .08); color: #fff; }
    .fc-btn-danger { background: #ef4444; color: #fff; }
    .fc-btn-block { width: 100%; min-height: 3.25rem; font-size: 1rem; }
    .fc-icon-btn {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      border-radius: 999px;
      background: rgb(255 255 255 / .06);
      color: #fff;
    }
    .fc-pill {
      font-size: .75rem;
      font-weight: 700;
      padding: .2rem .6rem;
      border-radius: 999px;
      background: rgb(255 255 255 / .08);
      color: var(--fc-muted);
    }
    .fc-pill:empty { display: none; }

    .fc-section { scroll-margin-top: 5rem; }
    .fc-section-head { display: flex; align-items: baseline; justify-content: space-between; gap: .75rem; margin-bottom: .75rem; }
    .fc-section-head h2 { font-size: 1.35rem; font-weight: 800; letter-spacing: -.02em; }

    /* Avatares con iniciales */
    .fc-avatar {
      display: inline-grid;
      place-items: center;
      flex-shrink: 0;
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 999px;
      font-style: normal;
      font-size: .75rem;
      font-weight: 800;
      letter-spacing: .02em;
      color: #07090a;
      background: linear-gradient(140deg, color-mix(in oklab, var(--c, #71717a) 100%, white 25%), var(--c, #71717a));
      box-shadow: 0 0 0 2px rgb(7 9 10 / .9), 0 0 18px color-mix(in oklab, var(--c, #71717a) 35%, transparent);
    }
    .fc-avatar-lg { width: 3.25rem; height: 3.25rem; font-size: 1rem; }
    .fc-avatar-xl { width: 4.5rem; height: 4.5rem; font-size: 1.4rem; }

    /* Líder */
    .fc-leader {
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1.1rem;
      background:
        radial-gradient(20rem 12rem at 0% 0%, color-mix(in oklab, var(--c, var(--fc-accent)) 22%, transparent), transparent 70%),
        var(--fc-card);
    }
    .fc-leader-crown { position: absolute; top: .35rem; left: 3.6rem; font-size: 1.1rem; rotate: 18deg; }
    .fc-leader-pts { margin-left: auto; text-align: right; }
    .fc-leader-pts b { display: block; font-size: 2.25rem; line-height: 1; font-weight: 900; color: var(--c, var(--fc-accent)); font-variant-numeric: tabular-nums; }
    .fc-leader-pts small, .fc-stat small { font-size: .7rem; font-weight: 600; color: var(--fc-muted); text-transform: uppercase; letter-spacing: .08em; }

    .fc-stat { display: grid; gap: .15rem; padding: .85rem .5rem; text-align: center; }
    .fc-stat span { font-size: 1.6rem; font-weight: 900; font-variant-numeric: tabular-nums; }

    /* Tabla */
    .fc-standings-head, .fc-row {
      display: grid;
      grid-template-columns: 1.5rem minmax(0, 1fr) 2rem 2.25rem 2.25rem;
      align-items: center;
      gap: .5rem;
      padding: 0 .9rem;
    }
    .fc-standings-head {
      min-height: 2.25rem;
      font-size: .65rem;
      font-weight: 700;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--fc-muted);
      border-bottom: 1px solid var(--fc-line);
    }
    .fc-standings-head span:nth-child(n + 3), .fc-row > :nth-child(n + 3) { text-align: center; }
    .fc-form-col { display: none; }
    .fc-row { min-height: 3.75rem; font-variant-numeric: tabular-nums; }
    .fc-row + .fc-row { border-top: 1px solid var(--fc-line); }
    .fc-rank { font-weight: 800; color: var(--fc-muted); }
    .fc-rank.lead { color: #facc15; }
    .fc-who { display: flex; align-items: center; gap: .65rem; min-width: 0; }
    .fc-who p { font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .fc-who small { display: block; font-size: .7rem; color: var(--fc-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .fc-pts { font-weight: 900; font-size: 1.05rem; color: var(--fc-accent); }
    .fc-form { display: none; gap: .2rem; justify-content: center; }
    .fc-form i {
      width: 1.15rem;
      height: 1.15rem;
      border-radius: .3rem;
      display: grid;
      place-items: center;
      font-style: normal;
      font-size: .6rem;
      font-weight: 800;
      color: #07090a;
    }
    .fc-form .w { background: var(--fc-win); }
    .fc-form .d { background: var(--fc-draw); }
    .fc-form .l { background: var(--fc-loss); }
    /* En el celu la forma va debajo del nombre */
    .fc-who .fc-form { display: flex; justify-content: flex-start; margin-top: .3rem; }
    .fc-who .fc-form i { width: .95rem; height: .95rem; font-size: .5rem; }

    /* Partidos */
    .fc-day { font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--fc-muted); margin: 0 0 .5rem .25rem; }
    .fc-day + ol { display: grid; gap: .5rem; }
    .fc-match {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      gap: .6rem;
      padding: .9rem 2.4rem .9rem .9rem;
    }
    .fc-match-side { display: flex; flex-direction: column; align-items: center; gap: .35rem; text-align: center; min-width: 0; }
    .fc-match-side > div { width: 100%; }
    .fc-player { font-weight: 700; font-size: .9rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--fc-muted); }
    .fc-team { font-size: .7rem; color: var(--fc-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .fc-match .win .fc-player { color: #fff; }
    .fc-match .lose .fc-avatar { filter: grayscale(.7) brightness(.7); }
    .fc-score { display: flex; gap: .25rem; }
    .fc-score span {
      display: grid;
      place-items: center;
      width: 2.4rem;
      height: 2.8rem;
      border-radius: .65rem;
      background: rgb(255 255 255 / .07);
      font-size: 1.5rem;
      font-weight: 900;
      font-variant-numeric: tabular-nums;
    }
    .fc-score .win { background: #fff; color: #07090a; }
    .fc-delete {
      position: absolute;
      top: .35rem;
      right: .35rem;
      display: grid;
      place-items: center;
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 999px;
      color: rgb(255 255 255 / .35);
    }
    .fc-delete .fc-ico { width: 1rem; height: 1rem; }
    .fc-delete:active { color: #f87171; background: rgb(239 68 68 / .12); }
    .fc-empty { display: grid; justify-items: center; gap: .35rem; padding: 2rem 1rem; text-align: center; }

    /* Dock flotante */
    .fc-dock {
      position: fixed;
      left: .75rem;
      right: .75rem;
      bottom: calc(.75rem + env(safe-area-inset-bottom));
      z-index: 40;
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      align-items: center;
      height: 4rem;
      padding: 0 .25rem;
      border-radius: 1.5rem;
      background: rgb(20 22 24 / .78);
      border: 1px solid var(--fc-line);
      backdrop-filter: blur(20px) saturate(1.4);
      -webkit-backdrop-filter: blur(20px) saturate(1.4);
      box-shadow: 0 12px 40px rgb(0 0 0 / .5);
    }
    .fc-dock-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: .2rem;
      height: 100%;
      font-size: .65rem;
      font-weight: 600;
      color: var(--fc-muted);
      -webkit-tap-highlight-color: transparent;
      transition: color .2s ease;
    }
    .fc-dock-item[aria-current='true'] { color: var(--fc-accent); }
    .fc-fab {
      justify-self: center;
      display: grid;
      place-items: center;
      width: 3.5rem;
      height: 3.5rem;
      position: relative;
    margin-top: -1.75rem;
      border-radius: 999px;
      background: var(--fc-accent);
      color: #07090a;
      box-shadow: 0 0 0 5px var(--fc-bg), 0 10px 30px color-mix(in oklab, var(--fc-accent) 45%, transparent);
      touch-action: manipulation;
      transition: transform .15s ease;
    }
    /* Puntito: hay un partido a medio cargar */
    .fc-fab.has-draft::after {
      content: '';
      position: absolute;
      top: .2rem;
      right: .2rem;
      width: .8rem;
      height: .8rem;
      border-radius: 999px;
      background: #ff9354;
      box-shadow: 0 0 0 3px var(--fc-bg);
    }
    .fc-link { min-height: 2.75rem; padding: 0 .5rem; font-size: .85rem; font-weight: 700; color: var(--fc-muted); }
    .fc-fab .fc-ico { width: 1.6rem; height: 1.6rem; stroke-width: 2.5; }
    .fc-fab:active { transform: scale(.92); }

    /* Menú popover */
    .fc-menu {
      position: fixed;
      inset: auto .75rem calc(5.5rem + env(safe-area-inset-bottom)) auto;
      margin: 0;
      width: min(18rem, calc(100vw - 1.5rem));
      padding: .4rem;
      border-radius: 1.1rem;
      border: 1px solid var(--fc-line);
      background: rgb(24 26 28 / .95);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      color: #fff;
      box-shadow: 0 20px 50px rgb(0 0 0 / .55);
      opacity: 0;
      translate: 0 .5rem;
      transition: opacity .18s ease, translate .22s var(--ease-out), display .22s allow-discrete, overlay .22s allow-discrete;
    }
    .fc-menu:popover-open { opacity: 1; translate: 0 0; }
    @starting-style { .fc-menu:popover-open { opacity: 0; translate: 0 .5rem; } }
    .fc-menu-item {
      display: flex;
      align-items: center;
      gap: .7rem;
      width: 100%;
      min-height: 2.9rem;
      padding: 0 .75rem;
      border-radius: .75rem;
      font-size: .95rem;
      font-weight: 600;
      text-align: left;
      cursor: pointer;
    }
    .fc-menu-item:active, .fc-menu-item:focus-within { background: rgb(255 255 255 / .08); }

    /* Bottom sheet (dialog nativo) */
    .fc-sheet {
      position: fixed;
      inset: auto 0 0 0;
      margin: 0;
      width: 100%;
      max-width: none;
      max-height: 92dvh;
      overflow-y: auto;
      overflow-x: hidden;
      overscroll-behavior: contain;
      padding: .5rem 1rem calc(1rem + env(safe-area-inset-bottom));
      border: 1px solid var(--fc-line);
      border-bottom: 0;
      border-radius: 1.75rem 1.75rem 0 0;
      background: #121416;
      color: #fff;
      translate: 0 100%;
      transition: translate .35s var(--ease-out), display .35s allow-discrete, overlay .35s allow-discrete;
    }
    .fc-sheet[open] { translate: 0 0; }
    @starting-style { .fc-sheet[open] { translate: 0 100%; } }
    .fc-sheet::backdrop {
      background: rgb(0 0 0 / 0);
      backdrop-filter: blur(0);
      transition: background .3s ease, backdrop-filter .3s ease, display .3s allow-discrete, overlay .3s allow-discrete;
    }
    .fc-sheet[open]::backdrop { background: rgb(0 0 0 / .6); backdrop-filter: blur(4px); }
    @starting-style { .fc-sheet[open]::backdrop { background: rgb(0 0 0 / 0); backdrop-filter: blur(0); } }
    .fc-grabber { width: 2.5rem; height: .3rem; margin: .25rem auto .9rem; border-radius: 999px; background: rgb(255 255 255 / .2); }

    .fc-label { font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--fc-muted); }
    .fc-input {
      width: 100%;
      min-width: 0;
      min-height: 2.9rem;
      padding: 0 .85rem;
      border-radius: .85rem;
      border: 1px solid var(--fc-line);
      background: rgb(255 255 255 / .05);
      color: #fff;
      /* 16px: iOS no hace zoom al enfocar */
      font-size: 1rem;
      color-scheme: dark;
    }
    /* iOS le da al date un ancho mínimo propio que rompe el layout */
    .fc-input[type='date'] { display: block; -webkit-appearance: none; appearance: none; line-height: 2.9rem; }
    .fc-input::-webkit-date-and-time-value { text-align: left; }
    .fc-input::placeholder { color: rgb(255 255 255 / .35); }
    .fc-input:focus { outline: none; border-color: var(--fc-accent); box-shadow: 0 0 0 3px color-mix(in oklab, var(--fc-accent) 25%, transparent); }

    .fc-preview {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: .5rem;
      margin-bottom: 1.1rem;
      padding: 1rem .5rem;
      border-radius: var(--fc-radius);
      background: linear-gradient(180deg, rgb(255 255 255 / .06), rgb(255 255 255 / .02));
      border: 1px solid var(--fc-line);
    }
    .fc-preview > div { display: grid; justify-items: center; gap: .4rem; min-width: 0; }
    .fc-preview b { font-size: .85rem; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .fc-preview p { display: flex; align-items: center; gap: .35rem; font-size: 2.5rem; font-weight: 900; font-variant-numeric: tabular-nums; line-height: 1; }
    .fc-preview i { font-style: normal; color: var(--fc-muted); font-size: 1.8rem; }

    .fc-picks { display: grid; grid-template-columns: 1fr; gap: .4rem; }
    .fc-picks label { display: block; cursor: pointer; }
    .fc-picks label > span {
      display: flex;
      align-items: center;
      gap: .55rem;
      min-height: 2.9rem;
      padding: 0 .5rem;
      border-radius: .85rem;
      border: 1px solid var(--fc-line);
      background: rgb(255 255 255 / .04);
      font-size: .9rem;
      font-weight: 700;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
      transition: background .15s ease, border-color .15s ease, opacity .15s ease;
    }
    .fc-picks .fc-avatar { width: 1.85rem; height: 1.85rem; font-size: .65rem; box-shadow: none; }
    .fc-picks input:checked + span {
      border-color: var(--c);
      background: color-mix(in oklab, var(--c) 16%, transparent);
    }
    .fc-picks input:focus-visible + span { outline: 2px solid var(--c); outline-offset: 2px; }
    .fc-picks input:disabled + span { opacity: .25; cursor: not-allowed; }

    /* Fotos de perfil */

    .fc-avatar.has-photo { background-size: cover; background-position: center; color: transparent; }

    .fc-who .fc-avatar { cursor: pointer; }

    .fc-player-list { display: grid; gap: .5rem; margin-top: 1rem; }

    .fc-player-item {

      display: flex;

      align-items: center;

      gap: .75rem;

      padding: .6rem;

      border-radius: 1rem;

      border: 1px solid var(--fc-line);

      background: rgb(255 255 255 / .04);

    }

    .fc-player-item > b { flex: 1; min-width: 0; font-size: 1rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    .fc-player-item .fc-btn { min-height: 2.5rem; padding: 0 .85rem; font-size: .85rem; }

    .fc-player-item .fc-avatar.busy { animation: fc-pulse 1s ease-in-out infinite; }

    @keyframes fc-pulse { 50% { opacity: .4; } }

    /* Aviso de sincronización */

    .fc-banner {

      display: flex;

      align-items: center;

      gap: .75rem;

      padding: .7rem .7rem .7rem .95rem;

      border-radius: 1rem;

      border: 1px solid color-mix(in oklab, #ff9354 45%, transparent);

      background: color-mix(in oklab, #ff9354 12%, transparent);

      font-size: .85rem;

      font-weight: 600;

    }

    .fc-banner[hidden] { display: none; }

    .fc-btn:disabled { opacity: .6; pointer-events: none; }

    /* Equipos guardados: se eligen tocando */

    .fc-team-chips { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: -.3rem; }

    .fc-team-chips:empty { display: none; }

    .fc-team-chips button {

      max-width: 100%;

      min-height: 2.25rem;

      padding: 0 .75rem;

      border-radius: 999px;

      border: 1px solid var(--fc-line);

      background: rgb(255 255 255 / .05);

      color: var(--fc-muted);

      font-size: .78rem;

      font-weight: 600;

      white-space: nowrap;

      overflow: hidden;

      text-overflow: ellipsis;

      touch-action: manipulation;

      -webkit-tap-highlight-color: transparent;

    }

    .fc-team-chips button.on {

      border-color: var(--fc-accent);

      background: color-mix(in oklab, var(--fc-accent) 14%, transparent);

      color: #fff;

    }


    /* Línea de tiempo de goles */

    .fc-goal-panel {

      margin-top: 1rem;

      padding: .85rem;

      border-radius: 1rem;

      border: 1px solid var(--fc-line);

      background: rgb(255 255 255 / .04);

    }

    .fc-clock { font-size: .8rem; font-weight: 700; color: var(--fc-accent); font-variant-numeric: tabular-nums; }

    .fc-goal-log { display: grid; gap: .4rem; margin-top: .6rem; }

    .fc-goal-log li { display: flex; align-items: center; gap: .5rem; font-size: .85rem; min-width: 0; }

    .fc-goal-log li.away { flex-direction: row-reverse; text-align: right; }

    .fc-goal-log b { min-width: 2.25rem; color: var(--fc-accent); font-variant-numeric: tabular-nums; }

    .fc-goal-log span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }

    .fc-goal-log small { color: var(--fc-muted); font-variant-numeric: tabular-nums; }

    .fc-goal-log i { width: .6rem; height: .6rem; border-radius: 999px; background: var(--c, #71717a); flex-shrink: 0; }


    /* Goles en la tarjeta del partido */

    .fc-goals {

      grid-column: 1 / -1;

      display: flex;

      flex-wrap: wrap;

      gap: .3rem;

      margin-right: -1.5rem;

      padding-top: .65rem;

      border-top: 1px solid var(--fc-line);

    }

    .fc-goals:empty { display: none; }

    .fc-goals li {

      display: inline-flex;

      align-items: center;

      gap: .3rem;

      padding: .2rem .55rem;

      border-radius: 999px;

      background: rgb(255 255 255 / .06);

      font-size: .72rem;

      font-weight: 600;

    }

    .fc-goals li::before { content: ''; width: .5rem; height: .5rem; border-radius: 999px; background: var(--c, #71717a); }

    .fc-goals b { font-variant-numeric: tabular-nums; }

    .fc-goals small { color: var(--fc-muted); font-variant-numeric: tabular-nums; }

    .fc-stepper {
      display: grid;
      grid-template-columns: 2.75rem 1fr 2.75rem;
      align-items: center;
      gap: .25rem;
      padding: .25rem;
      border-radius: 999px;
      background: rgb(255 255 255 / .05);
      border: 1px solid var(--fc-line);
    }
    .fc-stepper button {
      height: 2.75rem;
      border-radius: 999px;
      background: rgb(255 255 255 / .08);
      font-size: 1.4rem;
      font-weight: 700;
      line-height: 1;
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
    }
    .fc-stepper button:active { background: var(--fc-accent); color: #07090a; }
    .fc-stepper input {
      width: 100%;
      min-width: 0;
      background: transparent;
      text-align: center;
      font-size: 1.5rem;
      font-weight: 900;
      font-variant-numeric: tabular-nums;
      color: #fff;
      -moz-appearance: textfield;
    }
    .fc-stepper input::-webkit-inner-spin-button, .fc-stepper input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
    .fc-stepper input:focus { outline: none; color: var(--fc-accent); }

    /* Toast */
    .fc-toast {
      position: fixed;
      left: 50%;
      top: calc(4.5rem + env(safe-area-inset-top));
      z-index: 60;
      max-width: calc(100vw - 2rem);
      padding: .7rem 1.1rem;
      border-radius: 999px;
      background: rgb(24 26 28 / .95);
      border: 1px solid color-mix(in oklab, var(--fc-accent) 45%, transparent);
      color: #fff;
      font-size: .9rem;
      font-weight: 700;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      box-shadow: 0 12px 40px rgb(0 0 0 / .5);
      translate: -50% -1rem;
      opacity: 0;
      pointer-events: none;
      transition: opacity .2s ease, translate .3s var(--ease-out);
    }
    .fc-toast.show { opacity: 1; translate: -50% 0; }

    /* Pantallas más grandes */
    @media (min-width: 30rem) {
      .fc-picks { grid-template-columns: 1fr 1fr; }
    }

    @media (min-width: 40rem) {
      .fc-standings-head, .fc-row { grid-template-columns: 1.5rem minmax(0, 1fr) 7rem 2.25rem 2.5rem 2.5rem; }
      .fc-form-col, .fc-row > .fc-form { display: flex; }
      .fc-form-col { justify-content: center; }
      .fc-who .fc-form { display: none; }
      .fc-match { padding-inline: 1.25rem 2.75rem; }
      .fc-match-side { flex-direction: row; justify-content: flex-end; text-align: right; }
      .fc-match-side > div { width: auto; }
      .fc-match-side .fc-avatar { order: 2; }
      .fc-match-away { justify-content: flex-start; text-align: left; }
      .fc-match-away .fc-avatar { order: 0; }
    }

    @media (min-width: 48rem) {
      .fc-logo { height: 3rem; }
      .fc-sheet {
        inset: 0;
        margin: auto;
        width: min(34rem, calc(100vw - 2rem));
        max-height: 90dvh;
        padding: 1.5rem;
        border-bottom: 1px solid var(--fc-line);
        border-radius: 1.75rem;
        translate: 0 0;
        opacity: 0;
        scale: .96;
        transition: opacity .25s ease, scale .3s var(--ease-out), display .3s allow-discrete, overlay .3s allow-discrete;
      }
      .fc-sheet[open] { opacity: 1; scale: 1; }
      @starting-style { .fc-sheet[open] { opacity: 0; scale: .96; } }
      .fc-sheet-sm { width: min(24rem, calc(100vw - 2rem)); }
      .fc-grabber { display: none; }
      .fc-menu { inset: 4.5rem max(1rem, calc(50vw - 24rem + 1rem)) auto auto; }
      .fc-toast { top: auto; bottom: 2rem; translate: -50% 1rem; }
    }

    @media (hover: hover) {
      .fc-btn-primary:hover { box-shadow: 0 0 28px color-mix(in oklab, var(--fc-accent) 40%, transparent); }
      .fc-icon-btn:hover, .fc-btn-ghost:hover { background: rgb(255 255 255 / .12); }
      .fc-menu-item:hover { background: rgb(255 255 255 / .08); }
      .fc-delete:hover { color: #f87171; background: rgb(239 68 68 / .12); }
      .fc-picks label:hover > span { border-color: rgb(255 255 255 / .25); }
    }

    @media (prefers-reduced-motion: reduce) {
      .fc-sheet, .fc-menu, .fc-toast { transition: none; }
    }
