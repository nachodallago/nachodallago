      font-size: 1.5rem;
      line-height: 1;
      translate: var(--x) 0;
      rotate: calc(var(--p, 0) * 540deg);
      touch-action: none;
      cursor: grab;
      box-shadow: 0 4px 16px color-mix(in oklab, var(--fc-accent) 40%, transparent);
    }
    .fc-swipe-thumb:active { cursor: grabbing; }
    .fc-swipe[aria-disabled='true'] .fc-swipe-thumb { cursor: not-allowed; }
    /* Al soltar sin llegar, vuelve con un resorte */
    .fc-swipe.back .fc-swipe-thumb, .fc-swipe.back .fc-swipe-fill { transition: translate .35s var(--ease-out), rotate .35s var(--ease-out), width .35s var(--ease-out); }
    .fc-swipe.done { border-color: var(--fc-accent); }
    .fc-stepper:has(:disabled) { opacity: .4; }
    /* Panel de partido en dos etapas: preparar (jugadores) y en juego (marcador grande) */
    #match-form[data-phase='setup'] .fc-board,
    #match-form[data-phase='setup'] #goal-panel,
    #match-form[data-phase='setup'] [type='submit'] { display: none; }
    #match-form[data-phase='play'] .fc-setup { display: none; }
    .fc-team-edit summary {
      display: flex;
      align-items: center;
