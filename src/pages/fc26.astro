      font-weight: 800;
      color: transparent;
      background: linear-gradient(90deg, rgb(255 255 255 / .45) 0%, #fff 50%, rgb(255 255 255 / .45) 100%) 0 0 / 200% 100%;
      -webkit-background-clip: text;
      background-clip: text;
      animation: fc-shimmer 2.2s linear infinite;
      pointer-events: none;
      opacity: calc(1 - var(--p, 0) * 1.6);
    }
    @keyframes fc-shimmer { to { background-position: -200% 0; } }
    .fc-swipe-thumb {
      position: absolute;
      top: .25rem;
