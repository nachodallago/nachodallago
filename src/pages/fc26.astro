      inset: -45% -40%;
      z-index: -1;
      background: radial-gradient(closest-side, rgb(0 0 0 / .72), rgb(0 0 0 / .35) 60%, transparent);
    }
    .fc-fx-net { width: 100%; filter: drop-shadow(0 10px 30px rgb(0 0 0 / .6)); animation: fc-net 2.2s ease both; transform-origin: 50% 70%; }
    .fc-fx-ball {
      position: absolute;
      left: 50%;
      top: 55%;
      font-size: 3rem;
      line-height: 1;
      translate: -50% -50%;
      animation: fc-ball 2.2s cubic-bezier(.3, .1, .3, 1) both;
    }
    .fc-fx-text {
      margin-top: .5rem;
      font-size: clamp(2.5rem, 13vw, 4rem);
      font-weight: 900;
      font-style: italic;
      letter-spacing: -.02em;
      background: linear-gradient(100deg, #c4ff4d, #5ee7ff 50%, #b69cff);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      filter: drop-shadow(0 6px 20px rgb(0 0 0 / .7));
      animation: fc-gol-text 2.2s var(--ease-out) both;
    }
    /* La pelota entra en arco desde abajo a la izquierda, gira y se achica al llegar a la red */
    @keyframes fc-ball {
      0% { transform: translate(-46vw, 48vh) scale(1.9) rotate(0deg); opacity: 0; }
      8% { opacity: 1; }
      30% { transform: translate(-22vw, -6vh) scale(1.3) rotate(-300deg); }
      48% { transform: translate(0, -2vh) scale(.75) rotate(-540deg); }
      56% { transform: translate(0, 1vh) scale(.7) rotate(-560deg); }
      85% { transform: translate(0, 1vh) scale(.7) rotate(-560deg); opacity: 1; }
      100% { transform: translate(0, 1vh) scale(.7) rotate(-560deg); opacity: 0; }
    }
    /* La red se infla cuando entra la pelota */
    @keyframes fc-net {
      0%, 46% { transform: none; }
      52% { transform: scale(1.08, 1.12) translateY(-2%); }
      62% { transform: scale(.98, .97); }
      70%, 100% { transform: none; }
    }
    @keyframes fc-gol-text {
      0%, 48% { opacity: 0; scale: .3; }
      58% { opacity: 1; scale: 1.25; }
      66% { scale: 1; }
      88% { opacity: 1; }
      100% { opacity: 0; scale: 1.05; }
    }
    @keyframes fc-fx-in {
      0% { opacity: 0; }
      6%, 88% { opacity: 1; }
      100% { opacity: 0; }
    }
    /* Partido en vivo */
    .fc-live {
      padding: .9rem;
      border-color: color-mix(in oklab, #ef4444 45%, transparent);
      background:
        radial-gradient(18rem 10rem at 50% 0%, rgb(239 68 68 / .14), transparent 70%),
        var(--fc-card);
    }
    .fc-live-head { display: flex; align-items: center; justify-content: space-between; gap: .5rem; }
    .fc-live-badge {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      padding: .2rem .6rem;
      border-radius: 999px;
      background: #ef4444;
      color: #fff;
      font-size: .7rem;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
    }
    .fc-live-badge i { width: .45rem; height: .45rem; border-radius: 999px; background: #fff; animation: fc-pulse 1.2s ease-in-out infinite; }
    .fc-live-score { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: .5rem; margin-top: .8rem; }
    .fc-live-side { display: grid; justify-items: center; gap: .3rem; min-width: 0; text-align: center; }
    .fc-live-side b, .fc-live-side small { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .fc-live-side small { font-size: .7rem; color: var(--fc-muted); }
    .fc-live-score > p { display: flex; align-items: center; gap: .3rem; font-size: 2.6rem; font-weight: 900; line-height: 1; font-variant-numeric: tabular-nums; }
    .fc-live-score > p i { font-style: normal; font-size: 1.8rem; color: var(--fc-muted); }
    .fc-live .fc-goals { margin-top: .8rem; margin-right: 0; }
    .fc-live-flash { animation: fc-flash 1.2s ease; }
    @keyframes fc-flash { 30% { box-shadow: 0 0 0 3px #ef4444, 0 0 40px rgb(239 68 68 / .6); } }

    /* Sin PIN no se ve nada */
    .fc-locked main, .fc-locked .fc-header, .fc-locked .fc-dock { filter: blur(14px); pointer-events: none; user-select: none; }
    .fc-pin-gate [data-cancel] { display: none; }
    .fc-pin-actions { grid-template-columns: 1fr 1fr; }
    .fc-pin-gate .fc-pin-actions { grid-template-columns: 1fr; }
    /* Editor de recorte */
    .fc-crop {
      position: relative;
      width: min(100%, 18rem);
      aspect-ratio: 1;
      margin: 1rem auto 0;
      overflow: hidden;
      border-radius: 1rem;
      background: #000;
      touch-action: none;
      cursor: grab;
      user-select: none;
      -webkit-user-select: none;
    }
    .fc-crop:active { cursor: grabbing; }
    .fc-crop img {
      position: absolute;
      top: 0;
      left: 0;
      max-width: none;
      transform-origin: 0 0;
      pointer-events: none;
      -webkit-user-drag: none;
    }
    /* Fuera del círculo se oscurece: lo que queda adentro es lo que se ve en el avatar */
    .fc-crop-mask {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: radial-gradient(circle closest-side, transparent 99%, rgb(0 0 0 / .6) 100%);
      box-shadow: inset 0 0 0 1px rgb(255 255 255 / .1);
    }
    .fc-crop-mask::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 999px;
      box-shadow: 0 0 0 2px rgb(255 255 255 / .85);
    }
    .fc-crop-zoom { display: flex; align-items: center; gap: .75rem; margin: 1rem auto 0; width: min(100%, 18rem); font-weight: 800; color: var(--fc-muted); }
    .fc-crop-zoom input { flex: 1; accent-color: var(--fc-accent); height: 2.75rem; }

    /* Visor de foto (tocar y se agranda) */
    .fc-viewer {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      max-width: none;
      max-height: none;
      margin: 0;
      padding: 1.5rem;
      border: 0;
      background: transparent;
      color: #fff;
      display: none;
      place-content: center;
      justify-items: center;
      gap: 1.25rem;
      opacity: 0;
      transition: opacity .2s ease, display .25s allow-discrete, overlay .25s allow-discrete;
    }
    .fc-viewer[open] { display: grid; opacity: 1; }
    @starting-style { .fc-viewer[open] { opacity: 0; } }
    .fc-viewer::backdrop { background: rgb(0 0 0 / .85); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }
    .fc-viewer figure { display: grid; justify-items: center; gap: 1rem; }
    .fc-viewer img {
      width: min(82vw, 26rem);
      aspect-ratio: 1;
      border-radius: 999px;
      object-fit: cover;
      box-shadow: 0 0 0 3px var(--c, #fff), 0 30px 80px rgb(0 0 0 / .6);
      transition: scale .35s var(--ease-out);
    }
    @starting-style { .fc-viewer[open] img { scale: .6; } }
    .fc-viewer figcaption { font-size: 1.4rem; font-weight: 800; }
    .fc-viewer .fc-btn[hidden] { display: none; }
    .fc-avatar.has-photo { cursor: zoom-in; }
    .fc-picks .fc-avatar.has-photo, .fc-preview .fc-avatar.has-photo { cursor: inherit; }
    /* Torneos */
    .fc-tbar {
      display: flex;
      align-items: center;
      gap: .7rem;
      width: 100%;
      min-height: 3.5rem;
      padding: .5rem .9rem;
      border-radius: var(--fc-radius);
      border: 1px solid color-mix(in oklab, var(--fc-accent) 30%, transparent);
      background: linear-gradient(90deg, color-mix(in oklab, var(--fc-accent) 10%, transparent), rgb(255 255 255 / .03));
      -webkit-tap-highlight-color: transparent;
    }
    .fc-tbar small { display: block; font-size: .62rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--fc-accent); }
    .fc-tbar b { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 1rem; }
    .fc-tbar-ico { font-size: 1.4rem; }
    .fc-tlist { display: grid; gap: .4rem; margin-top: 1rem; }
    .fc-tlist li { display: flex; align-items: center; gap: .4rem; }
    .fc-tlist .pick {
      flex: 1;
      min-width: 0;
      display: flex;
      align-items: center;
      gap: .6rem;
      min-height: 3rem;
      padding: 0 .85rem;
      border-radius: .9rem;
      border: 1px solid var(--fc-line);
      background: rgb(255 255 255 / .04);
      text-align: left;
      font-weight: 700;
    }
    .fc-tlist .pick span:first-child { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .fc-tlist .pick small { font-weight: 600; color: var(--fc-muted); white-space: nowrap; }
    .fc-tlist .pick[aria-current='true'] { border-color: var(--fc-accent); background: color-mix(in oklab, var(--fc-accent) 12%, transparent); }
    .fc-tlist .edit { flex-shrink: 0; min-height: 3rem; padding: 0 .8rem; border-radius: .9rem; border: 1px solid var(--fc-line); font-size: .8rem; font-weight: 700; color: var(--fc-muted); }
    .fc-tpick { display: grid; gap: .35rem; max-height: 45dvh; overflow-y: auto; overscroll-behavior: contain; padding-right: .15rem; }
    .fc-tpick label {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: .65rem;
      min-height: 3rem;
      padding: .45rem .7rem;
      border-radius: .85rem;
      border: 1px solid var(--fc-line);
      background: rgb(255 255 255 / .03);
      cursor: pointer;
    }
    .fc-tpick label:has(:checked) { border-color: var(--fc-accent); background: color-mix(in oklab, var(--fc-accent) 10%, transparent); }
    .fc-tpick input { width: 1.2rem; height: 1.2rem; accent-color: var(--fc-accent); }
    .fc-tpick b { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: .88rem; }
    .fc-tpick small { display: block; font-size: .7rem; color: var(--fc-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .fc-tpick .score { font-weight: 900; font-variant-numeric: tabular-nums; }
    .fc-tedit-actions { position: sticky; bottom: calc(-1 * (1rem + env(safe-area-inset-bottom))); display: flex; gap: .5rem; margin-top: 1rem; padding: .75rem 0 calc(1rem + env(safe-area-inset-bottom)); background: #121416; }
    .fc-tedit-actions [hidden] { display: none; }
    .fc-select { appearance: none; -webkit-appearance: none; padding-right: 2rem; background-image: linear-gradient(45deg, transparent 50%, rgb(255 255 255 / .6) 50%), linear-gradient(135deg, rgb(255 255 255 / .6) 50%, transparent 50%); background-position: calc(100% - 1rem) 50%, calc(100% - .7rem) 50%; background-size: .3rem .3rem; background-repeat: no-repeat; text-overflow: ellipsis; }
    .fc-select option { background: #121416; color: #fff; }
    .fc-md-tournament { display: flex; align-items: center; gap: .6rem; margin-top: 1rem; font-size: .8rem; font-weight: 700; color: var(--fc-muted); white-space: nowrap; }
    .fc-md-tournament[hidden] { display: none; }
    .fc-md-tournament select { min-height: 2.5rem; font-size: .9rem; }
    /* Detalle del partido */
    .fc-match, .fc-pd-match { cursor: pointer; -webkit-tap-highlight-color: transparent; }
    .fc-match:focus-visible, .fc-pd-match:focus-visible { outline: 2px solid var(--fc-accent); outline-offset: 2px; }
    .fc-md-score { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: .5rem; margin-top: .75rem; }
    .fc-md-side { display: grid; justify-items: center; gap: .3rem; min-width: 0; text-align: center; }
    .fc-md-side b { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .fc-md-side small { max-width: 100%; font-size: .72rem; color: var(--fc-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .fc-md-score > p { font-size: 2.6rem; font-weight: 900; line-height: 1; font-variant-numeric: tabular-nums; }

    /* Línea de tiempo: 0'–90' en dos tiempos; local arriba, visitante abajo */
    .fc-tl-halves { display: grid; grid-template-columns: 1fr 1fr; margin-left: var(--lane-w, 0); font-size: .65rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--fc-muted); }
    .fc-tl-halves span { text-align: center; }
    .fc-tl-plot {
      position: relative;
      margin-top: .35rem;
      border-radius: .85rem;
      background:
        linear-gradient(90deg, rgb(255 255 255 / .03) 50%, rgb(255 255 255 / .015) 50%);
      border: 1px solid var(--fc-line);
    }
    /* Eje central (hairline) y entretiempo */
    .fc-tl-axis { position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: rgb(255 255 255 / .18); }
    .fc-tl-ht { position: absolute; top: 0; bottom: 0; width: 1px; background: rgb(255 255 255 / .3); }
    .fc-tl-ht::after {
      content: 'ET';
      position: absolute;
      top: 50%;
      left: 50%;
      translate: -50% -50%;
      padding: .05rem .3rem;
      border-radius: .3rem;
      background: #121416;
      font-size: .55rem;
      font-weight: 800;
      color: var(--fc-muted);
    }
    /* Cada gol: palito desde el eje + punto con anillo del color de la superficie + minuto */
    .fc-tl-tip {
      position: absolute;
      bottom: calc(100% + .3rem);
      left: 50%;
      translate: -50% .25rem;
      z-index: 2;
      padding: .35rem .55rem;
      border-radius: .55rem;
      background: #1f2226;
      border: 1px solid var(--fc-line);
      box-shadow: 0 8px 24px rgb(0 0 0 / .5);
      font-size: .72rem;
      font-weight: 600;
      white-space: nowrap;
      opacity: 0;
      pointer-events: none;
      transition: opacity .15s ease, translate .15s ease;
    }
    /* Barras por tramo de 15': la mitad de arriba es del local, la de abajo del visitante */
    .fc-tl-plot.fc-bars { --lane: 4.75rem; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); height: calc(var(--lane) * 2); }
    .fc-bin { position: relative; display: grid; grid-template-rows: 1fr 1fr; min-width: 0; }
    .fc-bin .lane { display: flex; justify-content: center; min-height: 0; }
    .fc-bin .lane.home { align-items: flex-end; padding-bottom: 1px; }
    .fc-bin .lane.away { align-items: flex-start; padding-top: 2px; }
    .fc-bar {
      position: relative;
      width: min(1.5rem, 55%);
      height: calc(var(--h) * (var(--lane) - 1.5rem));
      min-height: .5rem;
      background: var(--c);
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
    }
    /* Punta redondeada (4px) del lado del dato; cuadrada contra el eje */
    .lane.home .fc-bar { border-radius: 4px 4px 0 0; }
    .lane.away .fc-bar { border-radius: 0 0 4px 4px; }
    .fc-bar-n { position: absolute; left: 50%; translate: -50% 0; font-size: .75rem; font-weight: 800; color: #fff; font-variant-numeric: tabular-nums; }
    .lane.home .fc-bar-n { bottom: calc(100% + .15rem); }
    .lane.away .fc-bar-n { top: calc(100% + .15rem); }
    .fc-bar .fc-tl-tip { bottom: calc(100% + 1.4rem); }
    .lane.away .fc-bar .fc-tl-tip { bottom: auto; top: calc(100% + 1.4rem); }
    .fc-bar.edge-l .fc-tl-tip { left: 0; translate: 0 .25rem; }
    .fc-bar.edge-r .fc-tl-tip { left: auto; right: 0; translate: 0 .25rem; }
    .fc-bar:hover .fc-tl-tip, .fc-bar:focus-visible .fc-tl-tip, .fc-bar.show .fc-tl-tip { opacity: 1; translate: -50% 0; }
    .fc-bar.edge-l:is(:hover, :focus-visible, .show) .fc-tl-tip, .fc-bar.edge-r:is(:hover, :focus-visible, .show) .fc-tl-tip { translate: 0 0; }
    .fc-bar:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
    .fc-tl-ticks { position: relative; height: 1.1rem; margin-top: .3rem; font-size: .62rem; color: var(--fc-muted); font-variant-numeric: tabular-nums; }
    .fc-tl-ticks span { position: absolute; translate: -50% 0; }
    .fc-tl-ticks span:first-child { translate: 0 0; }
    .fc-tl-ticks span:last-child { translate: -100% 0; }
    .fc-tl-player { display: flex; align-items: center; gap: .5rem; min-width: 0; }
    .fc-tl-player.top { margin-bottom: .6rem; }
    .fc-tl-player.bottom { margin-top: .35rem; }
    .fc-tl-player .fc-avatar { width: 1.9rem; height: 1.9rem; font-size: .6rem; box-shadow: 0 0 0 2px #121416, 0 0 0 3.5px var(--c); }
    .fc-tl-player b { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .fc-tl-player small { margin-left: auto; font-size: .72rem; color: var(--fc-muted); white-space: nowrap; }
    /* Flechita que indica de qué lado de la línea están sus goles */
    .fc-tl-player b::after { margin-left: .35rem; font-size: .7rem; color: var(--fc-muted); }
    .fc-tl-player.top b::after { content: '▼'; }
    .fc-tl-player.bottom b::after { content: '▲'; }
    .fc-md-halves { margin-top: .75rem; font-size: .85rem; color: var(--fc-muted); }
    .fc-md-halves b { color: #fff; font-variant-numeric: tabular-nums; }
    .fc-md-goals { display: grid; gap: .35rem; }
    .fc-md-goals li { display: grid; grid-template-columns: 2.6rem auto minmax(0, 1fr) auto; align-items: center; gap: .55rem; padding: .45rem .6rem; border-radius: .8rem; background: rgb(255 255 255 / .04); font-size: .85rem; }
    .fc-md-goals li > b:first-child { color: var(--fc-accent); font-variant-numeric: tabular-nums; }
    .fc-md-goals .fc-avatar { width: 1.7rem; height: 1.7rem; font-size: .55rem; box-shadow: none; }
    .fc-md-goals li > span:nth-child(3) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 700; }
    .fc-md-goals small { color: var(--fc-muted); font-variant-numeric: tabular-nums; }
    .fc-md-goals .score { font-weight: 900; font-variant-numeric: tabular-nums; }
    .fc-md-empty { padding: 1.25rem; border-radius: 1rem; border: 1px dashed var(--fc-line); text-align: center; font-size: .85rem; color: var(--fc-muted); }
    /* Ficha del jugador */
    .fc-row { cursor: pointer; -webkit-tap-highlight-color: transparent; transition: background .15s ease; }
    .fc-row:active { background: rgb(255 255 255 / .05); }
    .fc-row:focus-visible { outline: 2px solid var(--fc-accent); outline-offset: -2px; }
    #pd-head .fc-form { display: flex; justify-content: flex-start; margin-top: .4rem; }
    .fc-pd-name { font-size: 1.5rem; font-weight: 900; line-height: 1.1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .fc-pd-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: .5rem; margin-top: 1rem; }
    .fc-pd-stats > div { display: grid; gap: .1rem; padding: .7rem .3rem; border-radius: 1rem; border: 1px solid var(--fc-line); background: rgb(255 255 255 / .04); text-align: center; }
    .fc-pd-stats b { font-size: 1.25rem; font-weight: 900; font-variant-numeric: tabular-nums; }
    .fc-pd-stats small { font-size: .62rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--fc-muted); }
    .fc-pd-rivals { display: grid; gap: .35rem; }
    .fc-pd-rivals li { display: flex; align-items: center; gap: .6rem; padding: .45rem .6rem; border-radius: .85rem; background: rgb(255 255 255 / .04); font-size: .85rem; }
    .fc-pd-rivals li > b { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .fc-pd-rivals .fc-avatar { width: 1.9rem; height: 1.9rem; font-size: .6rem; box-shadow: none; }
    .fc-pd-rivals small { color: var(--fc-muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
    .fc-pd-matches { display: grid; gap: .45rem; }
    .fc-pd-match {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: .7rem;
      padding: .7rem;
      border-radius: 1rem;
      border: 1px solid var(--fc-line);
      background: rgb(255 255 255 / .03);
    }
    .fc-res { display: grid; place-items: center; width: 1.9rem; height: 1.9rem; border-radius: .55rem; font-size: .75rem; font-weight: 900; color: #07090a; }
    .fc-res.w { background: var(--fc-win); }
    .fc-res.d { background: var(--fc-draw); }
    .fc-res.l { background: var(--fc-loss); }
    .fc-pd-vs { display: flex; align-items: center; gap: .45rem; min-width: 0; font-weight: 700; }
    .fc-pd-vs span:last-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .fc-pd-vs .fc-avatar { width: 1.6rem; height: 1.6rem; font-size: .55rem; box-shadow: none; }
    .fc-pd-meta { margin-top: .15rem; font-size: .72rem; color: var(--fc-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .fc-pd-score { font-size: 1.35rem; font-weight: 900; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .fc-pd-match .fc-goals { grid-column: 2 / -1; margin: 0; padding-top: .45rem; border-top: 1px solid var(--fc-line); }
    /* Fotos de perfil */
    .fc-avatar.has-photo { background-size: cover; background-position: center; color: transparent; }
    .fc-who .fc-avatar { cursor: pointer; }
    .fc-player-list { display: grid; gap: .5rem; margin-top: 1rem; }
    .fc-player-item { flex-wrap: wrap; }
    .fc-player-team { display: flex; align-items: center; gap: .6rem; width: 100%; font-size: .78rem; font-weight: 700; color: var(--fc-muted); white-space: nowrap; }
    .fc-player-team .fc-input { min-height: 2.5rem; font-size: .95rem; }
    .fc-player-item {
      display: flex;
      align-items: center;
      gap: .75rem;
      padding: .6rem;
      border-radius: 1rem;
      border: 1px solid var(--fc-line);
      background: rgb(255 255 255 / .04);
    }
    .fc-player-item > b { flex: 1; min-width: 0; font-size: 1rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .fc-player-item .fc-btn { min-height: 2.5rem; padding: 0 .85rem; font-size: .85rem; }
    .fc-player-item .fc-avatar.busy { animation: fc-pulse 1s ease-in-out infinite; }
    @keyframes fc-pulse { 50% { opacity: .4; } }
    /* Aviso de sincronización */
    .fc-banner {
      display: flex;
      align-items: center;
      gap: .75rem;
      padding: .7rem .7rem .7rem .95rem;
