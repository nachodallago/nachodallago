      transition: transform .1s ease;
    }
    .fc-goal-btn:active { transform: scale(.95); }
    .fc-undo-btn {
      min-height: 2.5rem;
      padding: 0 1rem;
      border-radius: 999px;
      border: 1px solid var(--fc-line);
      font-size: .78rem;
