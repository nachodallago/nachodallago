    }
    .fc-undo-btn:disabled { opacity: .35; }
    #goal-panel { margin-top: .75rem; padding: .7rem .85rem; }
    #goal-panel .fc-goal-log { margin-top: 0; }
    .fc-options { margin-top: .75rem; border-radius: 1rem; border: 1px solid var(--fc-line); background: rgb(255 255 255 / .03); }
    .fc-options summary {
      display: flex;
      align-items: center;
      min-height: 3rem;
      padding: 0 .9rem;
      font-size: .9rem;
      font-weight: 700;
      list-style: none;
      cursor: pointer;
    }
    .fc-options summary::-webkit-details-marker { display: none; }
    .fc-options summary::after { content: '▾'; margin-left: auto; color: var(--fc-muted); transition: rotate .2s ease; }
    .fc-options[open] summary::after { rotate: 180deg; }
    .fc-options-body { display: grid; gap: .75rem; padding: 0 .9rem 1rem; }
    .fc-options-body .fc-duration { margin-top: 0; }
    /* Reloj de juego */
    .fc-clock-row { display: flex; align-items: center; gap: .4rem; }
    .fc-clock-row[hidden] { display: none; }
    .fc-game-clock {
      margin-right: auto;
      font-family: var(--font-mono);
      font-size: 2rem;
      font-weight: 800;
      font-variant-numeric: tabular-nums;
      letter-spacing: -.02em;
      color: var(--fc-accent);
    }
    .fc-game-clock.paused { color: var(--fc-muted); animation: fc-pulse 1.4s ease-in-out infinite; }
    .fc-clock-btn {
      min-width: 2.75rem;
      height: 2.5rem;
      padding: 0 .6rem;
      border-radius: 999px;
      border: 1px solid var(--fc-line);
      background: rgb(255 255 255 / .06);
      font-size: .8rem;
      font-weight: 800;
      font-variant-numeric: tabular-nums;
      touch-action: manipulation;
    }
    .fc-clock-main { background: var(--fc-accent); border-color: var(--fc-accent); color: #07090a; padding: 0 .9rem; }
    .fc-duration { display: flex; flex-wrap: wrap; align-items: center; gap: .3rem; margin-top: .6rem; font-size: .75rem; color: var(--fc-muted); }
    .fc-duration button {
      min-width: 2.25rem;
      height: 2rem;
      border-radius: 999px;
      border: 1px solid var(--fc-line);
      font-weight: 700;
      color: var(--fc-muted);
      touch-action: manipulation;
    }
    .fc-duration button[aria-checked='true'] { border-color: var(--fc-accent); color: #fff; background: color-mix(in oklab, var(--fc-accent) 14%, transparent); }
    .fc-clock { font-size: .8rem; font-weight: 700; color: var(--fc-accent); font-variant-numeric: tabular-nums; }
    .fc-goal-log { display: grid; gap: .4rem; margin-top: .6rem; }
    .fc-goal-log li { display: flex; align-items: center; gap: .5rem; font-size: .85rem; min-width: 0; }
    .fc-goal-log li.away { flex-direction: row-reverse; text-align: right; }
    .fc-goal-log b { min-width: 2.25rem; color: var(--fc-accent); font-variant-numeric: tabular-nums; }
    .fc-goal-log span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
    .fc-goal-log small { color: var(--fc-muted); font-variant-numeric: tabular-nums; }
    .fc-goal-log i { width: .6rem; height: .6rem; border-radius: 999px; background: var(--c, #71717a); flex-shrink: 0; }

    /* Goles en la tarjeta del partido */
    .fc-goals {
      grid-column: 1 / -1;
      display: flex;
      flex-wrap: wrap;
      gap: .3rem;
      margin-right: -1.5rem;
      padding-top: .65rem;
      border-top: 1px solid var(--fc-line);
    }
    .fc-goals:empty { display: none; }
    .fc-goals li {
      display: inline-flex;
      align-items: center;
      gap: .3rem;
      padding: .2rem .55rem;
      border-radius: 999px;
      background: rgb(255 255 255 / .06);
      font-size: .72rem;
      font-weight: 600;
    }
    .fc-goals li::before { content: ''; width: .5rem; height: .5rem; border-radius: 999px; background: var(--c, #71717a); }
    .fc-goals b { font-variant-numeric: tabular-nums; }
    .fc-goals small { color: var(--fc-muted); font-variant-numeric: tabular-nums; }
    .fc-stepper {
      display: grid;
      grid-template-columns: 2.75rem 1fr 2.75rem;
      align-items: center;
      gap: .25rem;
      padding: .25rem;
      border-radius: 999px;
      background: rgb(255 255 255 / .05);
      border: 1px solid var(--fc-line);
    }
    .fc-stepper button {
      height: 2.75rem;
      border-radius: 999px;
      background: rgb(255 255 255 / .08);
      font-size: 1.4rem;
      font-weight: 700;
      line-height: 1;
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
    }
    .fc-stepper button:active { background: var(--fc-accent); color: #07090a; }
    .fc-stepper input {
      width: 100%;
      min-width: 0;
      background: transparent;
      text-align: center;
      font-size: 1.5rem;
      font-weight: 900;
      font-variant-numeric: tabular-nums;
      color: #fff;
      -moz-appearance: textfield;
    }
    .fc-stepper input::-webkit-inner-spin-button, .fc-stepper input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
    .fc-stepper input:focus { outline: none; color: var(--fc-accent); }
    /* Toast */
    .fc-toast {
      position: fixed;
      left: 50%;
      top: calc(4.5rem + env(safe-area-inset-top));
      z-index: 60;
      max-width: calc(100vw - 2rem);
      padding: .7rem 1.1rem;
      border-radius: 999px;
      background: rgb(24 26 28 / .95);
      border: 1px solid color-mix(in oklab, var(--fc-accent) 45%, transparent);
      color: #fff;
      font-size: .9rem;
      font-weight: 700;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      box-shadow: 0 12px 40px rgb(0 0 0 / .5);
      translate: -50% -1rem;
      opacity: 0;
      pointer-events: none;
      transition: opacity .2s ease, translate .3s var(--ease-out);
    }
    .fc-toast.show { opacity: 1; translate: -50% 0; }
    /* Pantallas más grandes */
    @media (min-width: 30rem) {
      .fc-picks { grid-template-columns: 1fr 1fr; }
    }
    @media (min-width: 40rem) {
      .fc-standings-head, .fc-row { grid-template-columns: 1.5rem minmax(0, 1fr) 7rem 2.25rem 2.5rem 2.5rem 2.5rem; gap: .5rem; }
      .fc-form-col, .fc-row > .fc-form { display: flex; }
      .fc-form-col { justify-content: center; }
      .fc-who .fc-form { display: none; }
      .fc-match { padding-inline: 1.25rem 2.75rem; }
      .fc-match-side { flex-direction: row; justify-content: flex-end; text-align: right; }
      .fc-match-side > div { width: auto; }
      .fc-match-side .fc-avatar { order: 2; }
      .fc-match-away { justify-content: flex-start; text-align: left; }
      .fc-match-away .fc-avatar { order: 0; }
    }
    @media (min-width: 48rem) {
      .fc-logo { height: 3rem; }
      .fc-sheet {
        inset: 0;
        margin: auto;
        width: min(34rem, calc(100vw - 2rem));
        max-height: 90dvh;
        padding: 1.5rem;
        border-bottom: 1px solid var(--fc-line);
        border-radius: 1.75rem;
        translate: 0 0;
        opacity: 0;
        scale: .96;
        transition: opacity .25s ease, scale .3s var(--ease-out), display .3s allow-discrete, overlay .3s allow-discrete;
      }
      .fc-sheet[open] { opacity: 1; scale: 1; }
      @starting-style { .fc-sheet[open] { opacity: 0; scale: .96; } }
      .fc-sheet-sm { width: min(24rem, calc(100vw - 2rem)); }
      .fc-grabber { display: none; }
      .fc-menu { inset: 4.5rem max(1rem, calc(50vw - 24rem + 1rem)) auto auto; }
      .fc-toast { top: auto; bottom: 2rem; translate: -50% 1rem; }
    }
    @media (hover: hover) {
      .fc-btn-primary:hover { box-shadow: 0 0 28px color-mix(in oklab, var(--fc-accent) 40%, transparent); }
      .fc-icon-btn:hover, .fc-btn-ghost:hover { background: rgb(255 255 255 / .12); }
      .fc-menu-item:hover { background: rgb(255 255 255 / .08); }
      .fc-delete:hover { color: #f87171; background: rgb(239 68 68 / .12); }
      .fc-picks label:hover > span { border-color: rgb(255 255 255 / .25); }
    }
    @media (prefers-reduced-motion: reduce) {
      .fc-sheet, .fc-menu, .fc-toast { transition: none; }
    }
  }
</style>

<script>
  type Match = {
    id: string;
    date: string;
    homePlayer: string;
    homeTeam: string;
    homeGoals: number;
    awayPlayer: string;
    awayTeam: string;
    awayGoals: number;
    // Cada gol con el momento en que se cargó (ms) y el arranque del partido
    goals?: Goal[];
    startedAt?: number;
    tournamentId?: string;
  };
  type Tournament = { id: string; name: string; createdAt: number };
  // min: minuto del juego en que entró (los goles viejos no lo tienen: se usa el tiempo real)
  type Goal = { side: 'home' | 'away'; at: number; min?: number };

  const KEY = 'fc26-matches';
  // Partido a medio cargar: sobrevive a recargar la página
  const DRAFT_KEY = 'fc26-draft';
  // Equipos usados: quedan para elegirlos de nuevo aunque se borren partidos
  const TEAMS_KEY = 'fc26-teams';
  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;

  const form = $<HTMLFormElement>('#match-form');
  const sheet = $<HTMLDialogElement>('#sheet');
  const confirmDialog = $<HTMLDialogElement>('#confirm');
  const formError = $('#form-error');
  const matchesEl = $('#matches');
  const matchesEmpty = $('#matches-empty');
  const standingsEl = $('#standings');
  const tpl = $<HTMLTemplateElement>('#match-tpl');
  const toast = $('#toast');

  // Jugadores y colores salen del formulario (una sola fuente: el frontmatter)
  const colors = new Map(
    [...form.querySelectorAll<HTMLInputElement>('[name=homePlayer]')].map((i) => [i.value, i.dataset.color!]),
  );
  const roster = [...colors.keys()];

  const initials = (name: string) => {
    const words = name.trim().split(/\s+/);
    return (words.length > 1 ? words[0][0] + words[1][0] : name.slice(0, 2)).toUpperCase();
  };

  function avatar(el: HTMLElement, name: string) {
    el.dataset.player = name;
    el.textContent = initials(name);
    el.style.setProperty('--c', colors.get(name) ?? '#71717a');
    const v = photos[name];
    el.classList.toggle('has-photo', Boolean(v));
    el.style.backgroundImage = v ? `url("${API}/photos/${encodeURIComponent(name)}?v=${v}")` : '';
  }

  // Animación al reordenar (View Transitions), si el navegador la soporta
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
  // Con el tiempo real pueden llegar dos cambios seguidos: si ya hay una animación, se aplica directo
  let transitioning = false;
  function update(fn: () => void) {
    if (!document.startViewTransition || reduceMotion.matches || transitioning) return fn();
    transitioning = true;
    const t = document.startViewTransition(fn);
    t.finished.catch(() => {}).finally(() => (transitioning = false));
    t.ready.catch(() => {});
  }

  let toastTimer = 0;
  function notify(msg: string) {
    toast.textContent = msg;
    toast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toast.classList.remove('show'), 2400);
  }

  // --- Datos: la DB del servidor manda; el navegador guarda una copia ---
  const API = '/api/fc26';
  const CACHE_KEY = 'fc26-cache'; // última copia de la DB, para verla sin conexión
  const PIN_KEY = 'fc26-pin';
  // KEY ('fc26-matches'): partidos guardados solo en este navegador, pendientes de subir

  function loadKey(key: string): Match[] {
    try {
      const data = JSON.parse(localStorage.getItem(key) ?? '[]');
      return Array.isArray(data) ? data.filter(isMatch) : [];
    } catch {
      return [];
    }
  }

  function storeKey(key: string, list: Match[]) {
    try {
      localStorage.setItem(key, JSON.stringify(list));
    } catch {
      // Sin storage (modo privado): los datos viven solo mientras la pestaña esté abierta
    }
  }

  function isMatch(m: any): m is Match {
    return (
      m && typeof m.id === 'string' && typeof m.date === 'string' &&
      typeof m.homePlayer === 'string' && typeof m.awayPlayer === 'string' &&
      Number.isInteger(m.homeGoals) && Number.isInteger(m.awayGoals)
    );
  }

  // Fotos de perfil: { jugador: versión }; copia local para verlas sin conexión
  const PHOTOS_KEY = 'fc26-photos';
  let photos: Record<string, number> = (() => {
    try {
      const data = JSON.parse(localStorage.getItem(PHOTOS_KEY) ?? '{}');
      return data && typeof data === 'object' && !Array.isArray(data) ? data : {};
    } catch {
      return {};
    }
  })();

  function setPhotos(next: unknown) {
    if (!next || typeof next !== 'object' || Array.isArray(next)) return;
    photos = Object.fromEntries(Object.entries(next).filter(([, v]) => Number.isFinite(v))) as Record<string, number>;
    try {
      localStorage.setItem(PHOTOS_KEY, JSON.stringify(photos));
    } catch {}
  }

  let remote = loadKey(CACHE_KEY);
  let localOnly = loadKey(KEY);
  let online = false;
  let canWrite = false;

  // Lo que se ve: la DB + lo que todavía no se subió
  function merged() {
    const ids = new Set(remote.map((m) => m.id));
    return [...remote, ...localOnly.filter((m) => !ids.has(m.id))];
  }
  // --- Equipo de siempre de cada jugador (guardado en el servidor, compartido) ---
  const PLAYER_TEAMS_KEY = 'fc26-player-teams';
  let playerTeams: Record<string, string> = (() => {
    try {
      const data = JSON.parse(localStorage.getItem(PLAYER_TEAMS_KEY) ?? '{}');
      return data && typeof data === 'object' && !Array.isArray(data) ? data : {};
    } catch {
      return {};
    }
  })();
  function setPlayerTeams(next: unknown) {
    if (!next || typeof next !== 'object' || Array.isArray(next)) return;
    playerTeams = Object.fromEntries(Object.entries(next).filter(([, v]) => typeof v === 'string' && v)) as Record<string, string>;
    try {
      localStorage.setItem(PLAYER_TEAMS_KEY, JSON.stringify(playerTeams));
    } catch {}
  }

  // --- Torneos: cuál se está viendo ('all' = todos, 'none' = sin torneo, o el id) ---
  const TOURNAMENTS_KEY = 'fc26-tournaments';
  const VIEW_KEY = 'fc26-tournament';
  let tournaments: Tournament[] = (() => {
    try {
      const data = JSON.parse(localStorage.getItem(TOURNAMENTS_KEY) ?? '[]');
      return Array.isArray(data) ? data.filter((t) => t && typeof t.id === 'string') : [];
    } catch {
      return [];
    }
  })();
  let view = (() => {
    try {
      return localStorage.getItem(VIEW_KEY) || 'all';
    } catch {
      return 'all';
    }
  })();

  function setTournaments(list: unknown) {
    if (!Array.isArray(list)) return;
    tournaments = list.filter((t) => t && typeof t.id === 'string' && typeof t.name === 'string');
    try {
      localStorage.setItem(TOURNAMENTS_KEY, JSON.stringify(tournaments));
    } catch {}
    // Si borraron el torneo que se estaba viendo, se vuelve a "todos"
    if (view !== 'all' && view !== 'none' && !tournaments.some((t) => t.id === view)) setView('all');
  }

  function setView(v: string) {
    view = v;
    try {
      localStorage.setItem(VIEW_KEY, v);
    } catch {}
  }

  const tournamentName = (id?: string) => tournaments.find((t) => t.id === id)?.name;
  const inView = (m: Match) =>
    view === 'all' ? true : view === 'none' ? !m.tournamentId || !tournamentName(m.tournamentId) : m.tournamentId === view;

  // allMatches: todos; matches: los del torneo que se está viendo (de acá sale todo lo que se muestra)
  let allMatches = merged();
  let matches = allMatches.filter(inView);

  function setRemote(list: unknown) {
    remote = (Array.isArray(list) ? list : []).filter(isMatch);
    storeKey(CACHE_KEY, remote);
    // Los pendientes que ya están en la DB dejan de estar pendientes
    const ids = new Set(remote.map((m) => m.id));
    const pending = localOnly.filter((m) => !ids.has(m.id));
    if (pending.length !== localOnly.length) {
      localOnly = pending;
      storeKey(KEY, localOnly);
    }
  }

  function refresh() {
    // Los datos se recalculan ya (no dentro de la animación, que corre un instante después)
    allMatches = merged();
    matches = allMatches.filter(inView);
    update(() => {
      render();
      renderTournamentBar();
      paintPicks();
      renderLive();
    });
    renderSync();
    if (playersDialog.open) renderPlayers();
    if (detailDialog.open) renderPlayerDetail();
    if (matchDialog.open) renderMatchDetail();
  }

  // Los avatares de los botones de jugador del formulario también llevan la foto
  function paintPicks() {
    form.querySelectorAll<HTMLInputElement>('.fc-picks input').forEach((i) => {
      const el = i.nextElementSibling?.querySelector<HTMLElement>('.fc-avatar');
      if (el) avatar(el, i.value);
    });
    form.querySelectorAll<HTMLElement>('[data-preview]').forEach((el) => {
      const picked = form.querySelector<HTMLInputElement>(`[name=${el.dataset.preview}Player]:checked`)?.value;
      if (picked) avatar(el, picked);
    });
  }

  // --- PIN: se pide al entrar; el servidor deja la sesión en una cookie ---
  const pinDialog = $<HTMLDialogElement>('#pin-dialog');
  const pinForm = $<HTMLFormElement>('#pin-form');
  const pinInput = $<HTMLInputElement>('#pin-input');
  const pinError = $('#pin-error');
  const app = $('.fc');
  let pinResolve: ((ok: boolean) => void) | null = null;
  let locked = false;

  // PIN guardado por versiones anteriores: se usa una vez para abrir la sesión y se borra
  function takeLegacyPin() {
    try {
      const pin = localStorage.getItem(PIN_KEY);
      localStorage.removeItem(PIN_KEY);
      return pin;
    } catch {
      return null;
    }
  }

  // gate: al entrar no se puede cancelar
  function askPin(message = '', gate = false): Promise<boolean> {
    pinDialog.classList.toggle('fc-pin-gate', gate);
    $('#pin-title').textContent = gate ? 'Ingresá el PIN para entrar' : 'Ingresá el PIN';
    pinError.textContent = message;
    pinInput.value = '';
    if (!pinDialog.open) pinDialog.showModal();
    pinInput.focus();
    return new Promise((ok) => (pinResolve = ok));
  }

  async function login(pin: string) {
    const res = await fetch(`${API}/pin`, { method: 'POST', headers: { 'x-fc26-pin': pin } });
    const data = await res.json().catch(() => ({}));
    return res.ok ? null : data.error || 'No se pudo validar el PIN';
  }

  pinForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const pin = pinInput.value.trim();
    if (!pin) return;
    const btn = pinForm.querySelector<HTMLButtonElement>('[type=submit]')!;
    btn.disabled = true;
    try {
      const error = await login(pin);
      if (error) {
        pinError.textContent = error;
        return;
      }
      const done = pinResolve;
      pinResolve = null;
      pinDialog.close();
      done?.(true);
    } catch {
      pinError.textContent = 'Sin conexión con el servidor';
    } finally {
      btn.disabled = false;
    }
  });
  pinForm.querySelector('[data-cancel]')!.addEventListener('click', () => pinDialog.close());
  // En la pantalla de entrada, Escape no cierra
  pinDialog.addEventListener('cancel', (e) => {
    if (pinDialog.classList.contains('fc-pin-gate')) e.preventDefault();
  });
  pinDialog.addEventListener('close', () => {
    pinResolve?.(false);
    pinResolve = null;
  });

  async function lock() {
    if (locked) return;
    locked = true;
    disconnectStream();
    app.classList.add('fc-locked');
    for (const d of [sheet, confirmDialog, playersDialog, cropDialog, viewer, detailDialog, matchDialog, tournamentsDialog, teditDialog])
      if (d.open) d.close();
    renderSync();
    if (await askPin('', true)) {
      locked = false;
      app.classList.remove('fc-locked');
      sync();
    }
  }

  async function logout() {
    $('#fc-menu').hidePopover();
    await fetch(`${API}/pin`, { method: 'DELETE' }).catch(() => {});
    // Lo que se bajó del servidor no queda a la vista en este celu
    for (const k of [CACHE_KEY, PHOTOS_KEY]) {
      try {
        localStorage.removeItem(k);
      } catch {}
    }
    remote = [];
    photos = {};
    liveList = [];
    refresh();
    lock();
  }

  async function sync() {
    try {
      let res = await fetch(`${API}/matches`, { cache: 'no-store' });
      const legacy = res.status === 401 ? takeLegacyPin() : null;
      if (legacy && !(await login(legacy))) res = await fetch(`${API}/matches`, { cache: 'no-store' });
      online = true;
      if (res.status === 401) {
        lock();
        return;
      }
      if (!res.ok) throw new Error(String(res.status));
      const data = await res.json();
      canWrite = Boolean(data.canWrite);
      setRemote(data.matches);
      setPhotos(data.photos);
      setTournaments(data.tournaments);
      setPlayerTeams(data.playerTeams);
      setLive(data.live);
      connectStream();
    } catch {
      online = false;
    }
    refresh();
  }

  class Cancelled extends Error {}

  // Escritura en la API con la sesión; si venció, pide el PIN y reintenta
  async function write(method: 'POST' | 'PUT' | 'DELETE', path: string, body?: unknown) {
    let message = '';
    for (let attempt = 0; attempt < 3; attempt++) {
      const isFile = body instanceof Blob;
      const res = await fetch(`${API}${path}`, {
        method,
        headers: { 'content-type': isFile ? body.type : 'application/json' },
        body: body === undefined ? undefined : isFile ? body : JSON.stringify(body),
      });
      const data = await res.json().catch(() => ({}));
      if (res.status === 401) {
        if (!(await askPin(message))) throw new Cancelled();
        message = '';
        continue;
      }
      if (!res.ok) throw new Error(data.error || 'Error del servidor');
      if ('matches' in data) setRemote(data.matches);
      if ('photos' in data) setPhotos(data.photos);
      if ('tournaments' in data) setTournaments(data.tournaments);
      if ('playerTeams' in data) setPlayerTeams(data.playerTeams);
      if ('live' in data) setLive(data.live);
      return data;
    }
    throw new Error('PIN incorrecto');
  }

  const errorText = (e: unknown) =>
    e instanceof TypeError ? 'Sin conexión con el servidor' : (e as Error).message || 'No se pudo guardar';

  function renderSync() {
    const banner = $('#sync-banner');
    const upload = $('#sync-upload');
    let msg = '';
    if (locked) msg = '';
    else if (!online) msg = remote.length || localOnly.length ? 'Sin conexión con el servidor: mostrando lo último guardado en este celu.' : '';
    else if (!canWrite) msg = 'El servidor todavía no tiene PIN configurado: lo que cargues queda en este celu.';
    else if (localOnly.length) msg = `Hay ${localOnly.length} partido(s) guardados solo en este celu.`;
    banner.hidden = !msg;
    $('#sync-text').textContent = msg;
    upload.hidden = !(online && canWrite && localOnly.length);
    $('#forget-pin').hidden = !(online && canWrite && !locked);
    $('#menu-note').textContent = online && canWrite
      ? 'Los resultados se guardan en el servidor: todos ven la misma tabla.'
      : 'Sin conexión con el servidor: lo que cargues queda en este celu y después lo podés subir.';
  }

  $('#sync-upload').addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    btn.disabled = true;
    try {
      const n = localOnly.length;
      await write('POST', '/matches', localOnly);
      refresh();
      notify(`Se subieron ${n} partido(s)`);
    } catch (err) {
      if (!(err instanceof Cancelled)) notify(errorText(err));
    } finally {
      btn.disabled = false;
    }
  });

  $('#forget-pin').addEventListener('click', logout);

  // --- En vivo: partidos que alguien está cargando ahora ---
  type Live = {
    id: string;
    homePlayer?: string;
    awayPlayer?: string;
    homeTeam?: string;
    awayTeam?: string;
    homeGoals?: number;
    awayGoals?: number;
    startedAt?: number | null;
    duration?: number;
    pausedMs?: number;
    pausedAt?: number | null;
    goals?: Goal[];
  };
  let liveList: Live[] = [];
  const liveScores = new Map<string, string>();

  function setLive(list: unknown) {
    liveList = (Array.isArray(list) ? list : []).filter((l) => l && typeof l.id === 'string');
  }

  const liveClockText = (c: Clock) =>
    !c.startedAt ? 'Por empezar' : `${c.pausedAt ? '⏸' : '⏱'} ${fmtGame(gameSeconds(c))}`;

  function goalChip(g: Goal, start: number, player: string) {
    const chip = document.createElement('li');
    chip.style.setProperty('--c', colors.get(player) ?? '#71717a');
    const min = document.createElement('b');
    min.textContent = goalLabel(g, start);
    const time = document.createElement('small');
    time.textContent = clockFmt.format(g.at);
    chip.append(min, ` ${player} `, time);
    return chip;
  }

  // --- Festejo de gol: mini zoom del número + pelota al arco + confeti ---
  const fx = $('#goal-fx');
  const confettiCanvas = $<HTMLCanvasElement>('#confetti');
  const fxColors = ['#c4ff4d', '#5ee7ff', '#b69cff', '#ff9354', '#ffffff', '#facc15'];
  let fxTimer = 0;
  let fxFrame = 0;

  function pop(el: Element | null | undefined) {
    if (!el) return;
    el.classList.remove('fc-pop');
    void (el as HTMLElement).offsetWidth; // reinicia la animación si ya estaba
    el.classList.add('fc-pop');
  }

  function confetti() {
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    const w = innerWidth;
    const h = innerHeight;
    confettiCanvas.width = w * dpr;
    confettiCanvas.height = h * dpr;
    const ctx = confettiCanvas.getContext('2d')!;
    ctx.scale(dpr, dpr);
    // Dos cañones desde las esquinas de abajo, apuntando hacia el centro
    const parts = Array.from({ length: 160 }, (_, i) => {
      const left = i % 2 === 0;
      const angle = (left ? -60 : -120) * (Math.PI / 180) + (Math.random() - 0.5) * 0.9;
      const speed = 9 + Math.random() * 9;
      return {
        x: left ? 0 : w,
        y: h,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed * 1.25,
        size: 5 + Math.random() * 6,
        rot: Math.random() * Math.PI,
        vr: (Math.random() - 0.5) * 0.35,
        color: fxColors[i % fxColors.length],
        round: Math.random() < 0.3,
      };
    });
    const start = performance.now();
    cancelAnimationFrame(fxFrame);
    const frame = (now: number) => {
      const t = now - start;
      ctx.clearRect(0, 0, w, h);
      for (const p of parts) {
        p.vy += 0.32; // gravedad
        p.vx *= 0.99;
        p.x += p.vx;
        p.y += p.vy;
        p.rot += p.vr;
        ctx.save();
        ctx.globalAlpha = Math.max(0, 1 - t / 2600);
        ctx.translate(p.x, p.y);
        ctx.rotate(p.rot);
        ctx.fillStyle = p.color;
        if (p.round) {
          ctx.beginPath();
          ctx.arc(0, 0, p.size / 2, 0, Math.PI * 2);
          ctx.fill();
        } else ctx.fillRect(-p.size / 2, -p.size / 4, p.size, p.size / 2);
        ctx.restore();
      }
      if (t < 2600) fxFrame = requestAnimationFrame(frame);
      else ctx.clearRect(0, 0, w, h);
    };
    fxFrame = requestAnimationFrame(frame);
  }

  // --- Sonido de gol: grito del relator + hinchada (public/fc26/gol-grito-8s.mp3: 8 s desde el grito, con fade out) ---
  // Con <audio> (y no Web Audio) en iPhone suena aunque el celu esté en silencio
  const goalAudio = new Audio('/fc26/gol-grito-8s.mp3');
  goalAudio.preload = 'auto';
  let audioUnlocked = false;
  let goalPlaying = false;
  let soundOn = (() => {
    try {
      return localStorage.getItem('fc26-sound') !== 'off';
    } catch {
      return true;
    }
  })();

  function renderSoundToggle() {
    const btn = $('#sound-toggle');
    btn.setAttribute('aria-pressed', String(soundOn));
    btn.setAttribute('aria-label', soundOn ? 'Silenciar el sonido de gol' : 'Activar el sonido de gol');
    btn.querySelector<SVGElement>('[data-sound=on]')!.classList.toggle('hidden', !soundOn);
    btn.querySelector<SVGElement>('[data-sound=off]')!.classList.toggle('hidden', soundOn);
  }

  // Los celus solo dejan sonar después de un toque: el primero "destraba" el audio
  // (se reproduce en silencio y se frena, salvo que justo ese toque haya sido un gol)
  function unlockAudio() {
    if (audioUnlocked) return;
    audioUnlocked = true;
    goalAudio.muted = true;
    goalAudio
      .play()
      .then(() => {
        if (goalPlaying) return;
        goalAudio.pause();
        goalAudio.currentTime = 0;
      })
      .catch(() => (audioUnlocked = false))
      .finally(() => (goalAudio.muted = false));
  }
  document.addEventListener('pointerdown', unlockAudio, { capture: true });
  goalAudio.addEventListener('ended', () => (goalPlaying = false));

  $('#sound-toggle').addEventListener('click', () => {
    soundOn = !soundOn;
    try {
      localStorage.setItem('fc26-sound', soundOn ? 'on' : 'off');
    } catch {}
    if (!soundOn) {
      goalAudio.pause();
      goalPlaying = false;
    }
    renderSoundToggle();
    notify(soundOn ? '🔊 Sonido de gol activado' : '🔇 Sonido de gol apagado');
  });

  function goalSound() {
    if (!soundOn) return;
    goalPlaying = true;
    goalAudio.muted = false;
    // Otro gol mientras suena: arranca de nuevo
    goalAudio.currentTime = 0;
    goalAudio.play().catch(() => (goalPlaying = false));
  }

  function celebrate(scoreEl?: Element | null) {
    pop(scoreEl);
    goalSound();
    if (reduceMotion.matches) return;
    // Se muestra arriba de todo (también de los paneles abiertos) y las animaciones arrancan de cero
    if (fx.matches(':popover-open')) fx.hidePopover();
    const goal = fx.querySelector<HTMLElement>('.fc-fx-goal')!;
    goal.replaceWith(goal.cloneNode(true));
    fx.showPopover();
    confetti();
    clearTimeout(fxTimer);
    fxTimer = window.setTimeout(() => fx.hidePopover(), 2700);
  }

  function renderLive() {
    const seen = new Set<string>();
    const goalsToCelebrate: Element[] = [];
    $('#live-list').replaceChildren(
      ...liveList.map((l) => {
        seen.add(l.id);
        const card = document.createElement('article');
        card.className = 'fc-card fc-live';
        const head = document.createElement('div');
        head.className = 'fc-live-head';
        const badge = document.createElement('span');
        badge.className = 'fc-live-badge';
        badge.append(document.createElement('i'), 'En vivo');
        const clock = document.createElement('span');
        clock.className = 'fc-clock';
        clock.dataset.clock = JSON.stringify({ startedAt: l.startedAt, duration: l.duration, pausedMs: l.pausedMs, pausedAt: l.pausedAt });
        clock.textContent = liveClockText(l);
        head.append(badge, clock);

        const side = (player = '', team = '') => {
          const d = document.createElement('div');
          d.className = 'fc-live-side';
          const av = document.createElement('span');
          av.className = 'fc-avatar fc-avatar-lg';
          if (player) avatar(av, player);
          else av.textContent = '?';
          const name = document.createElement('b');
          name.textContent = player || 'Por elegir';
          const t = document.createElement('small');
          t.textContent = team || '—';
          d.append(av, name, t);
          return d;
        };
        const score = document.createElement('p');
        const hg = document.createElement('span');
        hg.textContent = String(l.homeGoals ?? 0);
        const sep = document.createElement('i');
        sep.textContent = ':';
        const ag = document.createElement('span');
        ag.textContent = String(l.awayGoals ?? 0);
        score.append(hg, sep, ag);
        const row = document.createElement('div');
        row.className = 'fc-live-score';
        row.append(side(l.homePlayer, l.homeTeam), score, side(l.awayPlayer, l.awayTeam));

        const list = document.createElement('ol');
        list.className = 'fc-goals';
        const start = l.startedAt || l.goals?.[0]?.at || Date.now();
        list.append(
          ...(l.goals ?? []).map((g) =>
            goalChip(g, start, (g.side === 'home' ? l.homePlayer : l.awayPlayer) || (g.side === 'home' ? 'Local' : 'Visitante')),
          ),
        );
        card.append(head, row, list);

        // Gol nuevo: la tarjeta destella y se festeja (el que lo carga ya festejó al tocar +)
        const key = `${l.homeGoals ?? 0}-${l.awayGoals ?? 0}`;
        const prev = liveScores.get(l.id);
        if (prev !== undefined && prev !== key) {
          card.classList.add('fc-live-flash');
          const [ph, pa] = prev.split('-').map(Number);
          const scored = (l.homeGoals ?? 0) > ph ? hg : (l.awayGoals ?? 0) > pa ? ag : null;
          if (scored && l.id !== liveId) goalsToCelebrate.push(scored);
        }
        liveScores.set(l.id, key);
        return card;
      }),
    );
    for (const el of goalsToCelebrate) celebrate(el);
    for (const id of [...liveScores.keys()]) if (!seen.has(id)) liveScores.delete(id);
  }

  function applyLive(list: unknown) {
    const before = liveList.map((l) => l.id);
    setLive(list);
    renderLive();
    // Un partido dejó de estar en vivo: seguramente se guardó, se trae la tabla nueva
    if (before.some((id) => !liveList.some((l) => l.id === id))) sync();
  }

  // --- Tiempo real: el servidor empuja cada cambio (Server-Sent Events) ---
  let stream: EventSource | null = null;
  let streaming = false;
  let changedTimer = 0;

  function connectStream() {
    if (stream || locked || !('EventSource' in window)) return;
    const es = new EventSource(`${API}/events`);
    stream = es;
    es.addEventListener('open', () => (streaming = true));
    es.addEventListener('live', (e) => {
      try {
        applyLive(JSON.parse((e as MessageEvent).data).live);
      } catch {}
    });
    // Cambió la tabla, un partido o una foto: se pide todo de nuevo (agrupando ráfagas)
    es.addEventListener('changed', () => {
      clearTimeout(changedTimer);
      changedTimer = window.setTimeout(sync, 150);
    });
    es.addEventListener('error', () => {
      streaming = false;
      // Si el navegador no va a reintentar solo (p. ej. 401), se reintenta en un rato
      if (es.readyState === EventSource.CLOSED) {
        stream = null;
        setTimeout(connectStream, 5000);
      }
    });
  }

  function disconnectStream() {
    stream?.close();
    stream = null;
    streaming = false;
  }

  // Respaldo si el stream no está conectado: se consulta cada 4 s
  async function pollLive() {
    if (streaming || document.visibilityState !== 'visible' || locked || !online) return;
    try {
      const res = await fetch(`${API}/live`, { cache: 'no-store' });
      if (res.status === 401) return lock();
      if (res.ok) applyLive((await res.json()).live);
    } catch {}
  }
  setInterval(pollLive, 4000);

  // --- Fotos de los jugadores ---
  const playersDialog = $<HTMLDialogElement>('#players-dialog');
  const photoInput = $<HTMLInputElement>('#photo-input');
  let photoFor: string | null = null;
  let busyPlayer: string | null = null;

  function renderPlayers() {
    const ready = online && canWrite;
    $('#players-note').textContent = ready
      ? 'Foto de perfil y el equipo con el que juega cada uno (se elige solo al armar un partido).'
      : 'Para cambiar fotos o equipos hace falta conexión con el servidor.';
    $('#players-list').replaceChildren(
      ...roster.map((name) => {
        const li = document.createElement('li');
        li.className = 'fc-player-item';
        const av = document.createElement('span');
        av.className = 'fc-avatar fc-avatar-lg';
        avatar(av, name);
        av.classList.toggle('busy', busyPlayer === name);
        const label = document.createElement('b');
        label.textContent = name;
        const upload = document.createElement('button');
        upload.type = 'button';
        upload.className = 'fc-btn fc-btn-primary';
        upload.textContent = photos[name] ? 'Cambiar' : 'Subir foto';
        upload.disabled = !ready || busyPlayer !== null;
        upload.addEventListener('click', () => {
          photoFor = name;
          photoInput.value = '';
          photoInput.click();
        });
        li.append(av, label, upload);
        // Equipo de siempre: se elige solo al armar un partido
        const team = document.createElement('label');
        team.className = 'fc-player-team';
        const tl = document.createElement('span');
        tl.textContent = '🛡 Equipo';
        const ti = document.createElement('input');
        ti.className = 'fc-input';
        ti.maxLength = 40;
        ti.placeholder = 'Ej: Real Madrid';
        ti.value = playerTeams[name] ?? '';
        ti.disabled = !ready;
        ti.setAttribute('list', 'teams');
        ti.setAttribute('autocapitalize', 'words');
        ti.addEventListener('change', async () => {
          try {
            await write('PUT', `/players/${encodeURIComponent(name)}/team`, { team: ti.value.trim() });
            notify(ti.value.trim() ? `🛡 ${name} juega con ${ti.value.trim()}` : `${name} sin equipo fijo`);
          } catch (err) {
            if (!(err instanceof Cancelled)) notify(errorText(err));
          }
        });
        team.append(tl, ti);
        if (photos[name]) {
          const remove = document.createElement('button');
          remove.type = 'button';
          remove.className = 'fc-btn fc-btn-ghost';
          remove.textContent = 'Quitar';
          remove.setAttribute('aria-label', `Quitar foto de ${name}`);
          remove.disabled = !ready || busyPlayer !== null;
          remove.addEventListener('click', () => changePhoto(name, null));
          li.append(remove);
        }
        li.append(team);
        return li;
      }),
    );
  }

  function openPlayers() {
    $('#fc-menu').hidePopover?.();
    renderPlayers();
    playersDialog.showModal();
  }

  // --- Editor de recorte: mover con el dedo, zoom con pellizco, barra o rueda ---
  const cropDialog = $<HTMLDialogElement>('#crop-dialog');
  const cropStage = $('#crop-stage');
  const cropImg = $<HTMLImageElement>('#crop-img');
  const cropZoom = $<HTMLInputElement>('#crop-zoom');
  const PHOTO_SIZE = 600; // se guarda en 600×600: se ve nítida también en grande
  const crop = { x: 0, y: 0, zoom: 1, base: 1, w: 0, h: 0, stage: 0 };
  let cropResolve: ((b: Blob | null) => void) | null = null;

  const cropScale = () => crop.base * crop.zoom;
  function clampCrop() {
    // La foto siempre cubre todo el cuadro (no quedan bordes vacíos)
    const s = cropScale();
    crop.x = Math.min(0, Math.max(crop.stage - crop.w * s, crop.x));
    crop.y = Math.min(0, Math.max(crop.stage - crop.h * s, crop.y));
  }
  function drawCrop() {
    clampCrop();
    cropImg.style.transform = `translate(${crop.x}px, ${crop.y}px) scale(${cropScale()})`;
    cropZoom.value = String(crop.zoom);
  }
  // Zoom manteniendo fijo el punto (px, py) del cuadro
  function zoomAt(zoom: number, px = crop.stage / 2, py = crop.stage / 2) {
    const before = cropScale();
    crop.zoom = Math.min(4, Math.max(1, zoom));
    const after = cropScale();
    crop.x = px - ((px - crop.x) / before) * after;
    crop.y = py - ((py - crop.y) / before) * after;
    drawCrop();
  }

  const pointers = new Map<number, { x: number; y: number }>();
  const stagePoint = (e: PointerEvent | WheelEvent) => {
    const r = cropStage.getBoundingClientRect();
    return { x: e.clientX - r.left, y: e.clientY - r.top };
  };
  cropStage.addEventListener('pointerdown', (e) => {
    cropStage.setPointerCapture(e.pointerId);
    pointers.set(e.pointerId, stagePoint(e));
  });
  cropStage.addEventListener('pointermove', (e) => {
    const prev = pointers.get(e.pointerId);
    if (!prev) return;
    const now = stagePoint(e);
    if (pointers.size === 1) {
      crop.x += now.x - prev.x;
      crop.y += now.y - prev.y;
      drawCrop();
    } else if (pointers.size === 2) {
      // Pellizco: el zoom sigue la distancia entre los dos dedos
      const other = [...pointers].find(([id]) => id !== e.pointerId)![1];
      const d0 = Math.hypot(prev.x - other.x, prev.y - other.y);
      const d1 = Math.hypot(now.x - other.x, now.y - other.y);
      if (d0 > 0) zoomAt(crop.zoom * (d1 / d0), (now.x + other.x) / 2, (now.y + other.y) / 2);
    }
    pointers.set(e.pointerId, now);
  });
  for (const type of ['pointerup', 'pointercancel', 'lostpointercapture'] as const) {
    cropStage.addEventListener(type, (e) => pointers.delete(e.pointerId));
  }
  cropStage.addEventListener(
    'wheel',
    (e) => {
      e.preventDefault();
      const p = stagePoint(e);
      zoomAt(crop.zoom * Math.exp(-e.deltaY * 0.0015), p.x, p.y);
    },
    { passive: false },
  );
  cropZoom.addEventListener('input', () => zoomAt(Number(cropZoom.value)));

  async function cropPhoto(file: File): Promise<Blob | null> {
    const url = URL.createObjectURL(file);
    try {
      cropImg.src = url;
      await cropImg.decode();
    } catch {
      URL.revokeObjectURL(url);
      throw new Error('No se pudo leer la foto');
    }
    crop.w = cropImg.naturalWidth;
    crop.h = cropImg.naturalHeight;
    cropDialog.showModal();
    crop.stage = cropStage.getBoundingClientRect().width;
    crop.base = crop.stage / Math.min(crop.w, crop.h);
    crop.zoom = 1;
    // Arranca centrada
    crop.x = (crop.stage - crop.w * crop.base) / 2;
    crop.y = (crop.stage - crop.h * crop.base) / 2;
    drawCrop();
    const blob = await new Promise<Blob | null>((ok) => (cropResolve = ok));
    URL.revokeObjectURL(url);
    return blob;
  }

  async function exportCrop() {
    const s = cropScale();
    const side = crop.stage / s;
    const size = Math.min(PHOTO_SIZE, Math.round(side));
    const canvas = document.createElement('canvas');
    canvas.width = canvas.height = size;
    canvas.getContext('2d')!.drawImage(cropImg, -crop.x / s, -crop.y / s, side, side, 0, 0, size, size);
    const encode = (type: string, q: number) => new Promise<Blob | null>((ok) => canvas.toBlob(ok, type, q));
    // WebP si el navegador lo sabe generar; si no, JPEG
    const webp = await encode('image/webp', 0.85);
    return webp?.type === 'image/webp' ? webp : await encode('image/jpeg', 0.85);
  }

  $('#crop-ok').addEventListener('click', async () => {
    const blob = await exportCrop();
    const done = cropResolve;
    cropResolve = null;
    cropDialog.close();
    done?.(blob);
  });
  $('#crop-cancel').addEventListener('click', () => cropDialog.close());
  cropDialog.addEventListener('close', () => {
    cropResolve?.(null);
    cropResolve = null;
    pointers.clear();
  });

  // --- Visor: tocar una foto la abre en grande ---
  const viewer = $<HTMLDialogElement>('#photo-viewer');
  const viewerImg = $<HTMLImageElement>('#viewer-img');
  let viewerPlayer = '';

  function openViewer(name: string) {
    const v = photos[name];
    if (!v) return;
    viewerPlayer = name;
    viewerImg.src = `${API}/photos/${encodeURIComponent(name)}?v=${v}`;
    viewerImg.alt = `Foto de ${name}`;
    viewer.style.setProperty('--c', colors.get(name) ?? '#fff');
    $('#viewer-name').textContent = name;
    $('#viewer-change').hidden = !(online && canWrite && roster.includes(name));
    viewer.showModal();
  }
  // Tocar en cualquier lado (menos el botón) cierra
  viewer.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('#viewer-change')) viewer.close();
  });
  $('#viewer-change').addEventListener('click', () => {
    viewer.close();
    photoFor = viewerPlayer;
    photoInput.value = '';
    photoInput.click();
  });
  // Cualquier avatar con foto (menos los botones para elegir jugador) abre el visor
  document.addEventListener('click', (e) => {
    const av = (e.target as HTMLElement).closest<HTMLElement>('.fc-avatar.has-photo');
    if (!av || av.closest('.fc-picks, .fc-preview') || !av.dataset.player) return;
    openViewer(av.dataset.player);
  });

  async function changePhoto(name: string, file: File | null) {
    try {
      const path = `/photos/${encodeURIComponent(name)}`;
      if (file) {
        // Primero se ajusta; si cancela, no se sube nada
        const blob = await cropPhoto(file);
        if (!blob) return;
        busyPlayer = name;
        renderPlayers();
        await write('PUT', path, blob);
      } else {
        busyPlayer = name;
        renderPlayers();
        await write('DELETE', path);
      }
      notify(file ? `📷 Foto de ${name} actualizada` : `Foto de ${name} quitada`);
    } catch (err) {
      if (!(err instanceof Cancelled)) notify(errorText(err));
    } finally {
      busyPlayer = null;
      refresh();
      renderPlayers();
    }
  }

  photoInput.addEventListener('change', () => {
    const file = photoInput.files?.[0];
    if (file && photoFor) changePhoto(photoFor, file);
    photoFor = null;
  });

  document.querySelectorAll('[data-open-players]').forEach((b) => b.addEventListener('click', openPlayers));
  playersDialog.querySelector('[data-close-players]')!.addEventListener('click', () => playersDialog.close());
  playersDialog.addEventListener('click', (e) => {
    if (e.target === playersDialog) playersDialog.close();
  });
  // Tocar una fila abre la ficha del jugador (tocar una foto, en cambio, la agranda)
  standingsEl.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('.fc-avatar.has-photo')) return;
    const row = t.closest<HTMLElement>('.fc-row');
    if (row?.dataset.player) openPlayerDetail(row.dataset.player);
  });
  standingsEl.addEventListener('keydown', (e) => {
    const row = (e.target as HTMLElement).closest<HTMLElement>('.fc-row');
    if (row?.dataset.player && (e.key === 'Enter' || e.key === ' ')) {
      e.preventDefault();
      openPlayerDetail(row.dataset.player);
    }
  });

  // --- Ficha del jugador ---
  const detailDialog = $<HTMLDialogElement>('#player-detail');
  let detailPlayer = '';

  function openPlayerDetail(name: string) {
    detailPlayer = name;
    renderPlayerDetail();
    detailDialog.showModal();
    detailDialog.scrollTop = 0;
  }

  function renderPlayerDetail() {
    const name = detailPlayer;
    const same = (a: string) => a.trim().toLowerCase() === name.trim().toLowerCase();
    const rows = computeTable();
    const pos = rows.findIndex((r) => same(r.name));
    const r = rows[pos];

    // Encabezado: avatar (toca → foto en grande o subir una), nombre y posición
    const av = document.createElement('span');
    av.className = 'fc-avatar fc-avatar-xl';
    avatar(av, name);
    if (!photos[name] && roster.includes(name)) {
      av.style.cursor = 'pointer';
      av.title = 'Subir foto';
      av.addEventListener('click', () => {
        detailDialog.close();
        photoFor = name;
        photoInput.value = '';
        photoInput.click();
      });
    }
    const text = document.createElement('div');
    text.className = 'min-w-0';
    const h = document.createElement('h2');
    h.id = 'pd-name';
    h.className = 'fc-pd-name';
    h.textContent = name;
    const sub = document.createElement('p');
    sub.className = 'fc-muted text-sm';
    sub.textContent = r && r.pj ? `${pos + 1}° en la tabla · ${r.pts} pts` : 'Sin partidos todavía';
    text.append(h, sub);
    if (r?.form.length) text.append(formEl(r.form));
    $('#pd-head').replaceChildren(av, text);

    const stat = (value: string | number, label: string) => {
      const d = document.createElement('div');
      const b = document.createElement('b');
      b.textContent = String(value);
      const sm = document.createElement('small');
      sm.textContent = label;
      d.append(b, sm);
      return d;
    };
    $('#pd-stats').replaceChildren(
      stat(r?.pj ?? 0, 'Jugados'),
      stat(r ? `${r.g}-${r.e}-${r.p}` : '0-0-0', 'G-E-P'),
      stat(r ? `${r.gf}:${r.gc}` : '0:0', 'Goles'),
      stat(r ? signed(r.dg) : 0, 'Dif.'),
    );

    // Sus partidos, del más nuevo al más viejo, vistos desde su lado
    const mine = [...matches]
      .filter((m) => same(m.homePlayer) || same(m.awayPlayer))
      .sort(byDate)
      .reverse()
      .map((m) => {
        const home = same(m.homePlayer);
        const gf = home ? m.homeGoals : m.awayGoals;
        const gc = home ? m.awayGoals : m.homeGoals;
        return {
          m,
          home,
          gf,
          gc,
          rival: home ? m.awayPlayer : m.homePlayer,
          myTeam: home ? m.homeTeam : m.awayTeam,
          rivalTeam: home ? m.awayTeam : m.homeTeam,
          res: gf > gc ? 'w' : gf < gc ? 'l' : 'd',
        };
      });

    // Contra cada rival
    const rivals = new Map<string, { w: number; d: number; l: number; gf: number; gc: number }>();
    for (const x of mine) {
      const k = rivals.get(x.rival) ?? { w: 0, d: 0, l: 0, gf: 0, gc: 0 };
      k[x.res as 'w' | 'd' | 'l']++;
      k.gf += x.gf;
      k.gc += x.gc;
      rivals.set(x.rival, k);
    }
    $('#pd-rivals-wrap').hidden = rivals.size === 0;
    $('#pd-rivals').replaceChildren(
      ...[...rivals]
        .sort(([, a], [, b]) => b.w * 3 + b.d - (a.w * 3 + a.d) || b.gf - b.gc - (a.gf - a.gc))
        .map(([rival, k]) => {
          const li = document.createElement('li');
          const ra = document.createElement('span');
          ra.className = 'fc-avatar';
          avatar(ra, rival);
          const n = document.createElement('b');
          n.textContent = `vs ${rival}`;
          const rec = document.createElement('small');
          rec.textContent = `${k.w}G ${k.d}E ${k.l}P · ${k.gf}:${k.gc}`;
          li.append(ra, n, rec);
          return li;
        }),
    );

    $('#pd-empty').hidden = mine.length > 0;
    $('#pd-matches').replaceChildren(
      ...mine.map((x) => {
        const li = document.createElement('li');
        li.className = 'fc-pd-match';
        li.dataset.matchId = x.m.id;
        li.tabIndex = 0;
        li.setAttribute('role', 'button');
        const res = document.createElement('span');
        res.className = `fc-res ${x.res}`;
        res.textContent = formLetter[x.res];
        res.setAttribute('aria-label', x.res === 'w' ? 'Ganó' : x.res === 'l' ? 'Perdió' : 'Empató');

        const mid = document.createElement('div');
        mid.className = 'min-w-0';
        const vs = document.createElement('div');
        vs.className = 'fc-pd-vs';
        const label = document.createElement('span');
        label.className = 'fc-muted text-xs';
        label.textContent = 'vs';
        const ra = document.createElement('span');
        ra.className = 'fc-avatar';
        avatar(ra, x.rival);
        const rn = document.createElement('span');
        rn.textContent = x.rival;
        vs.append(label, ra, rn);
        const meta = document.createElement('p');
        meta.className = 'fc-pd-meta';
        const teams = x.myTeam || x.rivalTeam ? ` · ${x.myTeam || '—'} vs ${x.rivalTeam || '—'}` : '';
        meta.textContent = `${dayLabel(x.m.date)}${teams}${x.home ? '' : ' · de visitante'}`;
        mid.append(vs, meta);

        const score = document.createElement('p');
        score.className = 'fc-pd-score';
        score.textContent = `${x.gf} - ${x.gc}`;
        li.append(res, mid, score);

        // Sus goles con el minuto
        const myGoals = (x.m.goals ?? []).filter((g) => g.side === (x.home ? 'home' : 'away'));
        if (myGoals.length) {
          const start = x.m.startedAt ?? x.m.goals![0].at;
          const ol = document.createElement('ol');
          ol.className = 'fc-goals';
          ol.append(...myGoals.map((g) => goalChip(g, start, name)));
          li.append(ol);
        }
        return li;
      }),
    );
  }

  // --- Torneos ---
  const tournamentsDialog = $<HTMLDialogElement>('#tournaments-dialog');
  const teditDialog = $<HTMLDialogElement>('#tournament-edit');
  const teditForm = $<HTMLFormElement>('#tournament-form');
  let editingTournament: string | null = null; // null = nuevo

  function fillTournamentSelect(sel: HTMLSelectElement, value: string) {
    sel.replaceChildren(
      Object.assign(document.createElement('option'), { value: '', textContent: 'Sin torneo' }),
      ...tournaments.map((t) => Object.assign(document.createElement('option'), { value: t.id, textContent: t.name })),
    );
    sel.value = tournaments.some((t) => t.id === value) ? value : '';
  }

  function renderTournamentBar() {
    $('#tournament-name').textContent =
      view === 'all' ? 'Todos los partidos' : view === 'none' ? 'Sin torneo' : (tournamentName(view) ?? 'Todos los partidos');
    $('#tournament-count').textContent = `${matches.length} PJ`;
    // El selector del formulario sigue a la lista de torneos (sin pisar lo que eligió el que carga)
    const fsel = form.elements.namedItem('tournament') as HTMLSelectElement;
    const current = fsel.value;
    fillTournamentSelect(fsel, current);
  }

  function renderTournamentList() {
    const ready = online && canWrite;
    const count = (pred: (m: Match) => boolean) => allMatches.filter(pred).length;
    const item = (id: string, label: string, n: number, editable: boolean) => {
      const li = document.createElement('li');
      const pick = document.createElement('button');
      pick.type = 'button';
      pick.className = 'pick';
      pick.setAttribute('aria-current', String(view === id));
      const name = document.createElement('span');
      name.textContent = label;
      const sm = document.createElement('small');
      sm.textContent = `${n} ${n === 1 ? 'partido' : 'partidos'}`;
      pick.append(name, sm);
      pick.addEventListener('click', () => {
        setView(id);
        tournamentsDialog.close();
        refresh();
        notify(`🏆 ${label}`);
      });
      li.append(pick);
      if (editable && ready) {
        const edit = document.createElement('button');
        edit.type = 'button';
        edit.className = 'edit';
        edit.textContent = 'Editar';
        edit.setAttribute('aria-label', `Editar ${label}`);
        edit.addEventListener('click', () => openTournamentEditor(id));
        li.append(edit);
      }
      return li;
    };
    const noneCount = count((m) => !m.tournamentId || !tournamentName(m.tournamentId));
    $('#tournament-list').replaceChildren(
      item('all', 'Todos los partidos', allMatches.length, false),
      ...tournaments.map((t) => item(t.id, t.name, count((m) => m.tournamentId === t.id), true)),
      ...(tournaments.length && noneCount ? [item('none', 'Sin torneo', noneCount, false)] : []),
    );
    $('#tournament-new').hidden = !ready;
    $('#tournament-offline').hidden = ready;
  }

  function openTournaments() {
    renderTournamentList();
    tournamentsDialog.showModal();
  }

  // Editor: nombre + qué partidos (de los ya cargados) quedan en el torneo
  function openTournamentEditor(id: string | null) {
    editingTournament = id;
    const t = tournaments.find((x) => x.id === id);
    $('#tedit-title').textContent = t ? 'Editar torneo' : 'Nuevo torneo';
    (teditForm.elements.namedItem('name') as HTMLInputElement).value = t?.name ?? '';
    $('#tedit-delete').hidden = !t;
    $('#tedit-error').textContent = '';
    const list = [...allMatches].filter((m) => !localOnly.some((x) => x.id === m.id)).sort(byDate).reverse();
    $('#tedit-matches').replaceChildren(
      ...list.map((m) => {
        const li = document.createElement('li');
        const label = document.createElement('label');
        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.value = m.id;
        cb.checked = Boolean(t && m.tournamentId === t.id);
        const mid = document.createElement('div');
        mid.className = 'min-w-0';
        const b = document.createElement('b');
        b.textContent = `${m.homePlayer} vs ${m.awayPlayer}`;
        const sm = document.createElement('small');
        const other = m.tournamentId && m.tournamentId !== t?.id ? tournamentName(m.tournamentId) : '';
        sm.textContent = `${dayLabel(m.date)}${other ? ` · ahora en ${other}` : ''}`;
        mid.append(b, sm);
        const score = document.createElement('span');
        score.className = 'score';
        score.textContent = `${m.homeGoals}-${m.awayGoals}`;
        label.append(cb, mid, score);
        li.append(label);
        return li;
      }),
    );
    if (!list.length) $('#tedit-matches').innerHTML = '<li class="fc-muted py-3 text-center text-sm">Todavía no hay partidos cargados.</li>';
    renderTeditCount();
    if (!teditDialog.open) teditDialog.showModal();
    if (!t) (teditForm.elements.namedItem('name') as HTMLInputElement).focus();
  }

  function renderTeditCount() {
    const n = teditForm.querySelectorAll('#tedit-matches input:checked').length;
    $('#tedit-count').textContent = `${n} ${n === 1 ? 'partido elegido' : 'partidos elegidos'}. Tocá para sumar o sacar.`;
  }
  teditForm.addEventListener('change', renderTeditCount);

  $('#tedit-free').addEventListener('click', () => {
    teditForm.querySelectorAll<HTMLInputElement>('#tedit-matches input').forEach((cb) => {
      const m = allMatches.find((x) => x.id === cb.value);
      if (m && (!m.tournamentId || !tournamentName(m.tournamentId))) cb.checked = true;
    });
    renderTeditCount();
  });

  teditForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = (teditForm.elements.namedItem('name') as HTMLInputElement).value.trim();
    if (!name) {
      $('#tedit-error').textContent = 'Poné un nombre para el torneo';
      return;
    }
    const matchIds = [...teditForm.querySelectorAll<HTMLInputElement>('#tedit-matches input:checked')].map((cb) => cb.value);
    const btn = teditForm.querySelector<HTMLButtonElement>('[type=submit]')!;
    btn.disabled = true;
    try {
      const data = editingTournament
        ? await write('PUT', `/tournaments/${editingTournament}`, { name, matchIds })
        : await write('POST', '/tournaments', { name, matchIds });
      teditDialog.close();
      // Un torneo recién creado queda seleccionado y se va directo a él
      if (!editingTournament && data.id) {
        setView(data.id);
        tournamentsDialog.close();
      }
      refresh();
      if (tournamentsDialog.open) renderTournamentList();
      notify(editingTournament ? `🏆 ${name} actualizado` : `🏆 Torneo "${name}" creado`);
    } catch (err) {
      if (!(err instanceof Cancelled)) $('#tedit-error').textContent = errorText(err);
    } finally {
      btn.disabled = false;
    }
  });

  $('#tedit-delete').addEventListener('click', async () => {
    const t = tournaments.find((x) => x.id === editingTournament);
    if (!t || !confirm(`¿Borrar el torneo "${t.name}"? Sus partidos no se borran: quedan sin torneo.`)) return;
    try {
      await write('DELETE', `/tournaments/${t.id}`);
      teditDialog.close();
      refresh();
      if (tournamentsDialog.open) renderTournamentList();
      notify(`Torneo "${t.name}" borrado`);
    } catch (err) {
      if (!(err instanceof Cancelled)) $('#tedit-error').textContent = errorText(err);
    }
  });

  $('#tournament-btn').addEventListener('click', openTournaments);
  $('#tournament-new').addEventListener('click', () => openTournamentEditor(null));
  tournamentsDialog.querySelector('[data-close-tournaments]')!.addEventListener('click', () => tournamentsDialog.close());
  teditDialog.querySelector('[data-close-tedit]')!.addEventListener('click', () => teditDialog.close());
  for (const d of [tournamentsDialog, teditDialog]) {
    d.addEventListener('click', (e) => {
      if (e.target === d) d.close();
    });
  }

  // Mover un partido de torneo desde su detalle
  $<HTMLSelectElement>('#md-tournament').addEventListener('change', async (e) => {
    const sel = e.currentTarget as HTMLSelectElement;
    const id = sel.dataset.matchId!;
    try {
      await write('PUT', `/matches/${encodeURIComponent(id)}/tournament`, { tournamentId: sel.value || null });
      refresh();
      notify(sel.value ? `Movido a ${tournamentName(sel.value)}` : 'Partido sin torneo');
    } catch (err) {
      if (!(err instanceof Cancelled)) notify(errorText(err));
    }
  });

  // --- Detalle del partido: línea de tiempo con los goles ---
  const matchDialog = $<HTMLDialogElement>('#match-detail');
  let detailMatchId = '';

  function openMatchDetail(id: string) {
    if (!matches.some((m) => m.id === id)) return;
    detailMatchId = id;
    renderMatchDetail();
    matchDialog.showModal();
    matchDialog.scrollTop = 0;
  }

  function renderMatchDetail() {
    const m = matches.find((x) => x.id === detailMatchId);
    if (!m) return matchDialog.close();
    $('#md-date').textContent = dayLabel(m.date);
    // Torneo del partido (se puede mover si hay servidor y el partido ya está subido)
    const tsel = $<HTMLSelectElement>('#md-tournament');
    const editable = online && canWrite && !localOnly.some((x) => x.id === m.id);
    $('#md-tournament-wrap').hidden = !tournaments.length || (!editable && !m.tournamentId);
    fillTournamentSelect(tsel, m.tournamentId ?? '');
    tsel.disabled = !editable;
    tsel.dataset.matchId = m.id;
    $('#md-title').textContent = `${m.homePlayer} ${m.homeGoals}-${m.awayGoals} ${m.awayPlayer}`;

    const side = (player: string, team: string, label: string) => {
      const d = document.createElement('div');
      d.className = 'fc-md-side';
      const av = document.createElement('span');
      av.className = 'fc-avatar fc-avatar-lg';
      avatar(av, player);
      const b = document.createElement('b');
      b.textContent = player;
      const sm = document.createElement('small');
      sm.textContent = team ? `${team} · ${label}` : label;
      d.append(av, b, sm);
      return d;
    };
    const score = document.createElement('p');
    score.textContent = `${m.homeGoals} - ${m.awayGoals}`;
    $('#md-score').replaceChildren(side(m.homePlayer, m.homeTeam, 'local'), score, side(m.awayPlayer, m.awayTeam, 'visitante'));

    // Goles con su minuto (los viejos sin minuto de juego usan el tiempo real)
    const start = m.startedAt ?? m.goals?.[0]?.at ?? 0;
    const goals = [...(m.goals ?? [])]
      .map((g) => ({ ...g, minute: g.min ?? minuteOf(g.at, start) }))
      .sort((a, b) => a.minute - b.minute || a.at - b.at);
    const hasTimeline = goals.length > 0 && goals.length === m.homeGoals + m.awayGoals;
    const name = (sideKey: 'home' | 'away') => (sideKey === 'home' ? m.homePlayer : m.awayPlayer);

    // Marcador después de cada gol
    let h = 0;
    let a = 0;
    const rows = goals.map((g) => {
      if (g.side === 'home') h++;
      else a++;
      return { ...g, score: `${h}-${a}` };
    });

    const chart = $('#md-chart');
    if (!m.homeGoals && !m.awayGoals) {
      chart.innerHTML = '<p class="fc-md-empty">Terminó sin goles.</p>';
    } else if (!hasTimeline) {
      chart.innerHTML = '<p class="fc-md-empty">Este partido se cargó sin los minutos de los goles.</p>';
    } else {
      chart.replaceChildren(timeline(rows, m));
    }

    // Goles por tiempo
    const half = (g: { minute: number }) => (g.minute <= 45 ? 1 : 2);
    const count = (n: number, s: 'home' | 'away') => rows.filter((g) => half(g) === n && g.side === s).length;
    $('#md-halves').innerHTML = '';
    if (hasTimeline) {
      for (const n of [1, 2]) {
        const span = document.createElement('span');
        span.append(`${n}° tiempo `);
        const b = document.createElement('b');
        b.textContent = `${count(n, 'home')}-${count(n, 'away')}`;
        span.append(b);
        if (n === 1) span.append('  ·  ');
        $('#md-halves').append(span);
      }
    }

    // Tabla gol por gol (también sirve como versión accesible del gráfico)
    $('#md-goals').replaceChildren(
      ...rows.map((g) => {
        const li = document.createElement('li');
        const min = document.createElement('b');
        min.textContent = `${g.minute}'`;
        const av = document.createElement('span');
        av.className = 'fc-avatar';
        avatar(av, name(g.side));
        const n = document.createElement('span');
        n.textContent = name(g.side);
        const right = document.createElement('span');
        right.className = 'flex items-baseline gap-2';
        const time = document.createElement('small');
        time.textContent = clockFmt.format(g.at);
        const sc = document.createElement('span');
        sc.className = 'score';
        sc.textContent = g.score;
        right.append(time, sc);
        li.append(min, av, n, right);
        return li;
      }),
    );
    $('#md-goals').previousElementSibling!.toggleAttribute('hidden', rows.length === 0);
  }

  // Barras de goles por tramo de 15': local hacia arriba, visitante hacia abajo
  const BINS = [
    { from: 1, to: 15, label: "0-15'" },
    { from: 16, to: 30, label: "15-30'" },
    { from: 31, to: 45, label: "30-45'" },
    { from: 46, to: 60, label: "45-60'" },
    { from: 61, to: 75, label: "60-75'" },
    { from: 76, to: Infinity, label: "75-90'+" },
  ];

  function timeline(rows: (Goal & { minute: number; score: string })[], m: Match) {
    const binOf = (minute: number) => Math.min(BINS.length - 1, Math.max(0, Math.floor((minute - 1) / 15)));
    const goalsIn = (i: number, side: 'home' | 'away') => rows.filter((g) => g.side === side && binOf(g.minute) === i);
    const most = Math.max(1, ...BINS.flatMap((_, i) => [goalsIn(i, 'home').length, goalsIn(i, 'away').length]));
    const maxMinute = Math.max(90, ...rows.map((g) => g.minute));

    const wrap = document.createElement('div');
    wrap.className = 'fc-tl';
    wrap.setAttribute('role', 'img');
    wrap.setAttribute(
      'aria-label',
      `Goles por tramo de 15 minutos: ${BINS.map(
        (bin, i) => `${bin.label} ${m.homePlayer} ${goalsIn(i, 'home').length}, ${m.awayPlayer} ${goalsIn(i, 'away').length}`,
      ).join('; ')}`,
    );

    const halves = document.createElement('div');
    halves.className = 'fc-tl-halves';
    halves.innerHTML = '<span>1° tiempo</span><span>2° tiempo</span>';

    const plot = document.createElement('div');
    plot.className = 'fc-tl-plot fc-bars';
    const axis = document.createElement('div');
    axis.className = 'fc-tl-axis';
    const ht = document.createElement('div');
    ht.className = 'fc-tl-ht';
    ht.style.left = '50%';
    plot.append(axis, ht);

    BINS.forEach((bin, i) => {
      const col = document.createElement('div');
      col.className = 'fc-bin';
      for (const side of ['home', 'away'] as const) {
        const lane = document.createElement('div');
        lane.className = `lane ${side}`;
        const list = goalsIn(i, side);
        if (list.length) {
          const player = side === 'home' ? m.homePlayer : m.awayPlayer;
          const bar = document.createElement('button');
          bar.type = 'button';
          bar.className = `fc-bar${i === 0 ? ' edge-l' : ''}${i === BINS.length - 1 ? ' edge-r' : ''}`;
          bar.style.setProperty('--h', String(list.length / most));
          bar.style.setProperty('--c', colors.get(player) ?? '#71717a');
          const minutes = list.map((g) => `${g.minute}'`).join(', ');
          bar.setAttribute('aria-label', `${player}: ${list.length} ${list.length === 1 ? 'gol' : 'goles'} entre ${bin.label} (${minutes})`);
          // Cantidad en la punta de la barra
          const count = document.createElement('b');
          count.className = 'fc-bar-n';
          count.textContent = String(list.length);
          const tip = document.createElement('span');
          tip.className = 'fc-tl-tip';
          tip.textContent = `⚽ ${player} · ${minutes}`;
          bar.append(count, tip);
          lane.append(bar);
        }
        col.append(lane);
      }
      plot.append(col);
    });

    const ticks = document.createElement('div');
    ticks.className = 'fc-tl-ticks';
    ['0', '15', '30', '45', '60', '75', maxMinute > 90 ? `${maxMinute}` : '90'].forEach((t, i) => {
      const sp = document.createElement('span');
      sp.style.left = `${(i / BINS.length) * 100}%`;
      sp.textContent = `${t}'`;
      ticks.append(sp);
    });

    // El jugador A (local) arriba del gráfico y el B (visitante) abajo, del lado de sus barras
    const who = (player: string, where: string, cls: string) => {
      const row = document.createElement('div');
      row.className = `fc-tl-player ${cls}`;
      row.style.setProperty('--c', colors.get(player) ?? '#71717a');
      const av = document.createElement('span');
      av.className = 'fc-avatar';
      avatar(av, player);
      const name = document.createElement('b');
      name.textContent = player;
      const sm = document.createElement('small');
      const goals = rows.filter((g) => (cls === 'top' ? g.side === 'home' : g.side === 'away')).length;
      sm.textContent = `${where} · ${goals} ${goals === 1 ? 'gol' : 'goles'}`;
      row.append(av, name, sm);
      return row;
    };

    wrap.append(who(m.homePlayer, 'local', 'top'), halves, plot, ticks, who(m.awayPlayer, 'visitante', 'bottom'));
    return wrap;
  }

  // Tocar una barra en el celu muestra sus goles (una a la vez)
  matchDialog.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t === matchDialog) return matchDialog.close();
    const bar = t.closest<HTMLElement>('.fc-bar');
    matchDialog.querySelectorAll('.fc-bar.show').forEach((g) => g !== bar && g.classList.remove('show'));
    bar?.classList.toggle('show');
  });
  matchDialog.querySelector('[data-close-match]')!.addEventListener('click', () => matchDialog.close());

  // Abrir el detalle desde la lista de partidos y desde la ficha del jugador
  for (const container of [matchesEl, $('#pd-matches')]) {
    container.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('.fc-delete, .fc-avatar.has-photo')) return;
      const card = t.closest<HTMLElement>('[data-match-id]');
      if (card) openMatchDetail(card.dataset.matchId!);
    });
    container.addEventListener('keydown', (e) => {
      const card = (e.target as HTMLElement).closest<HTMLElement>('[data-match-id]');
      if (card && e.target === card && (e.key === 'Enter' || e.key === ' ')) {
        e.preventDefault();
        openMatchDetail(card.dataset.matchId!);
      }
    });
  }

  detailDialog.querySelector('[data-close-detail]')!.addEventListener('click', () => detailDialog.close());
  detailDialog.addEventListener('click', (e) => {
    if (e.target === detailDialog) detailDialog.close();
  });

  // Al volver a la pestaña se traen los partidos que cargaron los demás
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') sync();
  });

  const byDate = (a: Match, b: Match) => a.date.localeCompare(b.date) || a.id.localeCompare(b.id);
  const dayFmt = new Intl.DateTimeFormat('es-AR', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });

  function dayLabel(iso: string) {
    const d = new Date();
    const local = (offset: number) => {
      const x = new Date(d.getFullYear(), d.getMonth(), d.getDate() - offset);
      return `${x.getFullYear()}-${String(x.getMonth() + 1).padStart(2, '0')}-${String(x.getDate()).padStart(2, '0')}`;
    };
    if (iso === local(0)) return 'Hoy';
    if (iso === local(1)) return 'Ayer';
    const t = Date.parse(`${iso}T00:00:00Z`);
    return Number.isNaN(t) ? iso : dayFmt.format(t);
  }

  // --- Tabla + resumen ---
  type Row = { name: string; pj: number; g: number; e: number; p: number; gf: number; gc: number; form: string[] };

  // Empates: se respeta el orden de la lista de jugadores
  const order = (name: string) => {
    const i = roster.indexOf(name);
    return i === -1 ? roster.length : i;
  };

  function computeTable() {
    const table = new Map<string, Row>();
    const row = (name: string) => {
      const k = name.trim().toLowerCase();
      if (!table.has(k)) table.set(k, { name: name.trim(), pj: 0, g: 0, e: 0, p: 0, gf: 0, gc: 0, form: [] });
      return table.get(k)!;
    };
    roster.forEach(row);
    for (const m of [...matches].sort(byDate)) {
      const h = row(m.homePlayer);
      const a = row(m.awayPlayer);
      h.pj++; a.pj++;
      h.gf += m.homeGoals; h.gc += m.awayGoals;
      a.gf += m.awayGoals; a.gc += m.homeGoals;
      if (m.homeGoals > m.awayGoals) { h.g++; a.p++; h.form.push('w'); a.form.push('l'); }
      else if (m.homeGoals < m.awayGoals) { a.g++; h.p++; a.form.push('w'); h.form.push('l'); }
      else { h.e++; a.e++; h.form.push('d'); a.form.push('d'); }
    }
    return [...table.values()]
      .map((r) => ({ ...r, dg: r.gf - r.gc, pts: r.g * 3 + r.e }))
      .sort((x, y) => y.pts - x.pts || y.dg - x.dg || y.gf - x.gf || order(x.name) - order(y.name));
  }

  const vtName = (name: string) => `p-${[...name].map((c) => c.charCodeAt(0).toString(36)).join('')}`;
  const formLetter = { w: 'G', d: 'E', l: 'P' } as Record<string, string>;
  const signed = (n: number) => (n > 0 ? `+${n}` : String(n));

  function formEl(form: string[]) {
    const wrap = document.createElement('div');
    wrap.className = 'fc-form';
    for (const r of form.slice(-5)) {
      const i = document.createElement('i');
      i.className = r;
      i.textContent = formLetter[r];
      wrap.append(i);
    }
    return wrap;
  }

  function cell(text: string | number, cls = '') {
    const s = document.createElement('span');
    s.textContent = String(text);
    if (cls) s.className = cls;
    return s;
  }

  function renderStandings(rows: ReturnType<typeof computeTable>) {
    standingsEl.replaceChildren(
      ...rows.map((r, i) => {
        const li = document.createElement('li');
        li.className = 'fc-row';
        li.style.viewTransitionName = vtName(r.name);
        // Tocar la fila abre la ficha del jugador
        li.dataset.player = r.name;
        li.tabIndex = 0;
        li.setAttribute('role', 'button');
        li.setAttribute('aria-label', `Ver los partidos de ${r.name}`);

        const who = document.createElement('div');
        who.className = 'fc-who';
        const av = document.createElement('span');
        av.className = 'fc-avatar';
        avatar(av, r.name);
        const info = document.createElement('div');
        info.className = 'min-w-0';
        const name = document.createElement('p');
        name.textContent = r.name;
        const sub = document.createElement('small');
        sub.textContent = `${r.g}G ${r.e}E ${r.p}P · ${r.gf}:${r.gc}`;
        info.append(name, sub);
        if (r.form.length) info.append(formEl(r.form));
        who.append(av, info);

        li.append(cell(i + 1, i === 0 && r.pj > 0 ? 'fc-rank lead' : 'fc-rank'), who, formEl(r.form), cell(r.pj), cell(r.gf, 'fc-gf'), cell(signed(r.dg)), cell(r.pts, 'fc-pts'));
        return li;
      }),
    );
  }

  function renderSummary(rows: ReturnType<typeof computeTable>) {
    const goals = matches.reduce((s, m) => s + m.homeGoals + m.awayGoals, 0);
    $('#stat-matches').textContent = String(matches.length);
    $('#stat-goals').textContent = String(goals);
    $('#stat-avg').textContent = matches.length ? (goals / matches.length).toFixed(1).replace('.', ',') : '0';

    const leaderEl = $('#leader');
    const leader = rows[0];
    leaderEl.replaceChildren();
    if (!matches.length || !leader) {
      leaderEl.style.removeProperty('--c');
      const text = document.createElement('div');
      text.innerHTML = '<p class="fc-eyebrow">Arranca la temporada</p><p class="mt-1 text-lg font-extrabold">Nadie lidera todavía</p><p class="fc-muted text-sm">Cargá el primer partido con el botón +</p>';
      leaderEl.append(text);
      return;
    }
    leaderEl.style.setProperty('--c', colors.get(leader.name) ?? 'var(--fc-accent)');
    const av = document.createElement('span');
    av.className = 'fc-avatar fc-avatar-xl';
    avatar(av, leader.name);
    const crown = cell('👑', 'fc-leader-crown');
    const text = document.createElement('div');
    text.className = 'min-w-0';
    text.innerHTML = '<p class="fc-eyebrow">Líder</p>';
    const name = document.createElement('p');
    name.className = 'truncate text-2xl font-black';
    name.textContent = leader.name;
    const sub = document.createElement('p');
    sub.className = 'fc-muted text-sm';
    sub.textContent = `${leader.g} ganados · DG ${signed(leader.dg)}`;
    text.append(name, sub);
    const pts = document.createElement('div');
    pts.className = 'fc-leader-pts';
    const ptsValue = document.createElement('b');
    ptsValue.textContent = String(leader.pts);
    const ptsLabel = document.createElement('small');
    ptsLabel.textContent = 'Puntos';
    pts.append(ptsValue, ptsLabel);
    leaderEl.append(av, crown, text, pts);
  }

  // --- Partidos ---
  let pendingDelete: Match | null = null;

  function matchEl(m: Match) {
    const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
    li.style.viewTransitionName = `m-${m.id.replace(/[^a-z0-9-]/gi, '')}`;
    // Tocar la tarjeta abre el detalle (salvo el tacho o una foto)
    li.dataset.matchId = m.id;
    li.tabIndex = 0;
    li.setAttribute('role', 'button');
    li.setAttribute('aria-label', `Ver el partido ${m.homePlayer} ${m.homeGoals}-${m.awayGoals} ${m.awayPlayer}`);
    const [home, away] = li.querySelectorAll<HTMLElement>('.fc-match-side');
    const [hg, ag] = li.querySelectorAll<HTMLElement>('.fc-score span');
    const fill = (side: HTMLElement, player: string, team: string) => {
      avatar(side.querySelector('.fc-avatar')!, player);
      side.querySelector('.fc-player')!.textContent = player;
      side.querySelector('.fc-team')!.textContent = team || '—';
    };
    fill(home, m.homePlayer, m.homeTeam);
    fill(away, m.awayPlayer, m.awayTeam);
    hg.textContent = String(m.homeGoals);
    ag.textContent = String(m.awayGoals);
    if (m.homeGoals !== m.awayGoals) {
      const homeWon = m.homeGoals > m.awayGoals;
      (homeWon ? home : away).classList.add('win');
      (homeWon ? away : home).classList.add('lose');
      (homeWon ? hg : ag).classList.add('win');
    }
    if (Array.isArray(m.goals) && m.goals.length) {
      const start = m.startedAt ?? m.goals[0].at;
      li.querySelector('.fc-goals')!.append(
        ...m.goals.map((g) => {
          const chip = document.createElement('li');
          const player = g.side === 'home' ? m.homePlayer : m.awayPlayer;
          chip.style.setProperty('--c', colors.get(player) ?? '#71717a');
          const min = document.createElement('b');
          min.textContent = goalLabel(g, start);
          const time = document.createElement('small');
          time.textContent = clockFmt.format(g.at);
          chip.append(min, ` ${player} `, time);
          return chip;
        }),
      );
    }
    li.querySelector('.fc-delete')!.addEventListener('click', () => {
      pendingDelete = m;
      $('#confirm-text').textContent = `${m.homePlayer} ${m.homeGoals}-${m.awayGoals} ${m.awayPlayer} · ${dayLabel(m.date)}`;
      confirmDialog.showModal();
    });
    return li;
  }

  function renderMatches() {
    const groups = new Map<string, Match[]>();
    for (const m of [...matches].sort(byDate).reverse()) {
      if (!groups.has(m.date)) groups.set(m.date, []);
      groups.get(m.date)!.push(m);
    }
    matchesEl.replaceChildren(
      ...[...groups].map(([date, list]) => {
        const section = document.createElement('div');
        const h = document.createElement('h3');
        h.className = 'fc-day';
        h.textContent = dayLabel(date);
        const ol = document.createElement('ol');
        ol.append(...list.map(matchEl));
        section.append(h, ol);
        return section;
      }),
    );
    matchesEmpty.hidden = matches.length > 0;
    $('#matches-count').textContent = matches.length ? String(matches.length) : '';
  }

  // --- Equipos guardados ---
  const sameTeam = (a: string, b: string) => a.trim().toLowerCase() === b.trim().toLowerCase();

  function uniqueTeams(list: (string | undefined)[]) {
    const out: string[] = [];
    for (const t of list) {
      const name = t?.trim();
      if (name && !out.some((x) => sameTeam(x, name))) out.push(name);
    }
    return out;
  }

  // Más recientes primero: los guardados + los que aparecen en partidos
  let savedTeams: string[] = (() => {
    let stored: string[] = [];
    try {
      const data = JSON.parse(localStorage.getItem(TEAMS_KEY) ?? '[]');
      if (Array.isArray(data)) stored = data.filter((t) => typeof t === 'string');
    } catch {}
    const fromMatches = [...matches].sort(byDate).reverse().flatMap((m) => [m.homeTeam, m.awayTeam]);
    return uniqueTeams([...stored, ...fromMatches]);
  })();

  function rememberTeams(names: string[]) {
    savedTeams = uniqueTeams([...names, ...savedTeams]).slice(0, 40);
    try {
      localStorage.setItem(TEAMS_KEY, JSON.stringify(savedTeams));
    } catch {}
  }

  // Primero los equipos que ya usó ese jugador, después el resto
  function teamsFor(player?: string) {
    const own = player
      ? [...matches]
          .sort(byDate)
          .reverse()
          .flatMap((m) => [m.homePlayer === player ? m.homeTeam : '', m.awayPlayer === player ? m.awayTeam : ''])
      : [];
    return uniqueTeams([...own, ...savedTeams]).slice(0, 4);
  }

  function renderTeams() {
    $('#teams').replaceChildren(...savedTeams.map((v) => Object.assign(document.createElement('option'), { value: v })));
  }

  function render() {
    const rows = computeTable();
    renderSummary(rows);
    renderStandings(rows);
    renderMatches();
    renderTeams();
  }

  confirmDialog.addEventListener('close', async () => {
    const gone = pendingDelete;
    pendingDelete = null;
    if (confirmDialog.returnValue !== 'ok' || !gone) return;
    try {
      if (localOnly.some((m) => m.id === gone.id)) {
        localOnly = localOnly.filter((m) => m.id !== gone.id);
        storeKey(KEY, localOnly);
      } else {
        await write('DELETE', `/matches/${encodeURIComponent(gone.id)}`);
      }
      refresh();
      notify('Partido borrado');
    } catch (err) {
      if (!(err instanceof Cancelled)) notify(errorText(err));
    }
  });

  // --- Formulario (bottom sheet) ---
  // Equipo que trae cada jugador: el fijo, o si no tiene, el último con el que jugó
  function defaultTeam(player: string) {
    if (playerTeams[player]) return playerTeams[player];
    const last = [...allMatches]
      .sort(byDate)
      .reverse()
      .find((m) => (m.homePlayer === player && m.homeTeam) || (m.awayPlayer === player && m.awayTeam));
    return last ? (last.homePlayer === player ? last.homeTeam : last.awayTeam) : '';
  }
  // Si el equipo lo puso la página (no la persona), se reemplaza al cambiar de jugador
  const autoTeam: Record<string, boolean> = { home: true, away: true };

  function syncForm() {
    for (const [side, other] of [['home', 'away'], ['away', 'home']]) {
      const picked = form.querySelector<HTMLInputElement>(`[name=${side}Player]:checked`)?.value;
      // Un jugador no puede estar de los dos lados
      form.querySelectorAll<HTMLInputElement>(`[name=${other}Player]`).forEach((i) => (i.disabled = i.value === picked));
      const av = form.querySelector<HTMLElement>(`[data-preview=${side}]`)!;
      if (picked) avatar(av, picked);
      else {
        av.textContent = '?';
        av.style.removeProperty('--c');
      }
      form.querySelector(`[data-preview-name=${side}]`)!.textContent = picked ?? (side === 'home' ? 'Local' : 'Visitante');
      form.querySelector(`[data-preview-goals=${side}]`)!.textContent =
        (form.elements.namedItem(`${side}Goals`) as HTMLInputElement).value || '0';

      const current = (form.elements.namedItem(`${side}Team`) as HTMLInputElement).value;
      form.querySelector(`[data-team-line=${side}]`)!.textContent = current || (picked ? 'Sin equipo' : 'Equipo');
      form.querySelector(`[data-preview-team=${side}]`)!.textContent = current;
      form.querySelector<HTMLElement>(`[data-board=${side}]`)!.style.setProperty('--c', picked ? (colors.get(picked) ?? '') : '');
      // "− quitar" solo cuando hay goles de ese lado
      form.querySelector<HTMLButtonElement>(`[data-board=${side}] .fc-undo-btn`)!.disabled =
        !startedAt || !Number((form.elements.namedItem(`${side}Goals`) as HTMLInputElement).value);
      form.querySelector(`[data-team-chips=${side}]`)!.replaceChildren(
        ...teamsFor(picked).map((t) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.dataset.team = t;
          b.dataset.side = side;
          b.textContent = t;
          b.classList.toggle('on', sameTeam(t, current));
          return b;
        }),
      );
    }
    renderGoalLog();
  }

  // --- Goles con tiempo ---
  let goals: Goal[] = [];
  let startedAt: number | undefined;
  let pausedMs = 0;
  let pausedAt: number | undefined;
  // Duración real de un partido (min); se recuerda en el celu
  let duration = (() => {
    try {
      const v = Number(localStorage.getItem('fc26-duration'));
      return v >= 1 && v <= 120 ? v : 20;
    } catch {
      return 20;
    }
  })();
  const clockState = (): Clock => ({ startedAt, duration, pausedMs, pausedAt });

  function startClock() {
    if (!startedAt) {
      startedAt = Date.now();
      pausedMs = 0;
      pausedAt = undefined;
    }
  }

  const clockFmt = new Intl.DateTimeFormat('es-AR', { hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
  const minuteOf = (at: number, start = at) => Math.max(1, Math.floor((at - start) / 60000) + 1);
  // --- Reloj de juego: 90' que pasan en la duración real elegida (como el FC) ---
  type Clock = { startedAt?: number | null; duration?: number; pausedMs?: number; pausedAt?: number | null };
  const GAME_SECONDS = 90 * 60;
  const gameSeconds = (c: Clock, now = Date.now()) => {
    if (!c.startedAt) return 0;
    const real = Math.max(0, (c.pausedAt ?? now) - c.startedAt - (c.pausedMs ?? 0));
    return ((real / 1000) * GAME_SECONDS) / ((c.duration || 20) * 60);
  };
  const fmtGame = (sec: number) =>
    `${String(Math.floor(sec / 60)).padStart(2, '0')}:${String(Math.floor(sec % 60)).padStart(2, '0')}`;
  // 37:12 en el reloj = gol al 38'
  const goalMinute = (sec: number) => Math.min(200, Math.floor(sec / 60) + 1);
  const goalLabel = (g: Goal, start: number) => `${g.min ?? minuteOf(g.at, start)}'`;

  // Reloj corrido del partido: 12:34
  const elapsed = (start: number, now = Date.now()) => {
    const sec = Math.max(0, Math.floor((now - start) / 1000));
    return `${Math.floor(sec / 60)}:${String(sec % 60).padStart(2, '0')}`;
  };
  const pickedPlayer = (side: string) => form.querySelector<HTMLInputElement>(`[name=${side}Player]:checked`)?.value;

  // Ajusta la lista de goles de un lado a la cantidad pedida: suma con la hora actual o saca el último
  function setGoals(side: 'home' | 'away', n: number) {
    n = Math.min(99, Math.max(0, Math.trunc(n) || 0));
    let count = goals.filter((g) => g.side === side).length;
    while (count < n) {
      // Un gol con el reloj parado lo arranca
      startClock();
      const now = Date.now();
      goals.push({ side, at: now, min: goalMinute(gameSeconds(clockState(), now)) });
      count++;
    }
    while (count > n) {
      const last = goals.map((g) => g.side).lastIndexOf(side);
      goals.splice(last, 1);
      count--;
    }
    (form.elements.namedItem(`${side}Goals`) as HTMLInputElement).value = String(n);
  }

  // --- Deslizar para confirmar el partido nuevo ---
  const swipeEl = $('#kickoff');
  const swipeThumb = swipeEl.querySelector<HTMLButtonElement>('.fc-swipe-thumb')!;
  let swipeDragging = false;
  let swipeStart = 0;
  let swipeX = 0;
  const swipeMax = () => swipeEl.clientWidth - swipeThumb.offsetWidth - 8;

  function setSwipe(x: number) {
    swipeX = Math.max(0, Math.min(swipeMax(), x));
    swipeEl.style.setProperty('--x', `${swipeX}px`);
    swipeEl.style.setProperty('--p', String(swipeMax() > 0 ? swipeX / swipeMax() : 0));
  }

  function confirmKickoff() {
    if (startedAt || swipeEl.getAttribute('aria-disabled') === 'true') return;
    setSwipe(swipeMax());
    swipeEl.classList.add('done');
    navigator.vibrate?.([20, 30, 60]);
    // Un toque de pausa para que se vea llegar la pelota y arranca
    setTimeout(() => {
      startClock();
      syncForm();
      saveDraft();
      notify('⚽ ¡Arrancó el partido!');
    }, 220);
  }

  swipeThumb.addEventListener('pointerdown', (e) => {
    if (swipeEl.getAttribute('aria-disabled') === 'true') return;
    swipeThumb.setPointerCapture(e.pointerId);
    swipeEl.classList.remove('back');
    swipeDragging = true;
    swipeStart = e.clientX - swipeX;
  });
  swipeThumb.addEventListener('pointermove', (e) => {
    if (swipeDragging) setSwipe(e.clientX - swipeStart);
  });
  const endSwipe = () => {
    if (!swipeDragging) return;
    swipeDragging = false;
    if (swipeX >= swipeMax() * 0.85) confirmKickoff();
    else {
      // No llegó: vuelve al principio
      swipeEl.classList.add('back');
      setSwipe(0);
    }
  };
  swipeThumb.addEventListener('pointerup', endSwipe);
  swipeThumb.addEventListener('pointercancel', endSwipe);
  // Con teclado: flecha a la derecha o Enter
  swipeThumb.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight' || e.key === 'Enter') {
      e.preventDefault();
      confirmKickoff();
    }
  });
  swipeThumb.addEventListener('click', (e) => e.preventDefault());

  function renderClock() {
    const started = Boolean(startedAt);
    const ready = Boolean(pickedPlayer('home') && pickedPlayer('away'));
    // Antes de confirmar: solo la barra para deslizar; después: reloj, pausa y ajustes
    form.dataset.phase = started ? 'play' : 'setup';
    $('#sheet-title').textContent = started ? (pausedAt ? '⏸ En pausa' : '🔴 En juego') : 'Nuevo partido';
    const swipe = $('#kickoff');
    swipe.hidden = started;
    swipe.setAttribute('aria-disabled', String(!ready));
    if (!started && !swipeDragging) setSwipe(0);
    swipe.classList.remove('done');
    $('#kickoff-hint').hidden = started;
    $('#kickoff-hint').textContent = ready ? 'Con el pitazo inicial, llevá la pelota hasta la derecha.' : 'Elegí los dos jugadores para poder empezar.';
    form.querySelectorAll<HTMLElement>('.fc-clock-row, #clock-note').forEach((el) => (el.hidden = !started));
    // Los goles se cargan recién con el partido confirmado
    form.querySelectorAll<HTMLInputElement | HTMLButtonElement>('.fc-goal-btn, [name=homeGoals], [name=awayGoals]').forEach(
      (el) => (el.disabled = !started),
    );
    $('#goal-empty').textContent = started ? 'Tocá + GOL y cada gol queda con su minuto.' : '';
    const clock = $('#match-clock');
    clock.textContent = fmtGame(gameSeconds(clockState()));
    clock.classList.toggle('paused', Boolean(pausedAt));
    $('#clock-toggle').textContent = pausedAt ? '▶ Seguir' : '⏸ Pausa';
    $('#clock-note').textContent = !startedAt
      ? ''
      : pausedAt
        ? 'En pausa (entretiempo o juego frenado).'
        : `Empezó ${clockFmt.format(startedAt)} · 90' en ${duration} min. Si no coincide con la tele, ajustalo con −1' / +1'.`;
    form.querySelectorAll<HTMLButtonElement>('[data-duration]').forEach((b) =>
      b.setAttribute('aria-checked', String(Number(b.dataset.duration) === duration)),
    );
  }

  function renderGoalLog() {
    const panel = $('#goal-panel');
    panel.hidden = !startedAt;
    renderClock();
    $('#goal-empty').hidden = goals.length > 0;
    $('#goal-log').replaceChildren(
      ...goals.map((g) => {
        const li = document.createElement('li');
        li.className = g.side;
        const player = pickedPlayer(g.side) ?? (g.side === 'home' ? 'Local' : 'Visitante');
        li.style.setProperty('--c', colors.get(player) ?? '#71717a');
        const min = document.createElement('b');
        min.textContent = goalLabel(g, startedAt ?? g.at);
        const dot = document.createElement('i');
        const name = document.createElement('span');
        name.textContent = player;
        const time = document.createElement('small');
        time.textContent = clockFmt.format(g.at);
        li.append(min, dot, name, time);
        return li;
      }),
    );
  }

  // Los relojes corren segundo a segundo (solo se toca el texto; 4 veces por segundo para no atrasar)
  setInterval(() => {
    if (sheet.open && startedAt && !pausedAt) $('#match-clock').textContent = fmtGame(gameSeconds(clockState()));
    document.querySelectorAll<HTMLElement>('.fc-live [data-clock]').forEach((el) => {
      try {
        el.textContent = liveClockText(JSON.parse(el.dataset.clock!));
      } catch {}
    });
  }, 250);
  // --- Borrador ---
  const draftFields = ['homePlayer', 'awayPlayer', 'homeTeam', 'awayTeam', 'homeGoals', 'awayGoals', 'date', 'tournament'] as const;
  type Draft = Partial<Record<(typeof draftFields)[number], string>> & {
    open?: boolean;
    goals?: Goal[];
    startedAt?: number;
    pausedMs?: number;
    pausedAt?: number;
    duration?: number;
    liveId?: string;
  };
  // Identifica el partido que se está cargando para mostrarlo en vivo
  let liveId: string | undefined;
  let livePushed: string | undefined;
  let liveTimer = 0;

  const todayLocal = () => {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  };
  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | RadioNodeList;

  function readDraft(): Draft {
    const fd = new FormData(form);
    const draft: Draft = { open: sheet.open, goals, startedAt, pausedMs, pausedAt, duration, liveId };
    for (const k of draftFields) draft[k] = String(fd.get(k) ?? '');
    return draft;
  }

  const hasData = (d: Draft) =>
    Boolean(d.homePlayer || d.awayPlayer || d.homeTeam || d.awayTeam || Number(d.homeGoals) || Number(d.awayGoals) || d.goals?.length || d.startedAt);

  function saveDraft() {
    if (!liveId && hasData(readDraft())) liveId = `lv-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 7)}`;
    const draft = readDraft();
    const dirty = hasData(draft);
    pushLive();
    document.querySelectorAll('.fc-fab').forEach((f) => f.classList.toggle('has-draft', dirty && !sheet.open));
    $('#clear-draft').hidden = !dirty;
    try {
      if (dirty || draft.open) localStorage.setItem(DRAFT_KEY, JSON.stringify(draft));
      else localStorage.removeItem(DRAFT_KEY);
    } catch {
      // Sin storage: el borrador vive solo en esta pestaña
    }
  }

  function resetGoals() {
    goals = [];
    startedAt = undefined;
    pausedMs = 0;
    pausedAt = undefined;
    liveId = undefined;
  }

  // Manda el partido en curso al servidor (con un pequeño retardo para agrupar toques)
  function pushLive() {
    clearTimeout(liveTimer);
    liveTimer = window.setTimeout(async () => {
      if (!online || !canWrite || locked) return;
      const draft = readDraft();
      try {
        if (livePushed && livePushed !== draft.liveId) {
          await fetch(`${API}/live/${livePushed}`, { method: 'DELETE' });
          livePushed = undefined;
        }
        if (draft.liveId && hasData(draft) && draft.startedAt) {
          const res = await fetch(`${API}/live/${draft.liveId}`, {
            method: 'PUT',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              homePlayer: draft.homePlayer,
              awayPlayer: draft.awayPlayer,
              homeTeam: draft.homeTeam,
              awayTeam: draft.awayTeam,
              homeGoals: Number(draft.homeGoals) || 0,
              awayGoals: Number(draft.awayGoals) || 0,
              startedAt: draft.startedAt,
              duration: draft.duration,
              pausedMs: draft.pausedMs,
              pausedAt: draft.pausedAt,
              goals: draft.goals,
            }),
          });
          if (res.ok) {
            livePushed = draft.liveId;
            setLive((await res.json()).live);
            renderLive();
          }
        }
      } catch {
        // Sin conexión: se reintenta con el próximo cambio
      }
    }, 150);
  }

  function clearDraft() {
    form.reset();
    autoTeam.home = autoTeam.away = true;
    resetGoals();
    (field('date') as HTMLInputElement).value = todayLocal();
    syncForm();
    saveDraft();
  }

  function restoreDraft() {
    (field('date') as HTMLInputElement).value = todayLocal();
    let draft: Draft = {};
    try {
      draft = JSON.parse(localStorage.getItem(DRAFT_KEY) ?? '{}') ?? {};
    } catch {
      return;
    }
    for (const k of draftFields) {
      const v = draft[k];
      if (typeof v !== 'string' || !v) continue;
      const f = field(k);
      if (f instanceof RadioNodeList) {
        // Solo jugadores que siguen en la lista
        if (roster.includes(v)) f.value = v;
      } else f.value = v;
    }
    if (Array.isArray(draft.goals)) {
      goals = draft.goals.filter((g) => (g?.side === 'home' || g?.side === 'away') && Number.isFinite(g.at));
    }
    if (Number.isFinite(draft.startedAt)) startedAt = draft.startedAt;
    if (Number.isFinite(draft.pausedMs)) pausedMs = draft.pausedMs!;
    if (Number.isFinite(draft.pausedAt)) pausedAt = draft.pausedAt;
    if (Number.isFinite(draft.duration)) duration = draft.duration!;
    if (typeof draft.liveId === 'string') liveId = livePushed = draft.liveId;
    // Los números del marcador y la lista de goles siempre coinciden
    setGoals('home', Number((field('homeGoals') as HTMLInputElement).value));
    setGoals('away', Number((field('awayGoals') as HTMLInputElement).value));
    syncForm();
    if (draft.open) sheet.showModal();
  }

  form.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    // Al elegir jugador, su equipo viene puesto (salvo que lo hayan escrito a mano)
    if (t.name === 'homePlayer' || t.name === 'awayPlayer') {
      const side = t.name === 'homePlayer' ? 'home' : 'away';
      const team = form.elements.namedItem(`${side}Team`) as HTMLInputElement;
      if (autoTeam[side] || !team.value) {
        team.value = defaultTeam(t.value);
        autoTeam[side] = true;
      }
    }
    syncForm();
    saveDraft();
  });
  form.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name === 'homeTeam' || t.name === 'awayTeam') autoTeam[t.name === 'homeTeam' ? 'home' : 'away'] = false;
    if (t.name === 'homeGoals' || t.name === 'awayGoals') {
      if (t.value === '') return;
      setGoals(t.name === 'homeGoals' ? 'home' : 'away', Number(t.value));
    }
    syncForm();
    saveDraft();
  });
  sheet.addEventListener('close', saveDraft);
  $('#clear-draft').addEventListener('click', clearDraft);

  form.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const now = Date.now();
    if (t.closest('#clock-toggle')) {
      if (!startedAt) startClock();
      else if (pausedAt) {
        pausedMs += now - pausedAt;
        pausedAt = undefined;
      } else pausedAt = now;
      syncForm();
      saveDraft();
      return;
    }
    // −1' / +1': corre el arranque para que el reloj coincida con el de la tele
    const nudge = t.closest<HTMLElement>('[data-nudge]');
    if (nudge) {
      startClock();
      const msPerGameMinute = (duration * 60_000) / 90;
      const next = startedAt! - Number(nudge.dataset.nudge) * msPerGameMinute;
      startedAt = Math.min(now, next);
      syncForm();
      saveDraft();
      return;
    }
    // Cambiar la duración no mueve el minuto actual
    const dur = t.closest<HTMLElement>('[data-duration]');
    if (dur) {
      const sec = gameSeconds(clockState(), now);
      duration = Number(dur.dataset.duration);
      try {
        localStorage.setItem('fc26-duration', String(duration));
      } catch {}
      if (startedAt) startedAt = (pausedAt ?? now) - pausedMs - (sec / GAME_SECONDS) * duration * 60_000;
      syncForm();
      saveDraft();
      return;
    }
    const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-team]');
    if (chip) {
      (form.elements.namedItem(`${chip.dataset.side}Team`) as HTMLInputElement).value = chip.dataset.team!;
      autoTeam[chip.dataset.side!] = false;
      chip.closest('details')?.removeAttribute('open');
      syncForm();
      saveDraft();
      return;
    }
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-step]');
    if (!btn) return;
    const input = form.elements.namedItem(btn.dataset.step!) as HTMLInputElement;
    const side = btn.dataset.step === 'homeGoals' ? 'home' : 'away';
    const scored = Number(btn.dataset.delta) > 0 && (Number(input.value) || 0) < 99;
    setGoals(side, (Number(input.value) || 0) + Number(btn.dataset.delta));
    navigator.vibrate?.(scored ? [30, 40, 60] : 10);
    syncForm();
    saveDraft();
    if (scored) celebrate(form.querySelector(`[data-preview-goals=${side}]`));
  });

  document.querySelectorAll('[data-open-sheet]').forEach((b) =>
    b.addEventListener('click', () => {
      formError.textContent = '';
      // Un partido nuevo (sin nada cargado) va al torneo que se está viendo
      if (!hasData(readDraft())) {
        const fsel = form.elements.namedItem('tournament') as HTMLSelectElement;
        fillTournamentSelect(fsel, view !== 'all' && view !== 'none' ? view : '');
      }
      syncForm();
      sheet.showModal();
      saveDraft();
    }),
  );
  sheet.querySelector('[data-close]')!.addEventListener('click', () => sheet.close());
  // Tocar fuera del sheet lo cierra
  for (const d of [sheet, confirmDialog, pinDialog]) {
    d.addEventListener('click', (e) => {
      if (e.target === d && !d.classList.contains('fc-pin-gate')) d.close();
    });
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const str = (k: string) => String(fd.get(k) ?? '').trim();
    const m: Match = {
      id: `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 7)}`,
      date: str('date'),
      homePlayer: str('homePlayer'),
      homeTeam: str('homeTeam'),
      homeGoals: Math.min(99, Math.max(0, Math.trunc(Number(str('homeGoals'))) || 0)),
      awayPlayer: str('awayPlayer'),
      awayTeam: str('awayTeam'),
      awayGoals: Math.min(99, Math.max(0, Math.trunc(Number(str('awayGoals'))) || 0)),
      goals: [...goals].sort((a, b) => a.at - b.at),
      ...(str('tournament') && tournamentName(str('tournament')) && { tournamentId: str('tournament') }),
      startedAt,
    };
    if (!m.homePlayer || !m.awayPlayer) {
      formError.textContent = 'Elegí quién jugó de local y de visitante';
      return;
    }
    if (!m.date) {
      formError.textContent = 'Poné la fecha del partido';
      return;
    }
    formError.textContent = '';
    const submit = form.querySelector<HTMLButtonElement>('[type=submit]')!;
    let savedLocally = false;
    submit.disabled = true;
    try {
      if (online && canWrite) {
        // Con liveId, el servidor lo saca de "en vivo" al guardarlo
        clearTimeout(liveTimer);
        await write('POST', '/matches', { ...m, liveId });
        livePushed = undefined;
      } else {
        // Sin servidor: queda en este celu y después se sube
        localOnly.push(m);
        storeKey(KEY, localOnly);
        savedLocally = true;
      }
    } catch (err) {
      // El borrador sigue intacto: se puede reintentar
      if (err instanceof Cancelled) formError.textContent = 'Necesitás el PIN para guardar';
      else formError.textContent = errorText(err);
      return;
    } finally {
      submit.disabled = false;
    }
    sheet.close();
    rememberTeams([m.homeTeam, m.awayTeam]);
    // La primera vez que alguien juega con un equipo, queda como su equipo de siempre
    for (const [player, team] of [[m.homePlayer, m.homeTeam], [m.awayPlayer, m.awayTeam]]) {
      if (team && !playerTeams[player] && online && canWrite && roster.includes(player)) {
        write('PUT', `/players/${encodeURIComponent(player)}/team`, { team }).catch(() => {});
      }
    }
    refresh();
    form.reset();
    resetGoals();
    autoTeam.home = autoTeam.away = true;
    (field('date') as HTMLInputElement).value = m.date;
    syncForm();
    try {
      localStorage.removeItem(DRAFT_KEY);
    } catch {}
    saveDraft();
    notify(`⚽ ${m.homePlayer} ${m.homeGoals}-${m.awayGoals} ${m.awayPlayer} ${savedLocally ? 'guardado en este celu' : 'guardado'}`);
  });

  // --- Exportar / importar ---
  const menu = $('#fc-menu');

  $('#export').addEventListener('click', () => {
    const blob = new Blob([JSON.stringify(allMatches, null, 2)], { type: 'application/json' });
    const a = Object.assign(document.createElement('a'), {
      href: URL.createObjectURL(blob),
      download: `fc26-resultados-${new Date().toISOString().slice(0, 10)}.json`,
    });
    a.click();
    URL.revokeObjectURL(a.href);
    menu.hidePopover();
  });

  $<HTMLInputElement>('#import').addEventListener('change', async (e) => {
    const input = e.currentTarget as HTMLInputElement;
    const file = input.files?.[0];
    menu.hidePopover();
    if (!file) return;
    try {
      const data = JSON.parse(await file.text());
      const incoming = (Array.isArray(data) ? data : []).filter(isMatch);
      const known = new Set(allMatches.map((m) => m.id));
      const added = incoming.filter((m) => !known.has(m.id));
      if (added.length) {
        if (online && canWrite) await write('POST', '/matches', added);
        else {
          localOnly.push(...added);
          storeKey(KEY, localOnly);
        }
      }
      rememberTeams(added.flatMap((m) => [m.homeTeam, m.awayTeam]).filter((t) => typeof t === 'string'));
      refresh();
      notify(`Se importaron ${added.length} partido(s)`);
    } catch (err) {
      if (err instanceof SyntaxError) notify('El archivo no es válido');
      else if (!(err instanceof Cancelled)) notify(errorText(err));
    }
    input.value = '';
  });

  // --- Dock: resalta la sección visible ---
  const dockLinks = [...document.querySelectorAll<HTMLAnchorElement>('.fc-dock a.fc-dock-item')];
  const spy = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        for (const a of dockLinks) a.setAttribute('aria-current', String(a.hash === `#${entry.target.id}`));
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  document.querySelectorAll('.fc-section').forEach((s) => spy.observe(s));

  render();
  renderTournamentBar();
  paintPicks();
  renderSoundToggle();
  renderSync();
  restoreDraft();
  saveDraft();
  sync();
</script>
