---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="404 — Página no encontrada · Nacho Dal Lago" noindex>
  <Header />
  <main id="main" class="mx-auto flex min-h-[70dvh] max-w-3xl flex-col items-center justify-center px-5 text-center">
    <p class="eyebrow">error 404</p>
    <h1 class="mt-4 text-6xl font-semibold sm:text-8xl"><span class="text-gradient">404</span></h1>
    <p class="mt-4 text-lg text-zinc-400">Ni la IA encontró esta página. Volvamos a lo importante.</p>
    <a href="/" class="btn btn-primary mt-8">Volver al inicio</a>
  </main>
  <Footer />
</Layout>
