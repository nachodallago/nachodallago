---
import '@fontsource/anton/latin-400.css';
import '../styles/vi.css';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/vi/Nav.astro';
import KeyArt from '../components/vi/KeyArt.astro';
---

<Layout title="404 — Página no encontrada · Nacho Dal Lago" noindex decor={false} bodyClass="vi">
  <Nav home={false} />
  <main id="main" class="relative isolate flex min-h-[100svh] items-end overflow-hidden">
    <div class="absolute inset-0 -z-20"><KeyArt id="ka-404" class="size-full" /></div>
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-t from-[#07040d] via-[#07040d]/50 to-[#07040d]/30"></div>
    <div class="mx-auto w-full max-w-7xl px-4 pb-16 sm:px-8 sm:pb-24">
      <p class="vi-kicker">Error 404</p>
      <h1 class="vi-display mt-4 text-[30vw] lg:text-[16rem]"><span class="vi-sunset-text">Perdido</span></h1>
      <p class="mt-4 max-w-xl text-lg text-white/75">Ni la IA encontró esta página. Volvamos a lo importante.</p>
      <a href="/" class="vi-btn vi-btn-primary mt-8">Volver al inicio</a>
    </div>
  </main>
</Layout>
