---
interface Props {
  class?: string;
}

const { class: className = 'size-12' } = Astro.props;
---

<!-- Monograma "EA" dibujado a mano en SVG (sin assets externos) -->
<svg viewBox="0 0 100 100" class={className} role="img" aria-label="EA SPORTS">
  <circle cx="50" cy="50" r="48" fill="#000" stroke="#fff" stroke-width="3" />
  <g fill="#fff">
    <!-- E -->
    <path d="M18 34h30l-4 7H18z" />
    <path d="M18 47h24l-4 7H18z" />
    <path d="M18 60h22l-4 7H18z" />
    <!-- A: V invertida + travesaño que se estira hasta la E -->
    <path d="M52 67 72 29l20 38H81L72 49l-9 18z" />
    <path d="M45 54h31l-3 6H42z" />
  </g>
</svg>
