---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { faqs } from '../data/site';
---

<section id="faq" aria-labelledby="faq-title" class="mx-auto max-w-3xl px-5 py-20 sm:py-28">
  <SectionHeading eyebrow="// preguntas frecuentes" title="Lo que todos me preguntan" id="faq-title" center />

  <div class="mt-12 space-y-3">
    {
      faqs.map((f, i) => (
        <details name="faq" class="card reveal group p-0 open:!border-acid/30" open={i === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-medium text-white sm:p-6 [&::-webkit-details-marker]:hidden">
            {f.q}
            <Icon name="plus" size={18} class="shrink-0 text-acid transition-transform duration-300 group-open:rotate-45" />
          </summary>
          <p class="px-5 pb-5 text-zinc-400 sm:px-6 sm:pb-6">{f.a}</p>
        </details>
      ))
    }
  </div>
</section>
