---
interface Props {
  eyebrow: string;
  title: string;
  id?: string;
  center?: boolean;
}
const { eyebrow, title, id, center = false } = Astro.props;
---

<div class:list={['reveal max-w-2xl', center && 'mx-auto text-center']}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id} class="mt-3 text-3xl font-semibold sm:text-4xl md:text-5xl">{title}</h2>
  {
    Astro.slots.has('default') && (
      <p class="mt-4 text-base text-zinc-400 sm:text-lg">
        <slot />
      </p>
    )
  }
</div>
