---
interface Props {
  eyebrow: string;
  title: string;
  id?: string;
  center?: boolean;
}
const { eyebrow, title, id, center = false } = Astro.props;
---

<div class:list={['max-w-2xl', center && 'mx-auto text-center']}>
  <p class:list={['reveal eyebrow', !center && 'reveal-left']}>{eyebrow}</p>
  <h2 id={id} class="reveal reveal-blur mt-3 text-3xl font-semibold sm:text-4xl md:text-5xl" style="--i:1">{title}</h2>
  {
    Astro.slots.has('default') && (
      <p class="reveal mt-4 text-base text-zinc-400 sm:text-lg" style="--i:2">
        <slot />
      </p>
    )
  }
</div>
