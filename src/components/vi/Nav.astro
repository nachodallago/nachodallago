---
import Icon from '../Icon.astro';
import { nav, links } from '../../data/site';

interface Props {
  home?: boolean;
}
const { home = true } = Astro.props;
const href = (h: string) => (home ? h : `/${h}`);
---

<header class="vi-nav" data-nav>
  <div class="vi-nav-in mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:h-20 sm:px-8">
    <a href={home ? '#top' : '/'} class="flex min-h-11 items-center gap-2" aria-label="Nacho Dal Lago — inicio">
      <span class="vi-display vi-sunset-text text-3xl leading-none">NDL</span>
      <span class="hidden font-mono text-[10px] tracking-[0.25em] text-white/60 uppercase min-[400px]:inline">Automation · AI</span>
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-7">
        {nav.map((item) => <li><a class="vi-link" href={href(item.href)}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href={links.linkedin} target="_blank" rel="noopener" class="vi-btn vi-btn-primary !hidden !min-h-11 !px-5 text-sm sm:!inline-flex">
        Hablemos
      </a>
      <button
        type="button"
        popovertarget="vi-menu"
        class="grid size-11 place-items-center rounded-full border border-white/15 text-white lg:hidden"
        aria-label="Abrir menú"
      >
        <Icon name="menu" />
      </button>
    </div>
  </div>
  <div class="vi-progress" aria-hidden="true"></div>
</header>

<!-- Mobile: CTA fijo abajo, donde llega el pulgar -->
<div class="vi-dock" data-dock>
  <a href={links.linkedin} target="_blank" rel="noopener" class="vi-btn vi-btn-primary">
    <Icon name="linkedin" /> Hablemos por LinkedIn
  </a>
</div>

<div id="vi-menu" popover class="vi-menu m-0 h-dvh max-h-none w-full max-w-none border-0 bg-[#07040d]/95 p-0 text-white backdrop-blur-xl">
  <div class="flex h-16 items-center justify-between px-4 pt-[env(safe-area-inset-top)]">
    <span class="vi-display vi-sunset-text text-3xl">NDL</span>
    <button
      type="button"
      popovertarget="vi-menu"
      popovertargetaction="hide"
      class="grid size-11 place-items-center rounded-full border border-white/15"
      aria-label="Cerrar menú"
    >
      <Icon name="x" />
    </button>
  </div>
  <nav aria-label="Móvil" class="px-4 pt-8">
    <ul>
      {
        nav.map((item, i) => (
          <li>
            <a
              href={href(item.href)}
              class="flex items-baseline gap-4 border-b border-white/10 py-4"
              onclick="document.getElementById('vi-menu').hidePopover()"
            >
              <span class="font-mono text-xs text-[#ffc46b]">0{i + 1}</span>
              <span class="vi-display text-[2.75rem] leading-none">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <a href={links.linkedin} target="_blank" rel="noopener" class="vi-btn vi-btn-primary mt-10 w-full">
      <Icon name="linkedin" /> Escribime por LinkedIn
    </a>
  </nav>
</div>
