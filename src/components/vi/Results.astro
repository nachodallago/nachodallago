---
import Icon from '../Icon.astro';
import { metrics, beforeAfter, timeline } from '../../data/site';
---

<section id="resultados" class="relative py-24 sm:py-36" aria-labelledby="resultados-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-8">
    <p class="vi-kicker vi-reveal">Resultados</p>
    <h2 id="resultados-title" class="vi-display vi-reveal mt-3 text-[15vw] sm:text-8xl lg:text-[7rem]" style="--d:1">
      El antes <span class="vi-sunset-text">y el después</span>
    </h2>

    <dl class="mt-14 grid grid-cols-2 gap-px overflow-hidden rounded-3xl border border-white/10 bg-white/10 lg:grid-cols-4">
      {
        metrics.map((m, i) => (
          <div class="vi-reveal bg-[#0b0614] p-6 sm:p-8" style={`--d:${i}`}>
            <dd class="vi-display vi-sunset-text text-6xl sm:text-8xl">{m.value}</dd>
            <dt class="mt-3 text-sm text-white/60 sm:text-base">{m.label}</dt>
          </div>
        ))
      }
    </dl>

    <div class="mt-6 grid gap-4 lg:grid-cols-2">
      <div class="vi-reveal rounded-3xl border border-white/10 bg-white/[.02] p-6 sm:p-10">
        <p class="font-mono text-xs tracking-[0.22em] text-white/45 uppercase">Antes · picando código</p>
        <ul class="mt-6 space-y-4">
          {
            beforeAfter.before.map((t) => (
              <li class="flex items-start gap-3 text-white/55 line-through decoration-white/25">
                <Icon name="x" size={18} class="mt-1 shrink-0 text-[#ff7a59]" />
                {t}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="vi-reveal relative overflow-hidden rounded-3xl border border-[#ff3d8b]/40 bg-gradient-to-br from-[#ff3d8b]/15 via-[#7c3aed]/10 to-transparent p-6 sm:p-10" style="--d:1">
        <p class="font-mono text-xs tracking-[0.22em] text-[#ffc46b] uppercase">Ahora · automatizando</p>
        <ul class="mt-6 space-y-4">
          {
            beforeAfter.after.map((t) => (
              <li class="flex items-start gap-3 text-white">
                <Icon name="check" size={18} class="mt-1 shrink-0 text-[#2ee6d6]" />
                {t}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Línea de tiempo -->
    <ol id="historia-timeline" class="relative mt-24 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
      <span aria-hidden="true" class="absolute top-3 right-0 left-0 hidden h-px bg-gradient-to-r from-[#2ee6d6] via-[#ff3d8b] to-[#ffc46b] lg:block"></span>
      {
        timeline.map((t, i) => (
          <li class="vi-reveal relative" style={`--d:${i}`}>
            <span aria-hidden="true" class="relative z-10 block size-6 rounded-full border-4 border-[#07040d] bg-gradient-to-br from-[#ffc46b] to-[#ff3d8b]" />
            <p class="vi-display mt-5 text-4xl text-white/90">{t.year}</p>
            <p class="mt-2 font-semibold text-white">{t.title}</p>
            <p class="mt-1 text-white/55">{t.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
