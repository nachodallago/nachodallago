---
import Icon from '../Icon.astro';
import { processSteps, faqs } from '../../data/site';
---

<section id="proceso" class="relative py-20 sm:py-32" aria-labelledby="proceso-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-8">
    <p class="vi-kicker vi-reveal">Cómo trabajo</p>
    <h2 id="proceso-title" class="vi-display vi-h2 vi-reveal mt-3" style="--d:1">
      Cuatro <span class="vi-sunset-text">movimientos</span>
    </h2>
    <p class="vi-swipe mt-10">Deslizá los pasos</p>
    <ol class="vi-rail vi-reveal mt-3 sm:mt-12" data-size="sm" style="--cols-sm:2;--cols-lg:4">
      {
        processSteps.map((s, i) => (
          <li class="vi-card p-6" data-glow>
            <span class="vi-display vi-sunset-text text-5xl">0{i + 1}</span>
            <h3 class="mt-4 text-xl font-semibold text-white">{s.title}</h3>
            <p class="mt-2 text-white/60">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section id="faq" class="relative py-20 sm:py-32" aria-labelledby="faq-title">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-8 lg:grid-cols-[0.8fr_1.2fr]">
    <div>
      <p class="vi-kicker vi-reveal">Preguntas frecuentes</p>
      <h2 id="faq-title" class="vi-display vi-h2 vi-reveal mt-3 lg:sticky lg:top-28" style="--d:1">
        Antes de <span class="vi-sunset-text">arrancar</span>
      </h2>
    </div>
    <div class="divide-y divide-white/10 border-y border-white/10">
      {
        faqs.map((f) => (
          <details class="vi-faq group py-2">
            <summary class="flex min-h-14 items-center justify-between gap-4 py-3 text-[1.05rem] leading-snug font-medium text-white sm:gap-6 sm:py-4 sm:text-xl">
              {f.q}
              <span class="plus grid size-10 shrink-0 place-items-center rounded-full border border-white/15 text-[#ffc46b]">
                <Icon name="plus" size={18} />
              </span>
            </summary>
            <p class="pb-5 text-white/65">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
