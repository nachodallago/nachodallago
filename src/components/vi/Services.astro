---
import { services } from '../../data/site';
---

<section id="servicios" class="relative py-20 sm:py-36" aria-labelledby="servicios-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-8">
    <div class="grid gap-6 lg:grid-cols-[1fr_1fr] lg:items-end">
      <div>
        <p class="vi-kicker vi-reveal">Servicios</p>
        <h2 id="servicios-title" class="vi-display vi-h2 vi-reveal mt-3" style="--d:1">
          Lo que <span class="vi-sunset-text">hago hoy</span>
        </h2>
      </div>
      <p class="vi-reveal max-w-xl text-white/65 sm:text-lg lg:justify-self-end" style="--d:2">
        Menos horas en tareas repetitivas, menos errores y más foco en lo que mueve el negocio. Cada proyecto arranca por el
        proceso que más duele.
      </p>
    </div>

    <p class="vi-swipe mt-10">Deslizá los servicios</p>
    <ul class="vi-rail vi-reveal mt-3 sm:mt-14" style="--cols-sm:2;--cols-lg:3">
      {
        services.map((s, i) => (
          <li class="vi-card flex flex-col p-6 sm:p-8" data-glow>
            <span class="vi-display text-5xl text-white/10 sm:text-6xl">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="vi-display mt-3 text-[2.1rem] sm:mt-4 sm:text-4xl">{s.title}</h3>
            <p class="mt-4 flex-1 text-white/65">{s.text}</p>
            <ul class="mt-6 flex flex-wrap gap-2">
              {s.tags.map((t) => (
                <li class="rounded-full border border-white/10 px-3 py-1 font-mono text-[11px] text-white/60">{t}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>
